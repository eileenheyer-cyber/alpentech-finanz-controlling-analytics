/// Measure host table. Contains no meaningful data; holds all report measures.
table _Measures
	lineageTag: f351263f-d96f-4744-a2ff-5723f1087f62

	/// Actual amount. Revenue positive, expense negative - a bare sum equals Operating Result.
	measure Actual = SUM ( fact_actual[amount] )
		formatString: #,##0
		displayFolder: 01 Base
		lineageTag: 793d47fa-9e16-4369-b786-8a932101fc97

	/// Budgeted amount (Plan). Same sign convention as Actual. No customer/product/company grain.
	measure Budget = SUM ( fact_budget[budget_amount] )
		formatString: #,##0
		displayFolder: 01 Base
		lineageTag: d96e307e-4922-437c-bd8d-771f68fed951

	/// Mid-year rolling forecast as of end Q2. Jan-Jun equals actual by construction; only Jul-Dec carries forecast information.
	measure Forecast = SUM ( fact_forecast[forecast_amount] )
		formatString: #,##0
		displayFolder: 01 Base
		lineageTag: b18b3639-28c1-4206-9e38-d78dc8174074

	/// Actual minus Budget. Negative = unfavourable for both revenue and cost. Returns blank where neither Actual nor Budget exists, so unbudgeted grains (customer, product) do not read as 100% variance.
	measure Variance =
			VAR _Actual  = [Actual]
			VAR _Budget = [Budget]
			RETURN
			    IF ( ISBLANK ( _Actual ) && ISBLANK ( _Budget ), BLANK (), _Actual - _Budget )
		formatString: #,##0
		displayFolder: 02 Variance
		lineageTag: da1305aa-9ed8-4dda-9f84-cf81fbca9d93

	/// Variance as % of plan. ABS in the denominator so negative always means unfavourable - without it, expense overruns would render as positive percentages.
	measure 'Variance %' = DIVIDE ( [Variance], ABS ( [Budget] ) )
		formatString: 0.0%;-0.0%
		displayFolder: 02 Variance
		lineageTag: 3f7eb7ff-f7f1-474e-be2a-2bac45d7b8cf

	/// Actual minus Forecast. How much the mid-year forecast still missed.
	measure 'Variance to Forecast' =
			VAR _Actual = [Actual]
			VAR _Forecast  = [Forecast]
			RETURN
			    IF ( ISBLANK ( _Actual ) && ISBLANK ( _Forecast ), BLANK (), _Actual - _Forecast )
		formatString: #,##0
		displayFolder: 02 Variance
		lineageTag: 6f3f4538-6cc5-4973-8e3c-e368f533d1a1

	/// Revenue (accounts 4000-4200). Positive. Books entirely through the Sales cost center.
	measure Revenue = CALCULATE ( [Actual], dim_account[account_type] = "Revenue" )
		formatString: #,##0
		displayFolder: 03 P&L
		lineageTag: e521bde1-02f6-44fc-8cb1-40932a4b7c6b

	/// Total cost, returned positive for display. The source stays negative so variance logic needs no branching by account type.
	measure 'Total Cost' = - CALCULATE ( [Actual], dim_account[account_type] = "Expense" )
		formatString: #,##0
		displayFolder: 03 P&L
		lineageTag: f775c82f-293d-4210-a0a1-aa13d0bc5e2c

	/// Operating result. Arithmetically equal to SUM of amount; written as Revenue minus Total Cost so it is readable without knowing the sign convention.
	measure 'Operating Result' = [Revenue] - [Total Cost]
		formatString: #,##0
		displayFolder: 03 P&L
		lineageTag: 9096e836-ee9d-436a-9f61-6fe31380189f

	/// Operating margin. Blank outside the Sales cost center, since revenue books only there.
	measure 'Operating Margin %' = DIVIDE ( [Operating Result], [Revenue] )
		formatString: 0.0%
		displayFolder: 03 P&L
		lineageTag: 63e6f21a-871a-4c20-81bc-5c977e2c85df

	/// Material cost as % of revenue. Ignores account slicers by design. Valid only at company level - material sits in Production, revenue in Sales, so a cost-center filter breaks the ratio.
	measure 'Material Cost Ratio' =
			VAR _Material =
			    - CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        dim_account[account_category] = "Material Costs"
			    )
			VAR _Revenue =
			    CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        dim_account[account_type] = "Revenue"
			    )
			RETURN
			    DIVIDE ( _Material, _Revenue )
		formatString: 0.0%
		displayFolder: 04 Ratios
		lineageTag: 8ec15845-17e7-48fd-b6a4-f0f4a2964bff

	/// Personnel cost as % of revenue. Ignores account slicers by design. Valid only at company level - see Material Cost Ratio.
	measure 'Personnel Cost Ratio' =
			VAR _Personnel =
			    - CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        dim_account[account_category] = "Personnel Costs"
			    )
			VAR _Revenue =
			    CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        dim_account[account_type] = "Revenue"
			    )
			RETURN
			    DIVIDE ( _Personnel, _Revenue )
		formatString: 0.0%
		displayFolder: 04 Ratios
		lineageTag: 72249802-f143-4170-8c44-b7ed9355c946

	/// Contribution margin I = revenue less direct material cost. Added, not subtracted, because material is already negative. Valid by product because Raw Materials is the one cost account carrying a real product_id.
	measure 'Contribution Margin I' =
			VAR _Revenue =
			    CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        dim_account[account_type] = "Revenue"
			    )
			VAR _Material =
			    CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        dim_account[account_name] = "Raw Materials"
			    )
			RETURN
			    _Revenue + _Material
		formatString: #,##0
		displayFolder: 04 Ratios
		lineageTag: ac3ce878-0d8d-4ffc-8868-bccff19f886e

	/// Contribution margin I as % of revenue.
	measure 'Contribution Margin I %' =
			VAR _Revenue =
			    CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        dim_account[account_type] = "Revenue"
			    )
			RETURN
			    DIVIDE ( [Contribution Margin I], _Revenue )
		formatString: 0.0%
		displayFolder: 04 Ratios
		lineageTag: 6d140544-a47f-45b6-9235-9cdc8853b2c6

	/// Prior-year actual (prior year). Blank for 2023, which has no prior year in the dataset. Requires dim_date marked as a date table.
	measure 'Actual PY' = CALCULATE ( [Actual], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: #,##0
		displayFolder: 05 Time Comparison
		lineageTag: d470cdce-434e-49f2-a392-3bc15bd61ac5

	/// Year-over-year change in actual. Blank where no prior year exists, so 2023 does not read as growth from zero.
	measure 'Actual YoY' =
			VAR _PriorYear = [Actual PY]
			RETURN
			    IF ( NOT ISBLANK ( _PriorYear ), [Actual] - _PriorYear )
		formatString: #,##0
		displayFolder: 05 Time Comparison
		lineageTag: 9e81388a-1749-46f4-a8a0-c60ed855d128

	/// Year-over-year change as %. ABS in the denominator for the same reason as Variance %.
	measure 'Actual YoY %' = DIVIDE ( [Actual YoY], ABS ( [Actual PY] ) )
		formatString: 0.0%;-0.0%
		displayFolder: 05 Time Comparison
		lineageTag: 4c028ee2-ed93-4a40-9ddc-316523885507

	/// Forecast error, Jul-Dec only. H1 forecast equals actual by construction, so a full-year metric would be diluted by six months of guaranteed-perfect data. KEEPFILTERS intersects with the user's period selection rather than overriding it.
	measure 'Forecast Error H2' =
			CALCULATE (
			    [Actual] - [Forecast],
			    KEEPFILTERS ( dim_date[month] >= 7 )
			)
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: cbc347bc-3233-4104-8be0-12b59d68dc0e

	/// Forecast error as % of forecast, Jul-Dec only.
	measure 'Forecast Error H2 %' =
			VAR _Error = [Forecast Error H2]
			VAR _Forecast  = CALCULATE ( [Forecast], KEEPFILTERS ( dim_date[month] >= 7 ) )
			RETURN
			    DIVIDE ( _Error, ABS ( _Forecast ) )
		formatString: 0.0%;-0.0%
		displayFolder: 06 Forecast
		lineageTag: 0520a34d-26ea-40ff-93bc-beaf927f1e81

	/// Depreciation and amortisation, returned positive. Account 6100 is the only D&A account in the chart of accounts.
	measure Depreciation =
			- CALCULATE (
			    [Actual],
			    REMOVEFILTERS ( dim_account ),
			    dim_account[account_category] = "Depreciation"
			)
		formatString: #,##0
		displayFolder: 03 P&L
		lineageTag: 0c79ac72-2835-49b9-89f9-e59b77d337f4

	/// Earnings before interest and tax. Identical to Operating Result because the chart of accounts contains no interest or tax accounts - kept as a separate name for the cockpit, but it is an alias, not a distinct calculation.
	measure EBIT = [Operating Result]
		formatString: #,##0
		displayFolder: 03 P&L
		lineageTag: e2130ddf-b588-4db3-b81e-b8366fffa433

	/// Operating result with depreciation added back. Because Depreciation ignores account filters, this is meaningful at P&L level rather than filtered to a single account.
	measure EBITDA = [EBIT] + [Depreciation]
		formatString: #,##0
		displayFolder: 03 P&L
		lineageTag: a3989bde-b3d8-43c8-8b6e-0a7257943c8b

	/// EBITDA as % of revenue. Uses the same REMOVEFILTERS pattern as the cost ratios because numerator and denominator live in different accounts.
	measure 'EBITDA Margin %' =
			VAR _Revenue =
			    CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        dim_account[account_type] = "Revenue"
			    )
			RETURN
			    DIVIDE ( [EBITDA], _Revenue )
		formatString: 0.0%
		displayFolder: 03 P&L
		lineageTag: 4b3dc72e-0451-4e2e-985b-3c40cbb3bfdb

	/// Forecast vs Budget. Forecast minus Plan; negative = the forecast expects to fall short of plan.
	measure 'Forecast vs Budget' =
			VAR _Forecast   = [Forecast]
			VAR _Budget = [Budget]
			RETURN
			    IF ( ISBLANK ( _Forecast ) && ISBLANK ( _Budget ), BLANK (), _Forecast - _Budget )
		formatString: #,##0
		displayFolder: 02 Variance
		lineageTag: 71334822-b15a-48e6-9ab4-c367300d7cde

	/// Forecast vs Budget as % of plan. ABS in the denominator so negative always means unfavourable.
	measure 'Forecast vs Budget %' = DIVIDE ( [Forecast vs Budget], ABS ( [Budget] ) )
		formatString: 0.0%;-0.0%
		displayFolder: 02 Variance
		lineageTag: e52c52d8-b463-4091-8465-c64ae62c4bde

	/// Year-to-date cumulative operating result. Drives the cumulative line on the monthly result chart. Requires dim_date marked as a date table.
	measure 'Operating Result YTD' =
			CALCULATE (
			    [Operating Result],
			    DATESYTD ( dim_date[date] )
			)
		formatString: #,##0
		displayFolder: 05 Time Comparison
		lineageTag: 6f5b26f3-a9a4-4e3d-bcc6-80bce5f57cfe

	/// Gross profit = revenue less COGS. COGS comes from the COGS measure, which holds the agreed definition (2026-09-14): direct production costs excluding depreciation, i.e. every expense booked to the Production cost center except account 6100 Depreciation. Subtracted rather than added because COGS returns positive. CHANGED 2026-09-14: previously kept Production depreciation inside cost, which gave 8,813,500 / 9,200,466 / 9,108,821 for 2023-2025; now 9,201,856 / 9,613,434 / 9,572,123, and matches the Gross Profit line in the P&L matrix exactly. COMPANY LEVEL ONLY - removes account and cost-center filters by design, because revenue sits in Sales and COGS in Production, so a cost-center filter would split them apart. Excludes Logistics (distribution not treated as COGS).
	measure 'Gross Profit' =
			VAR _Revenue =
			    CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        REMOVEFILTERS ( dim_cost_center ),
			        dim_account[account_type] = "Revenue"
			    )
			VAR _COGS =
			    CALCULATE (
			        [COGS],
			        REMOVEFILTERS ( dim_account ),
			        REMOVEFILTERS ( dim_cost_center )
			    )
			RETURN
			    _Revenue - _COGS
		formatString: #,##0
		displayFolder: 03 P&L
		lineageTag: 158d0d30-30a3-435d-a076-b83dac8a0a9d

	/// Gross margin = Gross Profit as % of revenue. Follows the agreed COGS definition through Gross Profit: direct production costs excluding depreciation. CHANGED 2026-09-14: previously 48.8% / 47.7% / 45.2% for 2023-2025 with Production depreciation inside cost; now about 2.1-2.4 points higher. Same company-level caveat as Gross Profit.
	measure 'Gross Margin %' =
			VAR _Revenue =
			    CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        REMOVEFILTERS ( dim_cost_center ),
			        dim_account[account_type] = "Revenue"
			    )
			RETURN
			    DIVIDE ( [Gross Profit], _Revenue )
		formatString: 0.0%
		displayFolder: 03 P&L
		lineageTag: 27e73a6d-13cf-4e59-8a37-8481246195bf

	/// Corporate tax expense, returned positive for display. Source is negative, matching the sign convention. COMPANY LEVEL ONLY - fact_tax has no cost center, account, product or customer grain, so it does not respond to those slicers and will repeat the full company figure against any such filter.
	measure Tax = - SUM ( fact_tax[tax_amount] )
		formatString: #,##0
		displayFolder: 03 P&L
		lineageTag: bdbe642c-2289-4555-aa6e-d4e5b11d152a

	/// Bottom line. EBIT less tax; interest is zero because no debt is modelled, so EBT equals EBIT. COMPANY LEVEL ONLY - see Tax.
	measure 'Net Income' = [EBIT] - [Tax]
		formatString: #,##0
		displayFolder: 03 P&L
		lineageTag: aae6ee4f-4c72-4edb-9ae0-6a84cffa31d4

	/// Net income as % of revenue. Uses the same REMOVEFILTERS pattern as the other ratios.
	measure 'Net Margin %' =
			VAR _Revenue =
			    CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        dim_account[account_type] = "Revenue"
			    )
			RETURN
			    DIVIDE ( [Net Income], _Revenue )
		formatString: 0.0%
		displayFolder: 03 P&L
		lineageTag: 88bfb482-9cad-46ff-999d-3fd3911944ee

	/// Tax as % of EBIT. Should sit near 29.8% - Koerperschaftsteuer 15% plus Solidaritaetszuschlag (15.825% combined) plus Gewerbesteuer at roughly 14%.
	measure 'Effective Tax Rate %' = DIVIDE ( [Tax], [EBIT] )
		formatString: 0.0%
		displayFolder: 03 P&L
		lineageTag: 35c69e03-5556-413e-8def-6a6d5a60e1f4

	/// Month-end trade receivables, ACTUAL only (is_forecast = FALSE) - see Accounts Receivable Forecast for the forecast series. SEMI-ADDITIVE: takes the closing balance of the period rather than summing months, so a year shows the December position. SYNTHETIC data - derived from revenue using assumed payment terms.
	measure 'Accounts Receivable' =
			LASTNONBLANKVALUE (
			    dim_date[date],
			    CALCULATE ( SUM ( fact_working_capital[ar_balance] ), fact_working_capital[is_forecast] = FALSE )
			)
		formatString: #,##0
		displayFolder: 08 Cash & Working Capital
		lineageTag: 3f19f98b-ed63-47ce-808a-74b15521219f

	/// Month-end inventory, ACTUAL only (is_forecast = FALSE) - see Inventory Forecast. Semi-additive closing balance. SYNTHETIC - derived from material consumption using an assumed stock level.
	measure Inventory =
			LASTNONBLANKVALUE (
			    dim_date[date],
			    CALCULATE ( SUM ( fact_working_capital[inventory_balance] ), fact_working_capital[is_forecast] = FALSE )
			)
		formatString: #,##0
		displayFolder: 08 Cash & Working Capital
		lineageTag: 3ceff4ad-95cd-464a-bee1-2568b05e2cc6

	/// Month-end trade payables, ACTUAL only (is_forecast = FALSE) - see Accounts Payable Forecast. Semi-additive closing balance. SYNTHETIC - derived from purchased cost using assumed supplier terms.
	measure 'Accounts Payable' =
			LASTNONBLANKVALUE (
			    dim_date[date],
			    CALCULATE ( SUM ( fact_working_capital[ap_balance] ), fact_working_capital[is_forecast] = FALSE )
			)
		formatString: #,##0
		displayFolder: 08 Cash & Working Capital
		lineageTag: 5f3399fe-86c8-42c8-b112-f67a4d101bdc

	/// AR plus inventory less AP. The cash tied up in operations. Closing balance of the period.
	measure 'Net Working Capital' = [Accounts Receivable] + [Inventory] - [Accounts Payable]
		formatString: #,##0
		displayFolder: 08 Cash & Working Capital
		lineageTag: 84989bd6-aa7f-41ae-b0ce-e0fa05a7d565

	/// Change in net working capital across the selected period: closing balance less the balance immediately before the period began. Positive means working capital absorbed cash. Correct at any grain, including multi-year spans, because it differences two closing balances rather than shifting the window. The earlier SAMEPERIODLASTYEAR version returned a single year of movement against a multi-year selection, which let Operating Cash Flow subtract one year of drag from three years of earnings. Blank whenever no balance exists before the period, so 2023 and any span starting in 2023 return blank rather than treating the opening position as zero.
	measure 'Delta NWC' =
			VAR _PeriodStart = MIN ( dim_date[date] )
			VAR _Closing = [Net Working Capital]
			VAR _Opening =
			    CALCULATE (
			        [Net Working Capital],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[date] < _PeriodStart
			    )
			RETURN
			    IF ( NOT ISBLANK ( _Opening ), _Closing - _Opening )
		formatString: #,##0
		displayFolder: 08 Cash & Working Capital
		lineageTag: fda526c4-c178-4678-8b5a-70544372db0e

	/// Days sales outstanding: how long customers take to pay. Uses the day count of the selected period, so view it at year or month grain - across multiple years the day count makes it meaningless.
	measure DSO =
			VAR _Revenue =
			    CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        REMOVEFILTERS ( dim_cost_center ),
			        dim_account[account_type] = "Revenue"
			    )
			VAR _Days = COUNTROWS ( dim_date )
			RETURN
			    DIVIDE ( [Accounts Receivable] * _Days, _Revenue )
		formatString: #,##0 "days"
		displayFolder: 08 Cash & Working Capital
		lineageTag: c99081f7-063e-423d-b9af-09d0184cb322

	/// Days inventory outstanding: how long stock sits before being consumed. Same period-grain caveat as DSO.
	measure DIO =
			VAR _Material =
			    - CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        REMOVEFILTERS ( dim_cost_center ),
			        dim_account[account_category] = "Material Costs"
			    )
			VAR _Days = COUNTROWS ( dim_date )
			RETURN
			    DIVIDE ( [Inventory] * _Days, _Material )
		formatString: #,##0 "days"
		displayFolder: 08 Cash & Working Capital
		lineageTag: dbe46515-4998-4c33-9a40-8bda97cfc192

	/// Days payables outstanding: how long the company takes to pay suppliers. The account list is the third-party purchased spend - it deliberately excludes personnel, rent, insurance and depreciation, which generate no supplier invoice.
	measure DPO =
			VAR _Purchased =
			    - CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        REMOVEFILTERS ( dim_cost_center ),
			        dim_account[account_id] IN { 5000, 5100, 5200, 5300, 5600, 5700, 5800, 6000, 6200 }
			    )
			VAR _Days = COUNTROWS ( dim_date )
			RETURN
			    DIVIDE ( [Accounts Payable] * _Days, _Purchased )
		formatString: #,##0 "days"
		displayFolder: 08 Cash & Working Capital
		lineageTag: 8f6f6d25-4a80-47db-b7a3-04254122d57a

	/// Days between paying suppliers and collecting from customers. Lower is better; rising means working capital is absorbing more cash.
	measure 'Cash Conversion Cycle' = [DSO] + [DIO] - [DPO]
		formatString: #,##0 "days"
		displayFolder: 08 Cash & Working Capital
		lineageTag: 1dd79706-5a6b-4440-ad98-8549cc2dfa89

	/// Capital expenditure, ACTUAL only (is_forecast = FALSE) - see Capex Forecast. Positive because it is a cash outflow, not a P&L expense - it does not follow the revenue-positive/expense-negative convention. SYNTHETIC, calibrated to run just above depreciation (1.04-1.07x).
	measure Capex = CALCULATE ( SUM ( fact_capex[capex_amount] ), fact_capex[is_forecast] = FALSE )
		formatString: #,##0
		displayFolder: 08 Cash & Working Capital
		lineageTag: 8bc1d3d3-ee66-4394-b953-397c73021a7f

	/// Indirect method: net income plus depreciation (non-cash) less the cash absorbed by working capital. Blank for 2023, which has no prior-year working capital to difference against.
	measure 'Operating Cash Flow' =
			VAR _dNWC = [Delta NWC]
			RETURN
			    IF ( NOT ISBLANK ( _dNWC ), [Net Income] + [Depreciation] - _dNWC )
		formatString: #,##0
		displayFolder: 08 Cash & Working Capital
		lineageTag: 69e8abbe-f20d-491c-a811-1bc2bb84acea

	/// Operating cash flow less capital expenditure. The cash genuinely free for debt service, dividends or reinvestment. Blank for 2023 - see Operating Cash Flow.
	measure 'Free Cash Flow' =
			VAR _OCF = [Operating Cash Flow]
			RETURN
			    IF ( NOT ISBLANK ( _OCF ), _OCF - [Capex] )
		formatString: #,##0
		displayFolder: 08 Cash & Working Capital
		lineageTag: 68700959-9f52-42ef-944b-6a8b7b83f74b

	/// Year-over-year change in revenue as %. Prior-year revenue is held in a variable rather than a separate measure. ABS in the denominator for the same reason as Variance %. Blank for 2023, which has no prior year. Use instead of Actual YoY %, which measures growth of the operating result, not of revenue.
	measure 'Revenue YoY %' =
			VAR _RevenuePY =
			    CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )
			RETURN
			    DIVIDE ( [Revenue] - _RevenuePY, ABS ( _RevenuePY ) )
		formatString: 0.0%;-0.0%
		displayFolder: 05 Time Comparison
		lineageTag: 819c6b94-b36e-4760-a931-c8a9b22d48b9

	/// Conditional formatting colour for Revenue YoY %. Green when revenue grew, red when it fell, grey at exactly zero, blank for 2023 so a missing prior year is left uncoloured rather than painted red. Apply via Format pane > Callout value / Data label > Colour > fx > Field value.
	measure 'Revenue YoY % Colour' =
			VAR _Value = [Revenue YoY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), BLANK (),
			        _Value > 0, "#107C41",
			        _Value < 0, "#C50F1F",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: a63e33a4-391d-4e67-a1fe-6db79ba507b3

	/// Conditional formatting colour for Actual YoY %. Same rule as Revenue YoY % Colour. Valid for both revenue and cost without branching because the model stores revenue positive and expense negative, so a positive change is always favourable.
	measure 'Actual YoY % Colour' =
			VAR _Value = [Actual YoY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), BLANK (),
			        _Value > 0, "#107C41",
			        _Value < 0, "#C50F1F",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: 5180962f-aa89-4b60-922d-36d572e55126

	/// Display label for the revenue trend, e.g. "▲ +6,7% vs. PY". Built for the secondary line of a card, where one string reads faster than a number plus a separate caption. Reads Revenue YoY % rather than recomputing the growth, so the number has a single definition. Arrow up for growth, down for decline, bar for flat. Returns blank for 2023 so the label disappears rather than claiming a comparison that does not exist. Colour it with Revenue YoY % Colour.
	measure 'Revenue vs PY' =
			VAR _Pct = [Revenue YoY %]
			VAR _Arrow =
			    SWITCH ( TRUE (), _Pct > 0, "▲", _Pct < 0, "▼", "▬" )
			RETURN
			    IF (
			        ISBLANK ( _Pct ),
			        BLANK (),
			        _Arrow & " " & FORMAT ( _Pct, "+0.0%;-0.0%" ) & " vs. PY"
			    )
		displayFolder: 05 Time Comparison
		lineageTag: 72972486-8345-4027-94b1-9560074da7c8

	/// Year-over-year change in EBITDA as %. ABS in the denominator so negative always reads as unfavourable, matching Variance % and Revenue YoY %. Blank for 2023, which has no prior year. Meaningful at P&L level rather than filtered to a single account, because Depreciation ignores account filters.
	measure 'EBITDA YoY %' =
			VAR _EBITDAPY =
			    CALCULATE ( [EBITDA], SAMEPERIODLASTYEAR ( dim_date[date] ) )
			RETURN
			    DIVIDE ( [EBITDA] - _EBITDAPY, ABS ( _EBITDAPY ) )
		formatString: 0.0%;-0.0%
		displayFolder: 05 Time Comparison
		lineageTag: 81ba499a-c031-4e4c-8119-414c49100558

	/// Year-over-year change in net income as %. ABS in the denominator for the same reason as Revenue YoY %. Blank for 2023, which has no prior year. COMPANY LEVEL ONLY, because Tax has no cost center, account, product or customer grain.
	measure 'Net Income YoY %' =
			VAR _NetIncomePY =
			    CALCULATE ( [Net Income], SAMEPERIODLASTYEAR ( dim_date[date] ) )
			RETURN
			    DIVIDE ( [Net Income] - _NetIncomePY, ABS ( _NetIncomePY ) )
		formatString: 0.0%;-0.0%
		displayFolder: 05 Time Comparison
		lineageTag: d7a31a8f-f8e4-41dd-b1f3-7b396b746581

	/// Display label for the EBITDA trend, e.g. "▼ -12,4% vs. PY". Same pattern as Revenue vs PY: reads EBITDA YoY % rather than recomputing the growth. Blank for 2023. Colour it with EBITDA YoY % Colour.
	measure 'EBITDA vs PY' =
			VAR _Pct = [EBITDA YoY %]
			VAR _Arrow =
			    SWITCH ( TRUE (), _Pct > 0, "▲", _Pct < 0, "▼", "▬" )
			RETURN
			    IF (
			        ISBLANK ( _Pct ),
			        BLANK (),
			        _Arrow & " " & FORMAT ( _Pct, "+0.0%;-0.0%" ) & " vs. PY"
			    )
		displayFolder: 05 Time Comparison
		lineageTag: 6d18cd1d-8f10-4aed-9914-9914ee19fb43

	/// Display label for the net income trend, e.g. "▼ -31,2% vs. PY". Same pattern as Revenue vs PY. Blank for 2023. COMPANY LEVEL ONLY, inherited from Net Income. Colour it with Net Income YoY % Colour.
	measure 'Net Income vs PY' =
			VAR _Pct = [Net Income YoY %]
			VAR _Arrow =
			    SWITCH ( TRUE (), _Pct > 0, "▲", _Pct < 0, "▼", "▬" )
			RETURN
			    IF (
			        ISBLANK ( _Pct ),
			        BLANK (),
			        _Arrow & " " & FORMAT ( _Pct, "+0.0%;-0.0%" ) & " vs. PY"
			    )
		displayFolder: 05 Time Comparison
		lineageTag: 8c77bc35-be5f-4f08-94a1-6b090a2f2951

	/// Conditional formatting colour for EBITDA YoY % and EBITDA vs PY. Green when EBITDA grew, red when it fell, grey at exactly zero, blank for 2023 so a missing prior year is left uncoloured rather than painted red.
	measure 'EBITDA YoY % Colour' =
			VAR _Value = [EBITDA YoY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), BLANK (),
			        _Value > 0, "#107C41",
			        _Value < 0, "#C50F1F",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: 73cc543b-d25d-43af-a490-d19e509e13e2

	/// Conditional formatting colour for Net Income YoY % and Net Income vs PY. Same rule as EBITDA YoY % Colour. COMPANY LEVEL ONLY, inherited from Net Income.
	measure 'Net Income YoY % Colour' =
			VAR _Value = [Net Income YoY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), BLANK (),
			        _Value > 0, "#107C41",
			        _Value < 0, "#C50F1F",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: fef9c2e9-b7a6-4e9c-8eaa-20eb5075f171

	/// Year-over-year change in EBITDA, in EUR. Blank where no prior year exists, so 2023 does not read as growth from zero. Same shape as Actual YoY. Colour it with EBITDA YoY % Colour, which keys on the same sign.
	measure 'EBITDA YoY' =
			VAR _PriorYear =
			    CALCULATE ( [EBITDA], SAMEPERIODLASTYEAR ( dim_date[date] ) )
			RETURN
			    IF ( NOT ISBLANK ( _PriorYear ), [EBITDA] - _PriorYear )
		formatString: #,##0
		displayFolder: 05 Time Comparison
		lineageTag: e0668fbc-bd4b-4743-8342-aa31d0ea564f

	/// Year-over-year change in EBITDA margin, expressed in PERCENTAGE POINTS. This is a subtraction of two margins, not a percent change of a percent: a margin falling from 15% to 12% returns -3 points, not -20%. Stored as a fraction so it composes with other DAX; use EBITDA Margin vs PY for a label that spells out pp. Blank for 2023, which has no prior year.
	measure 'EBITDA Margin YoY' =
			VAR _PriorYear =
			    CALCULATE ( [EBITDA Margin %], SAMEPERIODLASTYEAR ( dim_date[date] ) )
			RETURN
			    IF ( NOT ISBLANK ( _PriorYear ), [EBITDA Margin %] - _PriorYear )
		formatString: +0.0%;-0.0%
		displayFolder: 05 Time Comparison
		lineageTag: 3ef2f8ad-621e-4ecb-ae29-4c8a2ace2f9d

	/// Display label for the EBITDA margin trend, e.g. "▼ -1,5 pp vs. PY". Writes pp rather than % so the reader cannot mistake a percentage-point move for a relative change. Multiplies by 100 because the underlying measure stores a fraction. Blank for 2023. Colour it with EBITDA Margin YoY Colour.
	measure 'EBITDA Margin vs PY' =
			VAR _Delta = [EBITDA Margin YoY]
			VAR _Arrow =
			    SWITCH ( TRUE (), _Delta > 0, "▲", _Delta < 0, "▼", "▬" )
			RETURN
			    IF (
			        ISBLANK ( _Delta ),
			        BLANK (),
			        _Arrow & " " & FORMAT ( _Delta * 100, "+0.0;-0.0" ) & " pp vs. PY"
			    )
		displayFolder: 05 Time Comparison
		lineageTag: 3b2d233c-ca08-4e75-9558-9b9c9effb4bb

	/// Conditional formatting colour for EBITDA Margin YoY and EBITDA Margin vs PY. Green when the margin widened, red when it narrowed, grey when flat, blank for 2023.
	measure 'EBITDA Margin YoY Colour' =
			VAR _Value = [EBITDA Margin YoY]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), BLANK (),
			        _Value > 0, "#107C41",
			        _Value < 0, "#C50F1F",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: 6c7167a6-5bf3-4e7f-8e70-0a14ad0de64b

	/// Operating cash flow as % of EBITDA: how much of the reported operating profit actually turned into cash. Around 100% means profit converts cleanly; persistently below means working capital is absorbing the earnings. Guarded to EBITDA above zero, because the ratio is not interpretable against a negative or zero denominator and DIVIDE alone would return a misleading sign. Blank for 2023, inherited from Operating Cash Flow, which has no prior-year working capital to difference against. COMPANY LEVEL ONLY, inherited from Net Income and the synthetic working capital data.
	measure 'Cash Conversion Rate' =
			VAR _EBITDA = [EBITDA]
			VAR _OCF = [Operating Cash Flow]
			RETURN
			    IF ( _EBITDA > 0, DIVIDE ( _OCF, _EBITDA ) )
		formatString: 0.0%
		displayFolder: 08 Cash & Working Capital
		lineageTag: c312817d-21aa-490e-86f8-09f2175ed7aa

	/// Year-over-year change in the cash conversion rate, expressed in PERCENTAGE POINTS. Subtracts two rates rather than dividing them, the same treatment as EBITDA Margin YoY. Guarded to a single year in context, because SAMEPERIODLASTYEAR against a multi-year selection compares overlapping windows and returns a meaningless figure. Returns a value for 2025 only in the current dataset: Cash Conversion Rate is blank for 2023, which leaves 2024 without a prior year to compare against.
	measure 'Cash Conversion Rate YoY' =
			IF (
			    HASONEVALUE ( dim_date[year] ),
			    VAR _PriorYear =
			        CALCULATE ( [Cash Conversion Rate], SAMEPERIODLASTYEAR ( dim_date[date] ) )
			    RETURN
			        IF ( NOT ISBLANK ( _PriorYear ), [Cash Conversion Rate] - _PriorYear )
			)
		formatString: +0.0%;-0.0%
		displayFolder: 08 Cash & Working Capital
		lineageTag: 1d50e759-c342-4784-af57-28a51adbc89d

	/// Display label for the cash conversion trend, e.g. "▼ -5,8 pp vs. PY". Writes pp rather than % so a percentage-point move is not misread as a relative change. Same pattern as EBITDA Margin vs PY. Colour it with Cash Conversion Rate YoY Colour.
	measure 'Cash Conversion Rate vs PY' =
			VAR _Delta = [Cash Conversion Rate YoY]
			VAR _Arrow =
			    SWITCH ( TRUE (), _Delta > 0, "▲", _Delta < 0, "▼", "▬" )
			RETURN
			    IF (
			        ISBLANK ( _Delta ),
			        BLANK (),
			        _Arrow & " " & FORMAT ( _Delta * 100, "+0.0;-0.0" ) & " pp vs. PY"
			    )
		displayFolder: 08 Cash & Working Capital
		lineageTag: 1331e59c-ad43-485c-8df0-c8600898f312

	/// Conditional formatting colour for Cash Conversion Rate YoY and Cash Conversion Rate vs PY. Green when more of the profit converted to cash than last year, red when less, grey when flat, blank where no comparison exists.
	measure 'Cash Conversion Rate YoY Colour' =
			VAR _Value = [Cash Conversion Rate YoY]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), BLANK (),
			        _Value > 0, "#107C41",
			        _Value < 0, "#C50F1F",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: a67478f0-fe96-4ca6-8ffc-1599b614036b

	/// Conditional formatting colour for Variance and Variance %. Green when favourable, red when unfavourable, grey at exactly zero, blank where no variance exists. One rule serves both revenue and cost without branching, because the model stores revenue positive and expense negative, so a positive variance is always favourable. Apply via Format pane > Colours > fx > Format style: Field value. Blank stays uncoloured, which matters for unbudgeted grains such as customer or product, where Variance returns blank by design.
	measure 'Variance Colour' =
			VAR _Value = [Variance]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), BLANK (),
			        _Value > 0, "#107C41",
			        _Value < 0, "#C50F1F",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: e4d056f8-f1f5-4239-a445-1cca0f4331ed

	/// Planned revenue: the budget restricted to revenue accounts. Ignores account slicers by design, the same pattern as Depreciation, so it stays comparable to the Revenue measure at company level.
	measure 'Revenue Plan' =
			CALCULATE (
			    [Budget],
			    REMOVEFILTERS ( dim_account ),
			    dim_account[account_category] = "Revenue"
			)
		formatString: #,##0
		displayFolder: 01 Base
		lineageTag: 7f48237a-d7ab-4eed-a5a0-0e1c03a077ab

	/// Planned depreciation, returned positive for display. Mirrors the Depreciation measure so EBITDA Plan can add it back the same way EBITDA does.
	measure 'Depreciation Plan' =
			- CALCULATE (
			    [Budget],
			    REMOVEFILTERS ( dim_account ),
			    dim_account[account_category] = "Depreciation"
			)
		formatString: #,##0
		displayFolder: 01 Base
		lineageTag: aa51c67a-7078-462d-9f7d-6f9469ce2d75

	/// Planned EBITDA: the full budget, which equals the planned operating result under the sign convention, with planned depreciation added back. Mirrors how EBITDA is built from EBIT.
	measure 'EBITDA Plan' = CALCULATE ( [Budget], REMOVEFILTERS ( dim_account ) ) + [Depreciation Plan]
		formatString: #,##0
		displayFolder: 01 Base
		lineageTag: 8274c9ab-6acc-4700-a442-f3e747719296

	/// Prior-year revenue. Blank for 2023, which has no prior year in the dataset.
	measure 'Revenue PY' = CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: #,##0
		displayFolder: 05 Time Comparison
		lineageTag: 28bd55e9-80a1-46ca-ba80-1862a01e84bd

	/// Prior-year EBITDA. Blank for 2023, which has no prior year in the dataset.
	measure 'EBITDA PY' = CALCULATE ( [EBITDA], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: #,##0
		displayFolder: 05 Time Comparison
		lineageTag: 52da76c8-783d-452b-a1e0-8d6f745c2c87

	/// Prior-year net income. Blank for 2023. COMPANY LEVEL ONLY, inherited from Net Income.
	measure 'Net Income PY' = CALCULATE ( [Net Income], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: #,##0
		displayFolder: 05 Time Comparison
		lineageTag: 9e583d40-6588-47a2-9636-07705d286e7a

	/// Ist line of the trend chart. Returns whichever KPI the reader picked in the KPI_Selector slicer. Branch strings must match the labels in KPI_Selector exactly. Blank when nothing or more than one item is selected, so set the slicer to Single select.
	measure 'Selected Actual' =
			SWITCH (
			    SELECTEDVALUE ( KPI_Selector[KPI] ),
			    "Revenue", [Revenue],
			    "EBITDA", [EBITDA],
			    "Net Income", [Net Income]
			)
		formatString: #,##0
		displayFolder: 10 Selector
		lineageTag: 5fdb6153-43bb-4b44-878a-05883689e269

	/// Plan line of the trend chart. Deliberately has no Net Income branch: the budget covers P&L accounts only and fact_tax has no budget counterpart, so planned net income does not exist in this model. The plan line therefore disappears when Net Income is selected.
	measure 'Selected Plan' =
			SWITCH (
			    SELECTEDVALUE ( KPI_Selector[KPI] ),
			    "Revenue", [Revenue Plan],
			    "EBITDA", [EBITDA Plan]
			)
		formatString: #,##0
		displayFolder: 10 Selector
		lineageTag: 74b6c698-ee29-4d04-a179-293da68b3168

	/// Vorjahr line of the trend chart. Blank for 2023, which has no prior year. Rename the field in the visual's field well to Prior Year if the legend should read fully in English.
	measure 'Selected Vorjahr' =
			SWITCH (
			    SELECTEDVALUE ( KPI_Selector[KPI] ),
			    "Revenue", [Revenue PY],
			    "EBITDA", [EBITDA PY],
			    "Net Income", [Net Income PY]
			)
		formatString: #,##0
		displayFolder: 10 Selector
		lineageTag: c9ffd515-efe5-4c6f-95a4-8d273efc5771

	/// Step value for the Revenue-to-Net-Income bridge, driven by the disconnected Bridge table. The SWITCH falls through to _Cost for the five cost steps, because those Bridge[Step] labels are exact dim_account[account_category] values - one branch instead of five near-identical ones. Tax is negated: the Tax measure returns positive for display, but a bridge needs it as a decrease. REMOVEFILTERS ( dim_account ) keeps the bridge intact if an account slicer sits on the page, which would otherwise silently blank out steps. The seven increment steps sum to the Net Income step, so a plain SUM across all eight rows returns twice net income - that is expected, and it is why this cannot drive the native waterfall visual, which always adds its own total bar. Use Bridge Base and Bridge Height on a stacked column instead. COMPANY LEVEL ONLY, inherited from Tax and Net Income: the bridge is wrong under a cost center, product or customer filter, because those grains have no tax. Blank on any Bridge[Step] value not listed, so a mistyped label shows as a gap rather than a wrong number.
	measure 'Bridge Value' =
			VAR _Step = SELECTEDVALUE ( Bridge[Step] )
			VAR _Cost =
			    CALCULATE (
			        [Actual],
			        REMOVEFILTERS ( dim_account ),
			        dim_account[account_category] = _Step
			    )
			RETURN
			    SWITCH (
			        _Step,
			        "Revenue", [Revenue],
			        "Tax", - [Tax],
			        "Net Income", [Net Income],
			        _Cost
			    )
		formatString: #,##0
		displayFolder: 11 Bridge
		lineageTag: af3c7c17-e98e-4985-83c9-2d72e2465acf

	/// Prior-year closing receivables. SAMEPERIODLASTYEAR is safe on a semi-additive balance because it shifts the whole date window and LASTNONBLANKVALUE then picks the closing date of the shifted window, so December compares to December and June to June rather than summing months. Blank for 2023, which has no prior year in the dataset. Company level only: fact_working_capital has no company, cost center, product or customer grain.
	measure 'Accounts Receivable PY' = CALCULATE ( [Accounts Receivable], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: #,##0
		displayFolder: 05 Time Comparison
		lineageTag: 6c44f604-7bfd-49a0-a55a-2239480ec231

	/// Year-over-year change in closing receivables, in EUR. Plain sign: positive means the balance grew, which is UNFAVOURABLE - cash stuck with customers. This deliberately departs from the model convention where negative means unfavourable, so that the number reads as the actual direction of the balance; the good-or-bad judgement is carried by Accounts Receivable YoY % Colour instead. Blank where no prior year exists, so 2023 does not read as growth from zero.
	measure 'Accounts Receivable YoY' =
			VAR _Cur = [Accounts Receivable]
			VAR _Prior = [Accounts Receivable PY]
			RETURN
			    IF ( NOT ISBLANK ( _Prior ), _Cur - _Prior )
		formatString: #,##0
		displayFolder: 05 Time Comparison
		lineageTag: cfc3e990-4d7c-449c-b5b5-12539a8e14cd

	/// Year-over-year change in closing receivables as %. Plain sign: positive means the balance grew, which is unfavourable - see Accounts Receivable YoY. ABS in the denominator guards against a negative prior balance flipping the sign, matching the pattern used by Variance % and Revenue YoY %. Blank for 2023, which has no prior year.
	measure 'Accounts Receivable YoY %' =
			VAR _Cur = [Accounts Receivable]
			VAR _Prior = [Accounts Receivable PY]
			RETURN
			    IF ( NOT ISBLANK ( _Prior ), DIVIDE ( _Cur - _Prior, ABS ( _Prior ) ) )
		formatString: +0.0%;-0.0%
		displayFolder: 05 Time Comparison
		lineageTag: 55a8e9f6-29bd-440a-a4b0-fef2c0dc4a47

	/// Conditional formatting colour for Accounts Receivable YoY and YoY %. DELIBERATELY INVERTED against every other colour measure in this folder: rising receivables mean cash is stuck with customers, so growth is red and shrinkage is green. Reusing Revenue YoY % Colour here would paint a worsening position green. Grey at exactly zero, blank for 2023 so a missing prior year is left uncoloured rather than painted red. Apply via Format pane > Callout value / Data label > Colour > fx > Field value.
	measure 'Accounts Receivable YoY % Colour' =
			VAR _Value = [Accounts Receivable YoY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), BLANK (),
			        _Value > 0, "#C50F1F",
			        _Value < 0, "#107C41",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: 396d336d-5e19-407d-899e-9913322b8496

	/// Display label for the receivables trend, e.g. "▲ +17,5% vs. PY". Same pattern as Revenue vs PY: reads Accounts Receivable YoY % rather than recomputing the growth, so the number keeps a single definition. The arrow reports DIRECTION, not sentiment - it points up when receivables grow, which is unfavourable, and Accounts Receivable YoY % Colour supplies the red. Flipping the arrow instead would make it contradict the sign printed beside it. Returns blank for 2023 so the label disappears rather than claiming a comparison that does not exist. Company level only, inherited from Accounts Receivable.
	measure 'Accounts Receivable vs PY' =
			VAR _Pct = [Accounts Receivable YoY %]
			VAR _Arrow =
			    SWITCH ( TRUE (), _Pct > 0, "▲", _Pct < 0, "▼", "▬" )
			RETURN
			    IF (
			        ISBLANK ( _Pct ),
			        BLANK (),
			        _Arrow & " " & FORMAT ( _Pct, "+0.0%;-0.0%" ) & " vs. PY"
			    )
		displayFolder: 05 Time Comparison
		lineageTag: 08e0e14a-3a0b-4418-92a1-3d678ed44ae8

	/// Prior-year closing net working capital. SAMEPERIODLASTYEAR is safe on a semi-additive balance because it shifts the whole date window and the closing-balance logic then picks the last date of the shifted window. Blank for 2023, which has no prior year. Company level only: fact_working_capital has no company, cost center, product or customer grain.
	measure 'Net Working Capital PY' = CALCULATE ( [Net Working Capital], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: #,##0
		displayFolder: 05 Time Comparison
		lineageTag: 14f73467-5835-41a5-a7db-8e377c417cc4

	/// Year-over-year change in closing net working capital, in EUR. Plain sign: positive means the balance grew, which is UNFAVOURABLE - more cash tied up in operations. Sentiment is carried by Net Working Capital YoY % Colour, not by the sign. At year grain this equals Delta NWC, which differences the same two closing balances; the two measures exist for different purposes, this one for a card label and Delta NWC as an input to Operating Cash Flow. Blank for 2023.
	measure 'Net Working Capital YoY' =
			VAR _Cur = [Net Working Capital]
			VAR _Prior = [Net Working Capital PY]
			RETURN
			    IF ( NOT ISBLANK ( _Prior ), _Cur - _Prior )
		formatString: +#,##0;-#,##0
		displayFolder: 05 Time Comparison
		lineageTag: 4ad102cc-ba1e-45b3-9f79-d905c4614a09

	/// Year-over-year change in closing net working capital as %. Plain sign: positive means the balance grew, which is unfavourable. ABS in the denominator guards against a negative prior balance flipping the sign. Blank for 2023.
	measure 'Net Working Capital YoY %' =
			VAR _Cur = [Net Working Capital]
			VAR _Prior = [Net Working Capital PY]
			RETURN
			    IF ( NOT ISBLANK ( _Prior ), DIVIDE ( _Cur - _Prior, ABS ( _Prior ) ) )
		formatString: +0.0%;-0.0%
		displayFolder: 05 Time Comparison
		lineageTag: 791fb6f4-6811-4482-ad09-33a84173215f

	/// Conditional formatting colour for Net Working Capital YoY and YoY %. INVERTED against the P&L colour measures: growing working capital absorbs cash, so growth is red and shrinkage is green. Same direction as Accounts Receivable YoY % Colour. Grey at exactly zero, blank for 2023.
	measure 'Net Working Capital YoY % Colour' =
			VAR _Value = [Net Working Capital YoY %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), BLANK (),
			        _Value > 0, "#C50F1F",
			        _Value < 0, "#107C41",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: 17fa3645-dd60-45bd-9d77-5ba0d957b0e0

	/// Display label for the net working capital trend, e.g. "▲ +19,7% vs. PY". Same pattern as Revenue vs PY. The arrow reports DIRECTION, not sentiment - it points up when working capital grows, which is unfavourable; Net Working Capital YoY % Colour supplies the red. Blank for 2023.
	measure 'Net Working Capital vs PY' =
			VAR _Pct = [Net Working Capital YoY %]
			VAR _Arrow =
			    SWITCH ( TRUE (), _Pct > 0, "▲", _Pct < 0, "▼", "▬" )
			RETURN
			    IF (
			        ISBLANK ( _Pct ),
			        BLANK (),
			        _Arrow & " " & FORMAT ( _Pct, "+0.0%;-0.0%" ) & " vs. PY"
			    )
		displayFolder: 05 Time Comparison
		lineageTag: 7f168459-23c6-421c-9c69-14fe51c5ad27

	/// Prior-year days sales outstanding. SAMEPERIODLASTYEAR shifts the whole window, so the prior-year receivables, revenue and day count are all taken from the shifted period. Valid at year or month grain only, inherited from DSO, which divides by the day count of the selected period. Blank for 2023.
	measure 'DSO PY' = CALCULATE ( [DSO], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: #,##0 "days"
		displayFolder: 05 Time Comparison
		lineageTag: c486d189-9c86-46ce-8606-b8c95ec5fc10

	/// Year-over-year change in DSO, expressed in DAYS. A subtraction of two day counts, not a percent change - the same treatment as EBITDA Margin YoY, which reports percentage points. Expressing a six-day slip as a percentage buries the only figure that matters. Positive means customers are paying slower, which is UNFAVOURABLE; sentiment is carried by DSO YoY Colour. Valid at year or month grain only. Blank for 2023.
	measure 'DSO YoY' =
			VAR _Cur = [DSO]
			VAR _Prior = [DSO PY]
			RETURN
			    IF ( NOT ISBLANK ( _Prior ), _Cur - _Prior )
		formatString: +0.0;-0.0
		displayFolder: 05 Time Comparison
		lineageTag: ff942371-83a9-4b1a-b952-91b4e119e0a7

	/// Conditional formatting colour for DSO YoY and DSO vs PY. Rising DSO means customers pay slower, so growth is red and improvement is green. NOTE the contrast with DPO YoY Colour, which is deliberately the other way round. Grey at exactly zero, blank for 2023.
	measure 'DSO YoY Colour' =
			VAR _Value = [DSO YoY]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), BLANK (),
			        _Value > 0, "#C50F1F",
			        _Value < 0, "#107C41",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: e881acc9-be2c-4587-b833-e268306fa955

	/// Display label for the DSO trend, e.g. "▲ +5,7 d vs. PY". Writes d rather than days so it does not collide with the days already printed in the card callout above it. The arrow reports direction, not sentiment; colour it with DSO YoY Colour. Blank for 2023.
	measure 'DSO vs PY' =
			VAR _Delta = [DSO YoY]
			VAR _Arrow =
			    SWITCH ( TRUE (), _Delta > 0, "▲", _Delta < 0, "▼", "▬" )
			RETURN
			    IF (
			        ISBLANK ( _Delta ),
			        BLANK (),
			        _Arrow & " " & FORMAT ( _Delta, "+0.0;-0.0" ) & " d vs. PY"
			    )
		displayFolder: 05 Time Comparison
		lineageTag: d0dd45ca-3794-42f2-baf5-d535232c4c35

	/// Prior-year days inventory outstanding. SAMEPERIODLASTYEAR shifts the whole window, so prior-year inventory, material consumption and day count all come from the shifted period. Valid at year or month grain only, inherited from DIO. Blank for 2023.
	measure 'DIO PY' = CALCULATE ( [DIO], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: #,##0 "days"
		displayFolder: 05 Time Comparison
		lineageTag: d4594b0e-bee6-4118-814e-da99ef4b2393

	/// Year-over-year change in DIO, expressed in DAYS - a subtraction of two day counts, not a percent change. Positive means stock sits longer before being consumed, which is UNFAVOURABLE; sentiment is carried by DIO YoY Colour. Valid at year or month grain only. Blank for 2023.
	measure 'DIO YoY' =
			VAR _Cur = [DIO]
			VAR _Prior = [DIO PY]
			RETURN
			    IF ( NOT ISBLANK ( _Prior ), _Cur - _Prior )
		formatString: +0.0;-0.0
		displayFolder: 05 Time Comparison
		lineageTag: 3b43709c-ea92-4ff5-a34e-0406394695e2

	/// Conditional formatting colour for DIO YoY and DIO vs PY. Rising DIO means stock turns slower, so growth is red and improvement is green. Grey at exactly zero, blank for 2023.
	measure 'DIO YoY Colour' =
			VAR _Value = [DIO YoY]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), BLANK (),
			        _Value > 0, "#C50F1F",
			        _Value < 0, "#107C41",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: ebda2d16-f822-4f58-ad91-f93caedc76c9

	/// Display label for the DIO trend, e.g. "▲ +5,4 d vs. PY". Writes d rather than days so it does not collide with the card callout. Colour it with DIO YoY Colour. Blank for 2023.
	measure 'DIO vs PY' =
			VAR _Delta = [DIO YoY]
			VAR _Arrow =
			    SWITCH ( TRUE (), _Delta > 0, "▲", _Delta < 0, "▼", "▬" )
			RETURN
			    IF (
			        ISBLANK ( _Delta ),
			        BLANK (),
			        _Arrow & " " & FORMAT ( _Delta, "+0.0;-0.0" ) & " d vs. PY"
			    )
		displayFolder: 05 Time Comparison
		lineageTag: fb25b7fc-2623-43f4-aeab-906fa86039b9

	/// Prior-year days payables outstanding. SAMEPERIODLASTYEAR shifts the whole window, so prior-year payables, purchased spend and day count all come from the shifted period. Valid at year or month grain only, inherited from DPO. Blank for 2023.
	measure 'DPO PY' = CALCULATE ( [DPO], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: #,##0 "days"
		displayFolder: 05 Time Comparison
		lineageTag: f5fbe755-910d-4e0f-bd86-54ba870372cf

	/// Year-over-year change in DPO, expressed in DAYS - a subtraction of two day counts, not a percent change. Positive means the company pays suppliers later, which is FAVOURABLE: it keeps cash in the business. This is the opposite reading to DSO YoY and DIO YoY, which is why DPO YoY Colour is inverted relative to theirs. Valid at year or month grain only. Blank for 2023.
	measure 'DPO YoY' =
			VAR _Cur = [DPO]
			VAR _Prior = [DPO PY]
			RETURN
			    IF ( NOT ISBLANK ( _Prior ), _Cur - _Prior )
		formatString: +0.0;-0.0
		displayFolder: 05 Time Comparison
		lineageTag: 56abdef0-a8d6-4f6a-9d1b-dc95e7547ff5

	/// Conditional formatting colour for DPO YoY and DPO vs PY. DELIBERATELY INVERTED against DSO YoY Colour and DIO YoY Colour: paying suppliers later keeps cash in the business, so a rising DPO is GREEN and a falling DPO is red. Reusing the DSO colour measure here would paint an improving cash position red. Grey at exactly zero, blank for 2023.
	measure 'DPO YoY Colour' =
			VAR _Value = [DPO YoY]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), BLANK (),
			        _Value > 0, "#107C41",
			        _Value < 0, "#C50F1F",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: 2f0b319c-4bec-4395-a890-f9d97dee006e

	/// Display label for the DPO trend, e.g. "▲ +2,1 d vs. PY". The arrow reports direction, not sentiment - and for DPO an up arrow is good news. Colour it with DPO YoY Colour, which is inverted for exactly that reason. Blank for 2023.
	measure 'DPO vs PY' =
			VAR _Delta = [DPO YoY]
			VAR _Arrow =
			    SWITCH ( TRUE (), _Delta > 0, "▲", _Delta < 0, "▼", "▬" )
			RETURN
			    IF (
			        ISBLANK ( _Delta ),
			        BLANK (),
			        _Arrow & " " & FORMAT ( _Delta, "+0.0;-0.0" ) & " d vs. PY"
			    )
		displayFolder: 05 Time Comparison
		lineageTag: a5a68767-9ce7-4f59-bebf-e0d33efebb24

	/// Dynamic title for the Ist/Plan/Vorjahr trend chart. Reads the KPI_Selector slicer so the title names whichever measure the reader picked, replacing a static title that mentioned only two of the three options. Drops the Plan clause when Net Income is selected, because Selected Plan has no Net Income branch - the budget covers P&L accounts only and fact_tax has no budget counterpart, so promising a plan line there would be a lie. Omits the year when the year slicer holds nothing or more than one value. Falls back to a prompt rather than a blank when the KPI slicer is cleared, since an empty title reads as a broken visual. Apply via Format pane > Title > Text > fx > Field value.
	measure 'Trend Title' =
			
			VAR _KPI = SELECTEDVALUE ( KPI_Selector[KPI] )
			VAR _Year = SELECTEDVALUE ( dim_date[year] )
			VAR _Scope = IF ( ISBLANK ( _Year ), "", " " & _Year )
			VAR _Lines =
			    IF (
			        _KPI = "Net Income",
			        "Actual",
			        "Actual vs. Plan"
			    )
			RETURN
			    IF (
			        ISBLANK ( _KPI ),
			        "Select a KPI to compare",
			        _KPI & _Scope & ": monthly " & _Lines
			    )
		displayFolder: 10 Selector
		lineageTag: b12abe38-043f-4402-9c55-9b70c02471c1

	/// Revenue target. A thin alias of Revenue Plan, which is the budget restricted to revenue accounts - for revenue the plan IS the target, so there is no separate calculation. Exists so every KPI card can follow the same [X] / [X Target] / [X YoY %] naming, the same reason EBIT exists as an alias of Operating Result. Ignores account slicers, inherited from Revenue Plan. Unlike the Net Income target this is a real planned figure, not a derived one.
	measure 'Revenue Target' = [Revenue Plan]
		formatString: #,##0
		displayFolder: 12 Targets
		lineageTag: 65e7e59f-6dcb-4936-a6c4-c4d60b77fb84

	/// DERIVED net income target: the budgeted operating result less tax at the effective rate. Not a planned figure - the budget covers P&L accounts only and fact_tax has no budget counterpart, so planned net income does not exist in this model. Any card using this must label it derived. Reads the live Effective Tax Rate % so it follows fact_tax if that changes, falling back to 29.825% (Koerperschaftsteuer plus Solidaritaetszuschlag plus Gewerbesteuer) where EBIT is blank and the ratio cannot be computed. Returns 1,716,458 for 2025 against an actual of 908,238, i.e. 53% achieved. Company level only, inherited from Tax.
	measure 'Net Income Target' =
			VAR _Rate = COALESCE ( [Effective Tax Rate %], 0.29825 )
			RETURN
			    [Budget] * ( 1 - _Rate )
		formatString: #,##0
		displayFolder: 12 Targets
		lineageTag: 53cc0cac-130e-4112-9efa-325e683694c4

	/// Net Income KPI card as RAW SVG MARKUP for the HTML Content custom visual, 630 x 122. Compact layout: value top left at 30px, status pill top right, year-over-year right-aligned ABOVE the bar, then the target bar and marker. Deliberately has NO title, NO achievement caption and NO left accent stripe - that is the fuller treatment in SVG KPI Card CCR HTML and SVG KPI Card HTML. Block 5 adds a bar colour: the progress bar turns red when the status is BEHIND instead of staying purple, so the bar reinforces the pill. GEOMETRY: bar x=24 width=550, so the single right edge _RightEdge is 574, and the marker sits there at 100% of the target scale. _CardRight is now an alias of _RightEdge - it was 630-30=600, which pushed the status pill 26px past the bar, marker and year-over-year text and gave the card two different right margins. Keep them equal. Still reads _KPI, _Higher and _Unit from the disconnected KPI_Cards table, so it needs one unambiguous KPI row in context: with several rows in KPI_Cards the visual must group by KPI_Cards[KPI] or SELECTEDVALUE goes blank and the card disappears. Raw markup by design - no data:image/svg+xml prefix and no URL encoding, because that prefix makes HTML Content print the string as literal text. THE ONE ENCODING RULE THAT STILL APPLIES: every interpolated number goes through FORMAT(x,"0") because the de-DE model culture would otherwise emit a decimal comma into an SVG attribute. Leave the data category UNCATEGORISED.
	measure 'SVG KPI Card' =
			
			
			// ===== 1. THRESHOLDS =====
			VAR _OnTrackAt = 1.00
			VAR _AtRiskAt = 0.90
			
			// ===== 2. WHICH CARD AM I DRAWING =====
			VAR _KPI =
			    SELECTEDVALUE ( KPI_Cards[KPI] )
			
			VAR _Higher =
			    SELECTEDVALUE ( KPI_Cards[Higher Is Better] )
			
			VAR _Unit =
			    SELECTEDVALUE ( KPI_Cards[Unit] )
			
			// ===== 3. KPI REGISTRY — NET INCOME ONLY =====
			VAR _Actual =
			    SWITCH (
			        _KPI,
			        "Net Income", [Net Income]
			    )
			
			VAR _Target =
			    SWITCH (
			        _KPI,
			        "Net Income", [Net Income Target]
			    )
			
			VAR _YoYRaw =
			    SWITCH (
			        _KPI,
			        "Net Income", [Net Income vs PY]
			    )
			
			VAR _YoYColRaw =
			    SWITCH (
			        _KPI,
			        "Net Income", [Net Income YoY % Colour]
			    )
			
			// ===== 4. STATUS =====
			VAR _Ach =
			    IF (
			        _Higher,
			        DIVIDE ( _Actual, _Target ),
			        DIVIDE ( _Target, _Actual )
			    )
			
			VAR _Status =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Ach ), "NO TARGET",
			        _Ach >= _OnTrackAt, "ON TRACK",
			        _Ach >= _AtRiskAt, "AT RISK",
			        "BEHIND"
			    )
			
			VAR _StatusCol =
			    SWITCH (
			        _Status,
			        "ON TRACK", "#107C41",
			        "AT RISK", "#C77700",
			        "BEHIND", "#C50F1F",
			        "#605E5C"
			    )
			
			// ===== 5. PROGRESS BAR COLOR =====
			VAR _BarCol =
			    IF (
			        _Status = "BEHIND",
			        "#C50F1F",
			        "#391587"
			    )
			
			// ===== 6. GEOMETRY — 630 × 122 =====
			
			VAR _BarX = 24
			VAR _BarW = 550
			
			VAR _RightEdge =
			    _BarX + _BarW
			
			VAR _MarkX =
			    _RightEdge
			
			// One right edge for everything. Was 630 - 30 = 600, which pushed the
			// status pill 26px past the bar, marker and YoY text at 574.
			VAR _CardRight =
			    _RightEdge
			
			VAR _PillW =
			    24 + LEN ( _Status ) * 7
			
			VAR _PillX =
			    _CardRight - _PillW
			
			VAR _FillW =
			    MAX (
			        0,
			        MIN (
			            _BarW,
			            _BarW * COALESCE ( _Ach, 0 )
			        )
			    )
			
			// ===== 7. NUMBER FORMATTING =====
			VAR _Eur =
			    UNICHAR ( 8364 )
			
			VAR _FmtA =
			    SWITCH (
			        _Unit,
			
			        "PCT",
			            FORMAT ( _Actual * 100, "0.0" ) & "%",
			
			        "DAYS",
			            FORMAT ( _Actual, "0" ) & " days",
			
			        SWITCH (
			            TRUE (),
			
			            ABS ( _Actual ) >= 1000000,
			                _Eur
			                    & FORMAT (
			                        _Actual / 1000000,
			                        "0.00"
			                    )
			                    & "M",
			
			            ABS ( _Actual ) >= 1000,
			                _Eur
			                    & FORMAT (
			                        _Actual / 1000,
			                        "0"
			                    )
			                    & "K",
			
			            _Eur
			                & FORMAT (
			                    _Actual,
			                    "0"
			                )
			        )
			    )
			
			// ===== 8. YOY =====
			VAR _YTxt =
			    COALESCE (
			        _YoYRaw,
			        "no prior year"
			    )
			
			VAR _YCol =
			    COALESCE (
			        _YoYColRaw,
			        "#605E5C"
			    )
			
			// ===== 9. XML ESCAPING =====
			VAR _ValX =
			    SUBSTITUTE (
			        SUBSTITUTE (
			            SUBSTITUTE (
			                _FmtA,
			                "&",
			                "&amp;"
			            ),
			            "<",
			            "&lt;"
			        ),
			        ">",
			        "&gt;"
			    )
			
			VAR _Yx =
			    SUBSTITUTE (
			        SUBSTITUTE (
			            SUBSTITUTE (
			                _YTxt,
			                "&",
			                "&amp;"
			            ),
			            "<",
			            "&lt;"
			        ),
			        ">",
			        "&gt;"
			    )
			
			// ===== 10. FONT =====
			VAR _BodyF =
			    "font-family='Segoe UI, Arial, sans-serif'"
			
			// ===== 11. RAW SVG — 630 × 122 =====
			RETURN
			
			    IF (
			        ISBLANK ( _KPI )
			            || ISBLANK ( _Actual ),
			
			        BLANK (),
			
			        "<svg "
			            & "xmlns='http://www.w3.org/2000/svg' "
			            & "width='600' "
			            & "height='122' "
			            & "viewBox='0 0 630 122'>"
			
			            // Card background
			            & "<rect "
			            & "x='0' "
			            & "y='0' "
			            & "width='600' "
			            & "height='122' "
			            & "rx='10' "
			            & "fill='#FFFFFF'/>"
			
			            // Main value
			            & "<text "
			            & "x='24' "
			            & "y='45' "
			            & _BodyF
			            & " font-size='30' "
			            & "font-weight='700' "
			            & "fill='#111827'>"
			            & _ValX
			            & "</text>"
			
			            // Status pill — top right
			& "<rect "
			& "x='"
			& FORMAT ( _PillX, "0" )
			& "' "
			& "y='10' "
			& "width='"
			& FORMAT ( _PillW, "0" )
			& "' "
			& "height='22' "
			& "rx='11' "
			& "fill='"
			& _StatusCol
			& "'/>"
			
			// Status text
			& "<text "
			& "x='"
			& FORMAT (
			    _PillX + _PillW / 2,
			    "0"
			)
			& "' "
			& "y='25' "
			& "text-anchor='middle' "
			& _BodyF
			& " font-size='11' "
			& "font-weight='700' "
			& "fill='#FFFFFF'>"
			& _Status
			& "</text>"
			
			            // YoY — above progress bar
			            & "<text "
			            & "x='"
			            & FORMAT (
			                _RightEdge,
			                "0"
			            )
			            & "' "
			            & "y='57' "
			            & "text-anchor='end' "
			            & _BodyF
			            & " font-size='12' "
			            & "font-weight='600' "
			            & "fill='"
			            & _YCol
			            & "'>"
			            & _Yx
			            & "</text>"
			
			            // Bar background
			            & "<rect "
			            & "x='"
			            & FORMAT ( _BarX, "0" )
			            & "' "
			            & "y='70' "
			            & "width='"
			            & FORMAT ( _BarW, "0" )
			            & "' "
			            & "height='8' "
			            & "rx='4' "
			            & "fill='#EEF0F4'/>"
			
			            // Actual progress
			            & "<rect "
			            & "x='"
			            & FORMAT ( _BarX, "0" )
			            & "' "
			            & "y='70' "
			            & "width='"
			            & FORMAT ( _FillW, "0" )
			            & "' "
			            & "height='8' "
			            & "rx='4' "
			            & "fill='"
			            & _BarCol
			            & "'/>"
			
			            // Target marker
			            & "<line "
			            & "x1='"
			            & FORMAT ( _MarkX, "0" )
			            & "' "
			            & "y1='65' "
			            & "x2='"
			            & FORMAT ( _MarkX, "0" )
			            & "' "
			            & "y2='83' "
			            & "stroke='#111827' "
			            & "stroke-width='2'/>"
			
			            & "</svg>"
			    )
		displayFolder: 13 HTML Cards
		lineageTag: 255cbbe3-1cdb-4de2-9f19-2a915a89d69b

	/// RAW SVG variant of SVG KPI Card, for the HTML Content custom visual. Returns markup starting at <svg>, with NO data:image/svg+xml prefix and NO URL encoding - hex colours are plain # and the percent sign plain %. That prefix is exactly what makes HTML Content print the string as literal text. Canvas 670 x 220; bar x=24 width=622 height=12; target marker at 100% of the target scale so it sits at the bar's right end; the fill is clamped with MIN so progress above 100% cannot overflow. Type scaled to the taller canvas: title 22, value 48, pill text 13, captions 14, and the pill width formula is calibrated to 13px text - revert it to 24 + LEN * 7 if the pill text goes back to 11px. Driven by the disconnected KPI_Cards table, which holds ONE row (Net Income): with a single row SELECTEDVALUE resolves on its own, so the visual does not need to group by KPI. If you add rows to KPI_Cards you MUST also put KPI_Cards[KPI] in the visual, or SELECTEDVALUE turns ambiguous and the card goes blank. Block 7 escapes ampersand, less-than and greater-than in every dynamic string, ampersand first so the entities are not double-escaped. THE ONE ENCODING RULE THAT STILL APPLIES: every interpolated number goes through FORMAT(x,"0") because the de-DE model culture would otherwise emit a decimal comma into an SVG attribute and silently break that element. Leave the data category UNCATEGORISED - Image URL is for the data-URI variant only. Attributes use single quotes so no DAX string escaping is needed.
	measure 'SVG KPI Card HTML' =
			// ===== 1. THRESHOLDS =====
			VAR _OnTrackAt = 1.00
			VAR _AtRiskAt = 0.90
			
			// ===== 2. WHICH CARD AM I DRAWING =====
			VAR _KPI = SELECTEDVALUE ( KPI_Cards[KPI] )
			VAR _Higher = SELECTEDVALUE ( KPI_Cards[Higher Is Better] )
			VAR _Unit = SELECTEDVALUE ( KPI_Cards[Unit] )
			VAR _Note = SELECTEDVALUE ( KPI_Cards[Target Note] )
			
			// ===== 3. KPI REGISTRY - unchanged =====
			VAR _Actual =
			    SWITCH ( _KPI, "Net Income", [Net Income] )
			VAR _Target =
			    SWITCH ( _KPI, "Net Income", [Net Income Target] )
			VAR _YoYRaw =
			    SWITCH ( _KPI, "Net Income", [Net Income vs PY] )
			VAR _YoYColRaw =
			    SWITCH ( _KPI, "Net Income", [Net Income YoY % Colour] )
			
			// ===== 4. STATUS - unchanged =====
			VAR _Ach =
			    IF ( _Higher, DIVIDE ( _Actual, _Target ), DIVIDE ( _Target, _Actual ) )
			VAR _Status =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Ach ), "NO TARGET",
			        _Ach >= _OnTrackAt, "ON TRACK",
			        _Ach >= _AtRiskAt, "AT RISK",
			        "BEHIND"
			    )
			VAR _StatusCol =
			    SWITCH (
			        _Status,
			        "ON TRACK", "#107C41",
			        "AT RISK", "#C77700",
			        "BEHIND", "#C50F1F",
			        "#605E5C"
			    )
			
			// ===== 5. GEOMETRY - 670 x 220, bar x=24 w=622, marker at 100% of target =====
			VAR _BarX = 24
			VAR _BarW = 622
			VAR _RightEdge = _BarX + _BarW
			VAR _MarkX = _BarX + _BarW
			VAR _FillW = MAX ( 0, MIN ( _BarW, _BarW * _Ach ) )
			VAR _PillW = 28 + LEN ( _Status ) * 8
			VAR _PillX = _RightEdge - _PillW
			
			// ===== 6. NUMBER FORMATTING - unchanged =====
			VAR _Eur = UNICHAR ( 8364 )
			VAR _FmtA =
			    SWITCH (
			        _Unit,
			        "PCT", FORMAT ( _Actual * 100, "0.0" ) & "%",
			        "DAYS", FORMAT ( _Actual, "0" ) & " days",
			        SWITCH (
			            TRUE (),
			            ABS ( _Actual ) >= 1000000, _Eur & FORMAT ( _Actual / 1000000, "0.00" ) & "M",
			            ABS ( _Actual ) >= 1000, _Eur & FORMAT ( _Actual / 1000, "0" ) & "K",
			            _Eur & FORMAT ( _Actual, "0" )
			        )
			    )
			VAR _FmtT =
			    SWITCH (
			        _Unit,
			        "PCT", FORMAT ( _Target * 100, "0.0" ) & "%",
			        "DAYS", FORMAT ( _Target, "0" ) & " days",
			        SWITCH (
			            TRUE (),
			            ABS ( _Target ) >= 1000000, _Eur & FORMAT ( _Target / 1000000, "0.00" ) & "M",
			            ABS ( _Target ) >= 1000, _Eur & FORMAT ( _Target / 1000, "0" ) & "K",
			            _Eur & FORMAT ( _Target, "0" )
			        )
			    )
			VAR _NoteTxt = IF ( ISBLANK ( _Note ) || _Note = "", "", " (" & _Note & ")" )
			VAR _Caption =
			    IF (
			        ISBLANK ( _Ach ),
			        "no target set",
			        FORMAT ( _Ach * 100, "0" ) & "% of " & _FmtT & " target" & _NoteTxt
			    )
			VAR _YTxt = COALESCE ( _YoYRaw, "no prior year" )
			VAR _YCol = COALESCE ( _YoYColRaw, "#605E5C" )
			
			// ===== 7. XML ESCAPING - ampersand first, or the entities get double-escaped =====
			VAR _KPIx =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _KPI, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
			VAR _ValX =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _FmtA, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
			VAR _CapX =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _Caption, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
			VAR _Yx =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _YTxt, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" )
			
			// ===== 8. RAW SVG MARKUP - no data URI, no URL encoding =====
			VAR _F = "font-family='Segoe UI, Arial, sans-serif'"
			RETURN
			    IF (
			        ISBLANK ( _KPI ) || ISBLANK ( _Actual ),
			        BLANK (),
			        "<svg xmlns='http://www.w3.org/2000/svg' width='100%' height='100%' viewBox='0 0 300 120' preserveAspectRatio='xMidYMid meet' style='display:block'>"
			            & "<rect x='1' y='1' width='668' height='218' rx='12' fill='#FFFFFF' stroke='#E5E7EB' stroke-width='1'/>"
			            & "<rect x='1' y='1' width='4' height='218' rx='2' fill='#391587'/>"
			            & "<text x='24' y='48' " & _F & " font-size='22' font-weight='600' fill='#6B7280'>" & _KPIx & "</text>"
			            & "<text x='24' y='116' " & _F & " font-size='48' font-weight='700' fill='#111827'>" & _ValX & "</text>"
			            & "<rect x='" & FORMAT ( _PillX, "0" ) & "' y='26' width='" & FORMAT ( _PillW, "0" ) & "' height='28' rx='14' fill='" & _StatusCol & "'/>"
			            & "<text x='" & FORMAT ( _PillX + _PillW / 2, "0" ) & "' y='45' text-anchor='middle' " & _F & " font-size='13' font-weight='700' fill='#FFFFFF'>" & _Status & "</text>"
			            & "<rect x='" & FORMAT ( _BarX, "0" ) & "' y='152' width='" & FORMAT ( _BarW, "0" ) & "' height='12' rx='6' fill='#EEF0F4'/>"
			            & "<rect x='" & FORMAT ( _BarX, "0" ) & "' y='152' width='" & FORMAT ( _FillW, "0" ) & "' height='12' rx='6' fill='#391587'/>"
			            & "<line x1='" & FORMAT ( _MarkX, "0" ) & "' y1='145' x2='" & FORMAT ( _MarkX, "0" ) & "' y2='171' stroke='#111827' stroke-width='2'/>"
			            & "<text x='24' y='198' " & _F & " font-size='14' fill='#6B7280'>" & _CapX & "</text>"
			            & "<text x='" & FORMAT ( _RightEdge, "0" ) & "' y='198' text-anchor='end' " & _F & " font-size='14' font-weight='600' fill='" & _YCol & "'>" & _Yx & "</text>"
			            & "</svg>"
			    )
		displayFolder: 13 HTML Cards
		lineageTag: 2977a508-d49a-42fb-8851-83035ec0c7c4

	/// Target for Cash Conversion Rate: 75%. A deliberate constant, not a derived figure. 100% is structurally unreachable in this model - operating cash flow starts from net income, so the identity reduces to EBITDA less tax less working capital movement, and even with zero working capital drag the ceiling is one minus tax over EBITDA, which ran 76.7%, 77.5% and 80.8% across 2023-2025. 75% sits just under that ceiling and permits a working capital drag of roughly 6% of EBITDA: demanding but achievable. A 100% target would produce a permanently red KPI and train the reader to ignore it. See the Decisions Log entry on target values for the three cockpit KPIs.
	measure 'Cash Conversion Rate Target' = 0.75
		formatString: 0.0%
		displayFolder: 12 Targets
		lineageTag: e79f0936-ea05-41d8-bfff-fe945a6e225a

	/// Display label for the operating result trend, e.g. "▼ -33,5% vs. PY". Same pattern as Revenue vs PY: reads Actual YoY % rather than recomputing the growth, so the number keeps a single definition. Built for the Actual vs Budget KPI card, which had no label measure of its own. Measures the operating result, not revenue - use Revenue vs PY for that. Blank for 2023, which has no prior year. Colour it with Actual YoY % Colour.
	measure 'Actual vs PY' =
			VAR _Pct = [Actual YoY %]
			VAR _Arrow =
			    SWITCH ( TRUE (), _Pct > 0, "▲", _Pct < 0, "▼", "▬" )
			RETURN
			    IF (
			        ISBLANK ( _Pct ),
			        BLANK (),
			        _Arrow & " " & FORMAT ( _Pct, "+0.0%;-0.0%" ) & " vs. PY"
			    )
		displayFolder: 05 Time Comparison
		lineageTag: de0af391-3efa-4f3e-928c-c77f1db8cbf5

	/// Cash Conversion Rate KPI card, RAW SVG MARKUP for the HTML Content custom visual. Byte-identical to SVG KPI Card from block 4 onward - same layout, geometry, thresholds, status colours, red-when-BEHIND bar rule, escaping and markup - so the two cards render as one design. Only blocks 2 and 3 differ: KPI, direction and unit are hardcoded instead of read from KPI_Cards, and the four bindings point at Cash Conversion Rate. _Unit is PCT, which is what renders the value as 56,9% instead of a euro amount. The ISBLANK(_KPI) test in block 11 is kept only so block 11 stays identical to SVG KPI Card; with _KPI a constant it can never fire. KNOWN DEFECT CARRIED OVER ON PURPOSE: width='600' against viewBox='0 0 630 122' squeezes the 630-unit coordinate space into 600px, about 4.8% horizontally, and the 600-wide background rect leaves a 30-unit strip on the right where the page shows through. Copied so all three cards match; fix it in all three at once by setting width and the background rect to 630, or the viewBox to 600. Blank for 2023, inherited from Cash Conversion Rate, which needs a prior-year working capital balance. THE ENCODING RULE: every interpolated number goes through FORMAT(x,"0") because the de-DE culture would otherwise emit a decimal comma into an SVG attribute. Leave the data category UNCATEGORISED.
	measure 'SVG KPI Card CCR HTML' =
			
			
			// ===== 1. THRESHOLDS =====
			VAR _OnTrackAt = 1.00
			VAR _AtRiskAt = 0.90
			
			// ===== 2. WHICH CARD AM I DRAWING =====
			VAR _KPI = "Cash Conversion Rate"
			
			VAR _Higher = TRUE
			
			VAR _Unit = "PCT"
			
			// ===== 3. KPI REGISTRY — CASH CONVERSION RATE ONLY =====
			VAR _Actual = [Cash Conversion Rate]
			
			VAR _Target = [Cash Conversion Rate Target]
			
			VAR _YoYRaw = [Cash Conversion Rate vs PY]
			
			VAR _YoYColRaw = [Cash Conversion Rate YoY Colour]
			
			// ===== 4. STATUS =====
			VAR _Ach =
			    IF (
			        _Higher,
			        DIVIDE ( _Actual, _Target ),
			        DIVIDE ( _Target, _Actual )
			    )
			
			VAR _Status =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Ach ), "NO TARGET",
			        _Ach >= _OnTrackAt, "ON TRACK",
			        _Ach >= _AtRiskAt, "AT RISK",
			        "BEHIND"
			    )
			
			VAR _StatusCol =
			    SWITCH (
			        _Status,
			        "ON TRACK", "#107C41",
			        "AT RISK", "#C77700",
			        "BEHIND", "#C50F1F",
			        "#605E5C"
			    )
			
			// ===== 5. PROGRESS BAR COLOR =====
			VAR _BarCol =
			    IF (
			        _Status = "BEHIND",
			        "#C50F1F",
			        "#391587"
			    )
			
			// ===== 6. GEOMETRY — 630 × 122 =====
			
			VAR _BarX = 24
			VAR _BarW = 550
			
			VAR _RightEdge =
			    _BarX + _BarW
			
			VAR _MarkX =
			    _RightEdge
			
			// One right edge for everything. Was 630 - 30 = 600, which pushed the
			// status pill 26px past the bar, marker and YoY text at 574.
			VAR _CardRight =
			    _RightEdge
			
			VAR _PillW =
			    24 + LEN ( _Status ) * 7
			
			VAR _PillX =
			    _CardRight - _PillW
			
			VAR _FillW =
			    MAX (
			        0,
			        MIN (
			            _BarW,
			            _BarW * COALESCE ( _Ach, 0 )
			        )
			    )
			
			// ===== 7. NUMBER FORMATTING =====
			VAR _Eur =
			    UNICHAR ( 8364 )
			
			VAR _FmtA =
			    SWITCH (
			        _Unit,
			
			        "PCT",
			            FORMAT ( _Actual * 100, "0.0" ) & "%",
			
			        "DAYS",
			            FORMAT ( _Actual, "0" ) & " days",
			
			        SWITCH (
			            TRUE (),
			
			            ABS ( _Actual ) >= 1000000,
			                _Eur
			                    & FORMAT (
			                        _Actual / 1000000,
			                        "0.00"
			                    )
			                    & "M",
			
			            ABS ( _Actual ) >= 1000,
			                _Eur
			                    & FORMAT (
			                        _Actual / 1000,
			                        "0"
			                    )
			                    & "K",
			
			            _Eur
			                & FORMAT (
			                    _Actual,
			                    "0"
			                )
			        )
			    )
			
			// ===== 8. YOY =====
			VAR _YTxt =
			    COALESCE (
			        _YoYRaw,
			        "no prior year"
			    )
			
			VAR _YCol =
			    COALESCE (
			        _YoYColRaw,
			        "#605E5C"
			    )
			
			// ===== 9. XML ESCAPING =====
			VAR _ValX =
			    SUBSTITUTE (
			        SUBSTITUTE (
			            SUBSTITUTE (
			                _FmtA,
			                "&",
			                "&amp;"
			            ),
			            "<",
			            "&lt;"
			        ),
			        ">",
			        "&gt;"
			    )
			
			VAR _Yx =
			    SUBSTITUTE (
			        SUBSTITUTE (
			            SUBSTITUTE (
			                _YTxt,
			                "&",
			                "&amp;"
			            ),
			            "<",
			            "&lt;"
			        ),
			        ">",
			        "&gt;"
			    )
			
			// ===== 10. FONT =====
			VAR _BodyF =
			    "font-family='Segoe UI, Arial, sans-serif'"
			
			// ===== 11. RAW SVG — 630 × 122 =====
			RETURN
			
			    IF (
			        ISBLANK ( _KPI )
			            || ISBLANK ( _Actual ),
			
			        BLANK (),
			
			        "<svg "
			            & "xmlns='http://www.w3.org/2000/svg' "
			            & "width='600' "
			            & "height='122' "
			            & "viewBox='0 0 630 122'>"
			
			            // Card background
			            & "<rect "
			            & "x='0' "
			            & "y='0' "
			            & "width='600' "
			            & "height='122' "
			            & "rx='10' "
			            & "fill='#FFFFFF'/>"
			
			            // Main value
			            & "<text "
			            & "x='24' "
			            & "y='45' "
			            & _BodyF
			            & " font-size='30' "
			            & "font-weight='700' "
			            & "fill='#111827'>"
			            & _ValX
			            & "</text>"
			
			            // Status pill — top right
			& "<rect "
			& "x='"
			& FORMAT ( _PillX, "0" )
			& "' "
			& "y='10' "
			& "width='"
			& FORMAT ( _PillW, "0" )
			& "' "
			& "height='22' "
			& "rx='11' "
			& "fill='"
			& _StatusCol
			& "'/>"
			
			// Status text
			& "<text "
			& "x='"
			& FORMAT (
			    _PillX + _PillW / 2,
			    "0"
			)
			& "' "
			& "y='25' "
			& "text-anchor='middle' "
			& _BodyF
			& " font-size='11' "
			& "font-weight='700' "
			& "fill='#FFFFFF'>"
			& _Status
			& "</text>"
			
			            // YoY — above progress bar
			            & "<text "
			            & "x='"
			            & FORMAT (
			                _RightEdge,
			                "0"
			            )
			            & "' "
			            & "y='57' "
			            & "text-anchor='end' "
			            & _BodyF
			            & " font-size='12' "
			            & "font-weight='600' "
			            & "fill='"
			            & _YCol
			            & "'>"
			            & _Yx
			            & "</text>"
			
			            // Bar background
			            & "<rect "
			            & "x='"
			            & FORMAT ( _BarX, "0" )
			            & "' "
			            & "y='70' "
			            & "width='"
			            & FORMAT ( _BarW, "0" )
			            & "' "
			            & "height='8' "
			            & "rx='4' "
			            & "fill='#EEF0F4'/>"
			
			            // Actual progress
			            & "<rect "
			            & "x='"
			            & FORMAT ( _BarX, "0" )
			            & "' "
			            & "y='70' "
			            & "width='"
			            & FORMAT ( _FillW, "0" )
			            & "' "
			            & "height='8' "
			            & "rx='4' "
			            & "fill='"
			            & _BarCol
			            & "'/>"
			
			            // Target marker
			            & "<line "
			            & "x1='"
			            & FORMAT ( _MarkX, "0" )
			            & "' "
			            & "y1='65' "
			            & "x2='"
			            & FORMAT ( _MarkX, "0" )
			            & "' "
			            & "y2='83' "
			            & "stroke='#111827' "
			            & "stroke-width='2'/>"
			
			            & "</svg>"
			    )
		displayFolder: 13 HTML Cards
		lineageTag: a274bc71-aebd-4ff3-8f09-edde5d0a0d5e

	/// Actual vs Budget KPI card, RAW SVG MARKUP for the HTML Content custom visual. Byte-identical to SVG KPI Card from block 4 onward - same layout, geometry, thresholds, status colours, red-when-BEHIND bar rule, escaping and markup - so all three cards render as one design. Only blocks 2 and 3 differ: KPI, direction and unit are hardcoded instead of read from KPI_Cards, and the bindings point at the operating result against Budget, which gives a real plan-attainment percentage. It deliberately does NOT use the Variance measure or the zero-target-plus-bands treatment from the Decisions Log, because a variance targets zero and a progress bar needs a denominator. The ISBLANK(_KPI) test in block 11 is kept only so block 11 stays identical to SVG KPI Card; with _KPI a constant it can never fire. KNOWN DEFECT CARRIED OVER ON PURPOSE: width='600' against viewBox='0 0 630 122' squeezes the 630-unit coordinate space into 600px, about 4.8% horizontally, and the 600-wide background rect leaves a 30-unit strip on the right where the page shows through. Copied so all three cards match; fix it in all three at once by setting width and the background rect to 630, or the viewBox to 600. Higher is better works for revenue and cost without branching, because the model stores revenue positive and expense negative. Year-over-year comes from Actual vs PY, the operating result, not Revenue vs PY. THE ENCODING RULE: every interpolated number goes through FORMAT(x,"0") because the de-DE culture would otherwise emit a decimal comma into an SVG attribute. Leave the data category UNCATEGORISED.
	measure 'SVG KPI Card AvB HTML' =
			
			
			// ===== 1. THRESHOLDS =====
			VAR _OnTrackAt = 1.00
			VAR _AtRiskAt = 0.90
			
			// ===== 2. WHICH CARD AM I DRAWING =====
			VAR _KPI = "Actual vs Budget"
			
			VAR _Higher = TRUE
			
			VAR _Unit = "EUR"
			
			// ===== 3. KPI REGISTRY — ACTUAL VS BUDGET ONLY =====
			VAR _Actual = [Actual]
			
			VAR _Target = [Budget]
			
			VAR _YoYRaw = [Actual vs PY]
			
			VAR _YoYColRaw = [Actual YoY % Colour]
			
			// ===== 4. STATUS =====
			VAR _Ach =
			    IF (
			        _Higher,
			        DIVIDE ( _Actual, _Target ),
			        DIVIDE ( _Target, _Actual )
			    )
			
			VAR _Status =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Ach ), "NO TARGET",
			        _Ach >= _OnTrackAt, "ON TRACK",
			        _Ach >= _AtRiskAt, "AT RISK",
			        "BEHIND"
			    )
			
			VAR _StatusCol =
			    SWITCH (
			        _Status,
			        "ON TRACK", "#107C41",
			        "AT RISK", "#C77700",
			        "BEHIND", "#C50F1F",
			        "#605E5C"
			    )
			
			// ===== 5. PROGRESS BAR COLOR =====
			VAR _BarCol =
			    IF (
			        _Status = "BEHIND",
			        "#C50F1F",
			        "#391587"
			    )
			
			// ===== 6. GEOMETRY — 630 × 122 =====
			
			VAR _BarX = 24
			VAR _BarW = 550
			
			VAR _RightEdge =
			    _BarX + _BarW
			
			VAR _MarkX =
			    _RightEdge
			
			// One right edge for everything. Was 630 - 30 = 600, which pushed the
			// status pill 26px past the bar, marker and YoY text at 574.
			VAR _CardRight =
			    _RightEdge
			
			VAR _PillW =
			    24 + LEN ( _Status ) * 7
			
			VAR _PillX =
			    _CardRight - _PillW
			
			VAR _FillW =
			    MAX (
			        0,
			        MIN (
			            _BarW,
			            _BarW * COALESCE ( _Ach, 0 )
			        )
			    )
			
			// ===== 7. NUMBER FORMATTING =====
			VAR _Eur =
			    UNICHAR ( 8364 )
			
			VAR _FmtA =
			    SWITCH (
			        _Unit,
			
			        "PCT",
			            FORMAT ( _Actual * 100, "0.0" ) & "%",
			
			        "DAYS",
			            FORMAT ( _Actual, "0" ) & " days",
			
			        SWITCH (
			            TRUE (),
			
			            ABS ( _Actual ) >= 1000000,
			                _Eur
			                    & FORMAT (
			                        _Actual / 1000000,
			                        "0.00"
			                    )
			                    & "M",
			
			            ABS ( _Actual ) >= 1000,
			                _Eur
			                    & FORMAT (
			                        _Actual / 1000,
			                        "0"
			                    )
			                    & "K",
			
			            _Eur
			                & FORMAT (
			                    _Actual,
			                    "0"
			                )
			        )
			    )
			
			// ===== 8. YOY =====
			VAR _YTxt =
			    COALESCE (
			        _YoYRaw,
			        "no prior year"
			    )
			
			VAR _YCol =
			    COALESCE (
			        _YoYColRaw,
			        "#605E5C"
			    )
			
			// ===== 9. XML ESCAPING =====
			VAR _ValX =
			    SUBSTITUTE (
			        SUBSTITUTE (
			            SUBSTITUTE (
			                _FmtA,
			                "&",
			                "&amp;"
			            ),
			            "<",
			            "&lt;"
			        ),
			        ">",
			        "&gt;"
			    )
			
			VAR _Yx =
			    SUBSTITUTE (
			        SUBSTITUTE (
			            SUBSTITUTE (
			                _YTxt,
			                "&",
			                "&amp;"
			            ),
			            "<",
			            "&lt;"
			        ),
			        ">",
			        "&gt;"
			    )
			
			// ===== 10. FONT =====
			VAR _BodyF =
			    "font-family='Segoe UI, Arial, sans-serif'"
			
			// ===== 11. RAW SVG — 630 × 122 =====
			RETURN
			
			    IF (
			        ISBLANK ( _KPI )
			            || ISBLANK ( _Actual ),
			
			        BLANK (),
			
			        "<svg "
			            & "xmlns='http://www.w3.org/2000/svg' "
			            & "width='600' "
			            & "height='122' "
			            & "viewBox='0 0 630 122'>"
			
			            // Card background
			            & "<rect "
			            & "x='0' "
			            & "y='0' "
			            & "width='600' "
			            & "height='122' "
			            & "rx='10' "
			            & "fill='#FFFFFF'/>"
			
			            // Main value
			            & "<text "
			            & "x='24' "
			            & "y='45' "
			            & _BodyF
			            & " font-size='30' "
			            & "font-weight='700' "
			            & "fill='#111827'>"
			            & _ValX
			            & "</text>"
			
			            // Status pill — top right
			& "<rect "
			& "x='"
			& FORMAT ( _PillX, "0" )
			& "' "
			& "y='10' "
			& "width='"
			& FORMAT ( _PillW, "0" )
			& "' "
			& "height='22' "
			& "rx='11' "
			& "fill='"
			& _StatusCol
			& "'/>"
			
			// Status text
			& "<text "
			& "x='"
			& FORMAT (
			    _PillX + _PillW / 2,
			    "0"
			)
			& "' "
			& "y='25' "
			& "text-anchor='middle' "
			& _BodyF
			& " font-size='11' "
			& "font-weight='700' "
			& "fill='#FFFFFF'>"
			& _Status
			& "</text>"
			
			            // YoY — above progress bar
			            & "<text "
			            & "x='"
			            & FORMAT (
			                _RightEdge,
			                "0"
			            )
			            & "' "
			            & "y='57' "
			            & "text-anchor='end' "
			            & _BodyF
			            & " font-size='12' "
			            & "font-weight='600' "
			            & "fill='"
			            & _YCol
			            & "'>"
			            & _Yx
			            & "</text>"
			
			            // Bar background
			            & "<rect "
			            & "x='"
			            & FORMAT ( _BarX, "0" )
			            & "' "
			            & "y='70' "
			            & "width='"
			            & FORMAT ( _BarW, "0" )
			            & "' "
			            & "height='8' "
			            & "rx='4' "
			            & "fill='#EEF0F4'/>"
			
			            // Actual progress
			            & "<rect "
			            & "x='"
			            & FORMAT ( _BarX, "0" )
			            & "' "
			            & "y='70' "
			            & "width='"
			            & FORMAT ( _FillW, "0" )
			            & "' "
			            & "height='8' "
			            & "rx='4' "
			            & "fill='"
			            & _BarCol
			            & "'/>"
			
			            // Target marker
			            & "<line "
			            & "x1='"
			            & FORMAT ( _MarkX, "0" )
			            & "' "
			            & "y1='65' "
			            & "x2='"
			            & FORMAT ( _MarkX, "0" )
			            & "' "
			            & "y2='83' "
			            & "stroke='#111827' "
			            & "stroke-width='2'/>"
			
			            & "</svg>"
			    )
		displayFolder: 13 HTML Cards
		lineageTag: 25c426ad-a800-477a-a692-3f1a2de30a48

	/// Month-over-month change of the KPI picked in the KPI_Selector slicer (Revenue, EBITDA or Net Income), for the trend chart's tooltip or data labels. Reads Selected Actual, so it follows the selector without its own SWITCH. DATEADD shifts the current month back one month, so January compares to the prior December even under a year slicer - this relies on dim_date being marked as the date table. Blank where either month is blank: January 2023 has no prior month, and nothing is returned when no KPI is selected. ABS in the denominator so a decline always reads negative, even from a negative EBITDA or Net Income month, matching Variance % and the YoY % measures. Do not plot it as a line on the trend chart: the secondary axis is in euros, so a percentage would sit flat at zero.
	measure 'Selected Actual MoM %' =
			VAR _Cur = [Selected Actual]
			VAR _Prev =
			    CALCULATE ( [Selected Actual], DATEADD ( dim_date[date], -1, MONTH ) )
			RETURN
			    IF (
			        NOT ISBLANK ( _Cur ) && NOT ISBLANK ( _Prev ),
			        DIVIDE ( _Cur - _Prev, ABS ( _Prev ) )
			    )
		formatString: +0.0%;-0.0%
		displayFolder: 10 Selector
		lineageTag: fd1c8a7b-fc63-40f3-91c5-97c2b00dbb42

	/// Conditional formatting colour for Selected Actual MoM %, used on the trend chart's month-over-month data labels. Green when the selected KPI rose against the prior month, red when it fell, grey at exactly zero, blank where there is no prior month (January 2023) or no KPI selected, so those labels stay uncoloured rather than painted red. No direction branching is needed: all three KPI_Selector options - Revenue, EBITDA, Net Income - are higher-is-better. If a lower-is-better KPI is ever added to the selector, this measure must invert for it. Same colours as Revenue YoY % Colour. Apply via Format pane > Data labels > Values > Colour > fx > Format style: Field value.
	measure 'Selected Actual MoM % Colour' =
			VAR _Value = [Selected Actual MoM %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), BLANK (),
			        _Value > 0, "#107C41",
			        _Value < 0, "#C50F1F",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: cf55dc02-1e8e-4e99-a07e-1aeef8cd4cc4

	/// Row value for the P&L cascade matrix plus the indirect cash flow below it, driven by the disconnected PnL_Layout table. COGS DEFINITION (agreed 2026-09-14): COGS = direct production costs excluding depreciation. The COGS line reads the COGS measure in 03 P&L and negates it for the cascade sign convention, so the definition lives in exactly one place - change it there, never here. Gross Profit here matches the Gross Profit measure in 03 P&L. Operating Expenses = every other non-depreciation expense, i.e. all cost centers except Production. DRILL-DOWN: put PnL_Layout[Line] on rows and dim_account[pnl_group] (or account_name) beneath it. pnl_group groups Rent, Travel, Insurance and Other Operating Expenses into one Other Operating Expenses row. _AtAccount is true under either column, so subtotal lines, Taxes & Interest and every cash line return blank at that level and do not expand. Turn the grand total off: it returns blank on purpose, because summing a cascade double-counts every subtotal. P&L SECTION - sign convention kept, revenue positive, costs negative, so every subtotal is a plain sum. Taxes & Interest = -Tax; interest is zero because no debt is modelled. CASH FLOW SECTION - signed as cash impact, positive = cash in. Inventory is NOT subtracted from COGS: the balance is derived from material consumption, so account 5000 already records material used and adjusting COGS would count the stock build twice. It connects here instead, as cash tied up. Each Change line differences the closing balance of the period against the last balance before the period began, the same method as Delta NWC, so it is correct at month, quarter, year and multi-year grain, and quarters sum to the year. An increase in inventory or receivables is negative (cash absorbed); an increase in payables is positive. Operating Cash Flow = Net Income + D&A + the three changes, reconciling to the Operating Cash Flow measure; Free Cash Flow = Operating Cash Flow - Capex, reconciling to Free Cash Flow. Change lines, Operating Cash Flow and Free Cash Flow are blank wherever no opening balance exists, so 2023 is blank rather than treating the opening position as zero. KEEPFILTERS keeps account and cost-center slicers working on the P&L detail lines. COMPANY LEVEL ONLY below EBIT: fact_tax, fact_working_capital and fact_capex carry no company, cost center, product or customer key. Working capital and capex are SYNTHETIC - read trends, not absolute levels.
	measure 'P&L Actual' =
			VAR _Line = SELECTEDVALUE ( PnL_Layout[Line] )
			-- Account level = the matrix is drilled into accounts, either by account_name or by the pnl_group drill-down label
			VAR _AtAccount =
			    ISINSCOPE ( dim_account[account_name] )
			        || ISINSCOPE ( dim_account[pnl_group] )
			VAR _PeriodStart = MIN ( dim_date[date] )
			-- P&L
			VAR _Revenue =
			    CALCULATE ( [Actual], KEEPFILTERS ( dim_account[account_type] = "Revenue" ) )
			-- COGS = direct production costs excluding depreciation. Defined once in [COGS], which returns positive; negated here for the cascade sign convention
			VAR _COGS = - [COGS]
			VAR _OpEx =
			    CALCULATE (
			        [Actual],
			        KEEPFILTERS ( dim_account[account_type] = "Expense" ),
			        KEEPFILTERS ( dim_account[account_category] <> "Depreciation" ),
			        KEEPFILTERS ( dim_cost_center[cost_center_name] <> "Production" )
			    )
			VAR _DA =
			    CALCULATE ( [Actual], KEEPFILTERS ( dim_account[account_category] = "Depreciation" ) )
			VAR _TaxInterest = - [Tax]
			VAR _EBITDA = _Revenue + _COGS + _OpEx
			VAR _EBIT = _EBITDA + _DA
			VAR _NetIncome = _EBIT + _TaxInterest
			-- Cash flow: working capital movements, signed as cash impact
			VAR _InventoryOpening =
			    CALCULATE ( [Inventory], REMOVEFILTERS ( dim_date ), dim_date[date] < _PeriodStart )
			VAR _ReceivablesOpening =
			    CALCULATE ( [Accounts Receivable], REMOVEFILTERS ( dim_date ), dim_date[date] < _PeriodStart )
			VAR _PayablesOpening =
			    CALCULATE ( [Accounts Payable], REMOVEFILTERS ( dim_date ), dim_date[date] < _PeriodStart )
			VAR _ChangeInventory =
			    IF ( NOT ISBLANK ( _InventoryOpening ), - ( [Inventory] - _InventoryOpening ) )
			VAR _ChangeReceivables =
			    IF ( NOT ISBLANK ( _ReceivablesOpening ), - ( [Accounts Receivable] - _ReceivablesOpening ) )
			VAR _ChangePayables =
			    IF ( NOT ISBLANK ( _PayablesOpening ), [Accounts Payable] - _PayablesOpening )
			VAR _OperatingCashFlow =
			    IF (
			        NOT ISBLANK ( _ChangeInventory )
			            && NOT ISBLANK ( _ChangeReceivables )
			            && NOT ISBLANK ( _ChangePayables ),
			        _NetIncome - _DA + _ChangeInventory + _ChangeReceivables + _ChangePayables
			    )
			VAR _Capex = - [Capex]
			VAR _FreeCashFlow =
			    IF ( NOT ISBLANK ( _OperatingCashFlow ), _OperatingCashFlow + _Capex )
			RETURN
			    SWITCH (
			        _Line,
			        "Revenue", _Revenue,
			        "COGS", _COGS,
			        "Gross Profit", IF ( NOT _AtAccount, _Revenue + _COGS ),
			        "Operating Expenses", _OpEx,
			        "EBITDA", IF ( NOT _AtAccount, _EBITDA ),
			        "Depreciation & Amortisation", _DA,
			        "EBIT", IF ( NOT _AtAccount, _EBIT ),
			        "Taxes & Interest", IF ( NOT _AtAccount, _TaxInterest ),
			        "Net Income", IF ( NOT _AtAccount, _NetIncome ),
			        "Add back: Depreciation & Amortisation", IF ( NOT _AtAccount, - _DA ),
			        "Change in Inventory", IF ( NOT _AtAccount, _ChangeInventory ),
			        "Change in Receivables", IF ( NOT _AtAccount, _ChangeReceivables ),
			        "Change in Payables", IF ( NOT _AtAccount, _ChangePayables ),
			        "Operating Cash Flow", IF ( NOT _AtAccount, _OperatingCashFlow ),
			        "Capex", IF ( NOT _AtAccount, _Capex ),
			        "Free Cash Flow", IF ( NOT _AtAccount, _FreeCashFlow )
			    )
		formatString: #,##0
		displayFolder: 15 P&L Matrix
		lineageTag: 98272054-5ac1-4818-ba8e-6f2979cae27c

	/// P&L Actual for Q1 (Jan-Mar) of the year in context. KEEPFILTERS intersects with a quarter slicer rather than overriding it. Without a year filter it sums Q1 across every year - put a year slicer on the page.
	measure 'P&L Actual Q1' = CALCULATE ( [P&L Actual], KEEPFILTERS ( dim_date[quarter] = "Q1" ) )
		formatString: #,##0
		displayFolder: 15 P&L Matrix
		lineageTag: c995ee1d-4ab2-43cf-ab3a-783db5f59718

	/// P&L Actual for Q2 (Apr-Jun). Same caveats as P&L Actual Q1.
	measure 'P&L Actual Q2' = CALCULATE ( [P&L Actual], KEEPFILTERS ( dim_date[quarter] = "Q2" ) )
		formatString: #,##0
		displayFolder: 15 P&L Matrix
		lineageTag: deb0c242-bc5c-48c4-a51f-8969c8756cce

	/// P&L Actual for Q3 (Jul-Sep). Same caveats as P&L Actual Q1.
	measure 'P&L Actual Q3' = CALCULATE ( [P&L Actual], KEEPFILTERS ( dim_date[quarter] = "Q3" ) )
		formatString: #,##0
		displayFolder: 15 P&L Matrix
		lineageTag: 7b2b8ac0-aa18-4116-a269-317581a848b7

	/// P&L Actual for Q4 (Oct-Dec). Same caveats as P&L Actual Q1.
	measure 'P&L Actual Q4' = CALCULATE ( [P&L Actual], KEEPFILTERS ( dim_date[quarter] = "Q4" ) )
		formatString: #,##0
		displayFolder: 15 P&L Matrix
		lineageTag: 6173a49b-246c-4150-8177-1b830245e4e1

	/// Prior-year P&L Actual for each cascade line. Blank for 2023, which has no prior year. Requires dim_date marked as a date table. Use with a single-year filter: across several years it compares against a shifted multi-year window, which is what made the old matrix show +54% revenue growth.
	measure 'P&L Actual PY' = CALCULATE ( [P&L Actual], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: #,##0
		displayFolder: 15 P&L Matrix
		lineageTag: a6f5b49a-0a2e-4a84-bf9d-587d48c49e8c

	/// Year-over-year change of each cascade line as %. ABS in the denominator so negative always means unfavourable - a cost line that grows reads negative, matching Actual YoY % and Variance %. Blank where either year is missing, so 2023 does not read as growth from zero.
	measure 'P&L Actual YoY %' =
			VAR _Actual = [P&L Actual]
			VAR _PY = [P&L Actual PY]
			RETURN
			    IF (
			        NOT ISBLANK ( _Actual ) && NOT ISBLANK ( _PY ),
			        DIVIDE ( _Actual - _PY, ABS ( _PY ) )
			    )
		formatString: 0.0%;-0.0%
		displayFolder: 15 P&L Matrix
		lineageTag: ac94cc68-77a5-4838-864a-acf75c40ea50

	/// Cost of goods sold, returned positive for display like Total Cost and Depreciation. AGREED DEFINITION (2026-09-14): COGS = direct production costs excluding depreciation - every expense booked to the Production cost center except account 6100 Depreciation, i.e. raw materials plus Production's personnel, energy, external services and other operating expenses. The cost center decides, not the account: a Production salary is COGS, a Sales salary is an operating expense. Depreciation stays out so Gross Profit less Operating Expenses lands exactly on EBITDA. Single source of the definition: the COGS line in P&L Actual reads this measure. 2025: 10,587,605. DIFFERS from the older Gross Profit measure in this folder, which still keeps Production depreciation inside cost (463,303 in 2025). No inventory adjustment: account 5000 already records material consumed, so the stock build belongs in the cash flow, not here. KEEPFILTERS respects account and cost-center slicers, so filtered to any cost center other than Production it returns blank. Blank rather than zero where no Production cost exists.
	measure COGS =
			- CALCULATE (
			    [Actual],
			    KEEPFILTERS ( dim_account[account_type] = "Expense" ),
			    KEEPFILTERS ( dim_account[account_category] <> "Depreciation" ),
			    KEEPFILTERS ( dim_cost_center[cost_center_name] = "Production" )
			)
		formatString: #,##0
		displayFolder: 03 P&L
		lineageTag: b1e41444-3793-4fa0-8184-f6b78e43e6af

	measure 'P&L Actual YoY % Icon' =
			
			IF (
			    SELECTEDVALUE ( PnL_Layout[Line] ) = "Taxes & Interest",
			    BLANK (),
			    [P&L Actual YoY %]
			)
		displayFolder: 15 P&L Matrix
		lineageTag: 7bfa4139-ad38-4c98-9d67-4466bb1c4050

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Prior-year total cost: every expense account (COGS, operating expenses and depreciation), returned positive like Total Cost. Same pattern as Revenue PY, EBITDA PY and Net Income PY. Blank for 2023, which has no prior year in the dataset. Use with a single year selected - across several years SAMEPERIODLASTYEAR compares against a shifted multi-year window. Responds to account and cost-center slicers exactly as Total Cost does. Because the value is positive, a rising cost reads as a positive difference, which is unfavourable - the opposite direction to the P&L sign convention, so any YoY % built on it needs its own colour rule. Requires dim_date marked as a date table.
	measure 'Total Cost PY' = CALCULATE ( [Total Cost], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: #,##0
		displayFolder: 05 Time Comparison
		lineageTag: 2ae140b4-3be0-4afb-858a-7a66f3b90a56

	/// Row-level background colour for the Income Statement and Cash Flow matrices on page 2. Apply via Format > Cell elements > Background color > fx > Format style: Field value, once per value column, with Apply to: Values and totals. Reads PnL_Layout[Line Type]: Net Income gets the strongest tint #C9BCEF (same as the Total row on the Variance page), Free Cash Flow the stronger tint #D9D2EE, the other subtotal lines (Gross Profit, EBITDA, EBIT, Operating Cash Flow) the light tint #EFECF8, detail lines stay uncoloured. Blank under the pnl_group or account_name drill-down so expanded account rows are not tinted. Colours are purple tints matching the page header. Returns a hex string; blank means no colour.
	measure 'P&L Row Highlight Colour' =
			VAR _Line = SELECTEDVALUE ( PnL_Layout[Line] )
			VAR _Type = SELECTEDVALUE ( PnL_Layout[Line Type] )
			VAR _AtAccount =
			    ISINSCOPE ( dim_account[pnl_group] )
			        || ISINSCOPE ( dim_account[account_name] )
			RETURN
			    SWITCH (
			        TRUE (),
			        _AtAccount, BLANK (),                                   -- drill-down rows: no highlight
			        _Line = "Net Income", "#C9BCEF",                        -- Net Income: strongest tint (matches Variance page Total row)
			        _Line = "Free Cash Flow", "#D9D2EE",                    -- Free Cash Flow: stronger tint
			        _Type = "Subtotal", "#EFECF8",                          -- other subtotals: light tint
			        BLANK ()                                                -- detail lines: no highlight
			    )
		displayFolder: 09 Formatting
		lineageTag: d0b18c52-45e4-40fa-9611-38e245d741f5

	measure 'SVG KPI Card Revenue HTML' =
			
			// ===== 1. CONFIG: the only block you change per KPI =====
			VAR _Title       = "Revenue"
			VAR _Value       = [Revenue]
			VAR _Change      = [Revenue YoY %]          // decimal: 0.045 = +4.5%
			VAR _ValueFormat = "EUR"                    // "EUR" -> €20.16M  |  "PCT" -> 38.4%
			VAR _ChangeUnit  = "PCT"                    // "PCT" -> +4.5%    |  "PP"  -> +1.2 pp
			
			// Sparkline: Q1–Q4 of the selected year(s); ignores month/quarter filters, keeps all others
			VAR _Years = VALUES ( dim_date[year] )
			VAR _Quarters =
			    ADDCOLUMNS (
			        GENERATESERIES ( 1, 4, 1 ),
			        "@Val",
			            VAR _q = [Value]
			            RETURN
			                CALCULATE (
			                    [Revenue],                          // KPI measure again (a VAR would freeze the value)
			                    REMOVEFILTERS ( dim_date ),
			                    _Years,
			                    dim_date[quarter] = "Q" & _q
			                )
			    )
			
			// ===== 2. ENGINE: no changes below =====
			VAR _Navy     = "#0B1F3A"
			VAR _Muted    = "#6B7280"
			VAR _Faint    = "#A0A7B4"
			VAR _Green    = "#1A7F4B"
			VAR _Red      = "#C0392B"
			VAR _Neutral  = "#8A93A3"
			VAR _Bar      = "#7C50DE"
			VAR _BarNeg   = "#F1C6CC"
			VAR _BarEmpty = "#ECEEF3"
			VAR _Eur      = UNICHAR ( 8364 )
			VAR _F        = "font-family='Segoe UI, Helvetica, Arial, sans-serif'"
			
			// Value text (en-US forces €20.16M; remove the "en-US" arguments for de-DE €20,16M)
			VAR _Abs  = ABS ( _Value )
			VAR _Sign = IF ( _Value < 0, "-", "" )
			VAR _ValueText =
			    SWITCH (
			        TRUE (),
			        _ValueFormat = "PCT", FORMAT ( _Value, "0.0%", "en-US" ),
			        _Abs >= 1000000000, _Sign & _Eur & FORMAT ( _Abs / 1000000000, "#,0.00", "en-US" ) & "B",
			        _Abs >= 1000000,    _Sign & _Eur & FORMAT ( _Abs / 1000000, "#,0.00", "en-US" ) & "M",
			        _Abs >= 1000,       _Sign & _Eur & FORMAT ( _Abs / 1000, "#,0.0", "en-US" ) & "K",
			        _Sign & _Eur & FORMAT ( _Abs, "#,0", "en-US" )
			    )
			
			// YoY text + colour, decided on the rounded value
			VAR _HasChange = NOT ISBLANK ( _Change )
			VAR _ChangeNum = ROUND ( _Change * 100, 1 )
			VAR _Color =
			    SWITCH ( TRUE (), NOT _HasChange, _Neutral, _ChangeNum > 0, _Green, _ChangeNum < 0, _Red, _Neutral )
			VAR _ChangeText =
			    IF (
			        _HasChange,
			        FORMAT ( _ChangeNum, "+0.0;-0.0;0.0", "en-US" ) & IF ( _ChangeUnit = "PP", " pp", "%" ),
			        "n/a"
			    )
			VAR _Arrow =
			    SWITCH (
			        TRUE (),
			        _HasChange && _ChangeNum > 0,
			            "<path d='M19 93 L23 87 L27 93 Z' fill='" & _Color & "' stroke='" & _Color & "' stroke-width='1.5' stroke-linejoin='round'/>",
			        _HasChange && _ChangeNum < 0,
			            "<path d='M19 87 L27 87 L23 93 Z' fill='" & _Color & "' stroke='" & _Color & "' stroke-width='1.5' stroke-linejoin='round'/>",
			        "<rect x='18' y='89' width='10' height='2' rx='1' fill='" & _Color & "'/>"
			    )
			
			// Mini-bars scaled to the largest quarter; every number through FORMAT(x,"0") (de-DE comma rule)
			VAR _MaxAbs = MAXX ( _Quarters, ABS ( [@Val] ) )
			VAR _Bars =
			    CONCATENATEX (
			        _Quarters,
			        VAR _v     = [@Val]
			        VAR _x     = 196 + ( [Value] - 1 ) * 24
			        VAR _Empty = ISBLANK ( _v ) || _v = 0 || _MaxAbs = 0
			        VAR _h     = IF ( _Empty, 2, MAX ( 3, ROUND ( DIVIDE ( ABS ( _v ), _MaxAbs ) * 54, 0 ) ) )
			        VAR _Fill  = SWITCH ( TRUE (), _Empty, _BarEmpty, _v < 0, _BarNeg, _Bar )
			        RETURN
			            "<rect x='" & FORMAT ( _x, "0" ) & "' y='" & FORMAT ( 92 - _h, "0" )
			                & "' width='14' height='" & FORMAT ( _h, "0" ) & "' rx='3' fill='" & _Fill & "'/>"
			            & "<text x='" & FORMAT ( _x + 7, "0" ) & "' y='108' " & _F
			                & " font-size='9' text-anchor='middle' fill='" & _Faint & "'>Q" & FORMAT ( [Value], "0" ) & "</text>",
			        "",
			        [Value], ASC
			    )
			
			// Raw SVG, 300 × 120 (width/height match the viewBox)
			RETURN
			    IF (
			        ISBLANK ( _Value ),
			        BLANK (),
			        "<svg xmlns='http://www.w3.org/2000/svg' width='300' height='120' viewBox='0 0 300 120'>"
			            & "<rect x='0.5' y='0.5' width='299' height='119' rx='12' fill='#FFFFFF' stroke='#E7E9EF'/>"
			            & "<text x='18' y='30' " & _F & " font-size='12' font-weight='600' letter-spacing='0.2' fill='" & _Muted & "'>" & _Title & "</text>"
			            & "<text x='18' y='67' " & _F & " font-size='28' font-weight='600' letter-spacing='-0.3' fill='" & _Navy & "'>" & _ValueText & "</text>"
			            & _Arrow
			            & "<text x='33' y='94' " & _F & " font-size='12' font-weight='600' fill='" & _Color & "'>" & _ChangeText
			            & "<tspan dx='6' font-weight='400' fill='" & _Muted & "'>vs. PY</tspan></text>"
			            & _Bars
			            & "</svg>"
			    )
		displayFolder: 13 HTML Cards
		lineageTag: 7bdb6e90-5214-4e3c-bcd2-718f1397cdc6

	/// Gross Profit KPI card, RAW SVG MARKUP for the HTML Content custom visual, 300 x 120. Same engine and style as SVG KPI Card Revenue HTML (value 24px navy, YoY arrow, #7C50DE quarterly bars). Only the CONFIG block differs: YoY % computed inline from SAMEPERIODLASTYEAR because no Gross Profit YoY % measure exists; _ChartType BAR. Company level only, inherited from Gross Profit. Every interpolated number goes through FORMAT(x,"0") (de-DE comma rule). Leave the data category UNCATEGORISED.
	measure 'SVG KPI Card Gross Profit HTML' =
			
			// ===== 1. CONFIG =====
			VAR _Title       = "Gross Profit"
			VAR _Value       = [Gross Profit]
			VAR _Change      =
			    VAR _PY = CALCULATE ( [Gross Profit], SAMEPERIODLASTYEAR ( dim_date[date] ) )
			    RETURN DIVIDE ( _Value - _PY, ABS ( _PY ) )
			VAR _ValueFormat = "EUR"                    // "EUR" | "PCT"
			VAR _ChangeUnit  = "PCT"                    // "PCT" | "PP"
			VAR _ChartType   = "BAR"                    // "BAR" | "LINE"
			VAR _Years = VALUES ( dim_date[year] )
			VAR _Quarters =
			    ADDCOLUMNS (
			        GENERATESERIES ( 1, 4, 1 ),
			        "@Val",
			            VAR _q = [Value]
			            RETURN
			                CALCULATE ( [Gross Profit], REMOVEFILTERS ( dim_date ), _Years, dim_date[quarter] = "Q" & _q )
			    )
			
			// ===== 2. ENGINE: identical in every card =====
			VAR _Navy     = "#0B1F3A"
			VAR _Muted    = "#6B7280"
			VAR _Faint    = "#A0A7B4"
			VAR _Green    = "#1A7F4B"
			VAR _Red      = "#C0392B"
			VAR _Neutral  = "#8A93A3"
			VAR _Bar      = "#7C50DE"
			VAR _BarNeg   = "#F1C6CC"
			VAR _BarEmpty = "#ECEEF3"
			VAR _Eur      = UNICHAR ( 8364 )
			VAR _F        = "font-family='Segoe UI, Helvetica, Arial, sans-serif'"
			
			VAR _Abs  = ABS ( _Value )
			VAR _Sign = IF ( _Value < 0, "-", "" )
			VAR _ValueText =
			    SWITCH (
			        TRUE (),
			        _ValueFormat = "PCT", FORMAT ( _Value, "0.0%", "en-US" ),
			        _Abs >= 1000000000, _Sign & _Eur & FORMAT ( _Abs / 1000000000, "#,0.00", "en-US" ) & "B",
			        _Abs >= 1000000,    _Sign & _Eur & FORMAT ( _Abs / 1000000, "#,0.00", "en-US" ) & "M",
			        _Abs >= 1000,       _Sign & _Eur & FORMAT ( _Abs / 1000, "#,0.0", "en-US" ) & "K",
			        _Sign & _Eur & FORMAT ( _Abs, "#,0", "en-US" )
			    )
			
			VAR _HasChange = NOT ISBLANK ( _Change )
			VAR _ChangeNum = ROUND ( _Change * 100, 1 )
			VAR _Color =
			    SWITCH ( TRUE (), NOT _HasChange, _Neutral, _ChangeNum > 0, _Green, _ChangeNum < 0, _Red, _Neutral )
			VAR _ChangeText =
			    IF (
			        _HasChange,
			        FORMAT ( _ChangeNum, "+0.0;-0.0;0.0", "en-US" ) & IF ( _ChangeUnit = "PP", " pp", "%" ),
			        "n/a"
			    )
			VAR _Arrow =
			    SWITCH (
			        TRUE (),
			        _HasChange && _ChangeNum > 0,
			            "<path d='M19 93 L23 87 L27 93 Z' fill='" & _Color & "' stroke='" & _Color & "' stroke-width='1.5' stroke-linejoin='round'/>",
			        _HasChange && _ChangeNum < 0,
			            "<path d='M19 87 L27 87 L23 93 Z' fill='" & _Color & "' stroke='" & _Color & "' stroke-width='1.5' stroke-linejoin='round'/>",
			        "<rect x='18' y='89' width='10' height='2' rx='1' fill='" & _Color & "'/>"
			    )
			
			// Quarter labels (both chart types)
			VAR _Labels =
			    CONCATENATEX (
			        _Quarters,
			        "<text x='" & FORMAT ( 203 + ( [Value] - 1 ) * 24, "0" ) & "' y='108' " & _F
			            & " font-size='9' text-anchor='middle' fill='" & _Faint & "'>Q" & FORMAT ( [Value], "0" ) & "</text>",
			        "",
			        [Value], ASC
			    )
			
			// BAR: scaled to the largest quarter
			VAR _MaxAbs = MAXX ( _Quarters, ABS ( [@Val] ) )
			VAR _Bars =
			    CONCATENATEX (
			        _Quarters,
			        VAR _v     = [@Val]
			        VAR _x     = 196 + ( [Value] - 1 ) * 24
			        VAR _Empty = ISBLANK ( _v ) || _v = 0 || _MaxAbs = 0
			        VAR _h     = IF ( _Empty, 2, MAX ( 3, ROUND ( DIVIDE ( ABS ( _v ), _MaxAbs ) * 54, 0 ) ) )
			        VAR _Fill  = SWITCH ( TRUE (), _Empty, _BarEmpty, _v < 0, _BarNeg, _Bar )
			        RETURN
			            "<rect x='" & FORMAT ( _x, "0" ) & "' y='" & FORMAT ( 92 - _h, "0" )
			                & "' width='14' height='" & FORMAT ( _h, "0" ) & "' rx='3' fill='" & _Fill & "'/>",
			        "",
			        [Value], ASC
			    )
			
			// LINE: scaled min-to-max; quarters without data are skipped
			VAR _Pts   = FILTER ( _Quarters, NOT ISBLANK ( [@Val] ) )
			VAR _Min   = MINX ( _Pts, [@Val] )
			VAR _Max   = MAXX ( _Pts, [@Val] )
			VAR _PtsXY =
			    ADDCOLUMNS (
			        _Pts,
			        "@X", 203 + ( [Value] - 1 ) * 24,
			        "@Y", IF ( _Max = _Min, 64, ROUND ( 86 - DIVIDE ( [@Val] - _Min, _Max - _Min ) * 44, 0 ) )
			    )
			VAR _LastQ = MAXX ( _PtsXY, [Value] )
			VAR _Line =
			    IF (
			        COUNTROWS ( _PtsXY ) >= 2,
			        "<polyline points='"
			            & CONCATENATEX ( _PtsXY, FORMAT ( [@X], "0" ) & "," & FORMAT ( [@Y], "0" ), " ", [Value], ASC )
			            & "' fill='none' stroke='" & _Bar & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/>"
			    )
			        & CONCATENATEX (
			            _PtsXY,
			            "<circle cx='" & FORMAT ( [@X], "0" ) & "' cy='" & FORMAT ( [@Y], "0" )
			                & "' r='" & IF ( [Value] = _LastQ, "3.5", "2.5" )
			                & "' fill='" & IF ( [Value] = _LastQ, _Bar, "#FFFFFF" )
			                & "' stroke='" & _Bar & "' stroke-width='1.5'/>",
			            "",
			            [Value], ASC
			        )
			
			VAR _Chart = IF ( _ChartType = "LINE", _Line, _Bars ) & _Labels
			
			RETURN
			    IF (
			        ISBLANK ( _Value ),
			        BLANK (),
			        "<svg xmlns='http://www.w3.org/2000/svg' width='300' height='120' viewBox='0 0 300 120'>"
			            & "<rect x='0.5' y='0.5' width='299' height='119' rx='12' fill='#FFFFFF' stroke='#E7E9EF'/>"
			            & "<text x='18' y='30' " & _F & " font-size='12' font-weight='600' letter-spacing='0.2' fill='" & _Muted & "'>" & _Title & "</text>"
			            & "<text x='18' y='67' " & _F & " font-size='24' font-weight='600' letter-spacing='-0.3' fill='" & _Navy & "'>" & _ValueText & "</text>"
			            & _Arrow
			            & "<text x='33' y='94' " & _F & " font-size='12' font-weight='600' fill='" & _Color & "'>" & _ChangeText
			            & "<tspan dx='6' font-weight='400' fill='" & _Muted & "'>vs. PY</tspan></text>"
			            & _Chart
			            & "</svg>"
			    )
		displayFolder: 13 HTML Cards
		lineageTag: f07be9e5-ba08-4bc0-a2bc-fe072019a940

	/// Gross Margin KPI card, RAW SVG MARKUP for the HTML Content custom visual, 300 x 120. Same engine and style as SVG KPI Card Revenue HTML. CONFIG: value as PCT, change in PERCENTAGE POINTS computed inline (margin minus prior-year margin, blank without a prior year), _ChartType LINE: quarterly trend line scaled min-to-max, so it shows direction rather than magnitude; filled dot marks the latest quarter with data. Company level only, inherited from Gross Margin %. Every interpolated number goes through FORMAT(x,"0") (de-DE comma rule). Leave the data category UNCATEGORISED.
	measure 'SVG KPI Card Gross Margin HTML' =
			
			// ===== 1. CONFIG =====
			VAR _Title       = "Gross Margin"
			VAR _Value       = [Gross Margin %]
			VAR _Change      =
			    VAR _PY = CALCULATE ( [Gross Margin %], SAMEPERIODLASTYEAR ( dim_date[date] ) )
			    RETURN IF ( NOT ISBLANK ( _PY ), _Value - _PY )      // percentage points, as a fraction
			VAR _ValueFormat = "PCT"                    // "EUR" | "PCT"
			VAR _ChangeUnit  = "PP"                     // "PCT" | "PP"
			VAR _ChartType   = "LINE"                   // "BAR" | "LINE"
			VAR _Years = VALUES ( dim_date[year] )
			VAR _Quarters =
			    ADDCOLUMNS (
			        GENERATESERIES ( 1, 4, 1 ),
			        "@Val",
			            VAR _q = [Value]
			            RETURN
			                CALCULATE ( [Gross Margin %], REMOVEFILTERS ( dim_date ), _Years, dim_date[quarter] = "Q" & _q )
			    )
			
			// ===== 2. ENGINE: identical in every card =====
			VAR _Navy     = "#0B1F3A"
			VAR _Muted    = "#6B7280"
			VAR _Faint    = "#A0A7B4"
			VAR _Green    = "#1A7F4B"
			VAR _Red      = "#C0392B"
			VAR _Neutral  = "#8A93A3"
			VAR _Bar      = "#7C50DE"
			VAR _BarNeg   = "#F1C6CC"
			VAR _BarEmpty = "#ECEEF3"
			VAR _Eur      = UNICHAR ( 8364 )
			VAR _F        = "font-family='Segoe UI, Helvetica, Arial, sans-serif'"
			
			VAR _Abs  = ABS ( _Value )
			VAR _Sign = IF ( _Value < 0, "-", "" )
			VAR _ValueText =
			    SWITCH (
			        TRUE (),
			        _ValueFormat = "PCT", FORMAT ( _Value, "0.0%", "en-US" ),
			        _Abs >= 1000000000, _Sign & _Eur & FORMAT ( _Abs / 1000000000, "#,0.00", "en-US" ) & "B",
			        _Abs >= 1000000,    _Sign & _Eur & FORMAT ( _Abs / 1000000, "#,0.00", "en-US" ) & "M",
			        _Abs >= 1000,       _Sign & _Eur & FORMAT ( _Abs / 1000, "#,0.0", "en-US" ) & "K",
			        _Sign & _Eur & FORMAT ( _Abs, "#,0", "en-US" )
			    )
			
			VAR _HasChange = NOT ISBLANK ( _Change )
			VAR _ChangeNum = ROUND ( _Change * 100, 1 )
			VAR _Color =
			    SWITCH ( TRUE (), NOT _HasChange, _Neutral, _ChangeNum > 0, _Green, _ChangeNum < 0, _Red, _Neutral )
			VAR _ChangeText =
			    IF (
			        _HasChange,
			        FORMAT ( _ChangeNum, "+0.0;-0.0;0.0", "en-US" ) & IF ( _ChangeUnit = "PP", " pp", "%" ),
			        "n/a"
			    )
			VAR _Arrow =
			    SWITCH (
			        TRUE (),
			        _HasChange && _ChangeNum > 0,
			            "<path d='M19 93 L23 87 L27 93 Z' fill='" & _Color & "' stroke='" & _Color & "' stroke-width='1.5' stroke-linejoin='round'/>",
			        _HasChange && _ChangeNum < 0,
			            "<path d='M19 87 L27 87 L23 93 Z' fill='" & _Color & "' stroke='" & _Color & "' stroke-width='1.5' stroke-linejoin='round'/>",
			        "<rect x='18' y='89' width='10' height='2' rx='1' fill='" & _Color & "'/>"
			    )
			
			// Quarter labels (both chart types)
			VAR _Labels =
			    CONCATENATEX (
			        _Quarters,
			        "<text x='" & FORMAT ( 203 + ( [Value] - 1 ) * 24, "0" ) & "' y='108' " & _F
			            & " font-size='9' text-anchor='middle' fill='" & _Faint & "'>Q" & FORMAT ( [Value], "0" ) & "</text>",
			        "",
			        [Value], ASC
			    )
			
			// BAR: scaled to the largest quarter
			VAR _MaxAbs = MAXX ( _Quarters, ABS ( [@Val] ) )
			VAR _Bars =
			    CONCATENATEX (
			        _Quarters,
			        VAR _v     = [@Val]
			        VAR _x     = 196 + ( [Value] - 1 ) * 24
			        VAR _Empty = ISBLANK ( _v ) || _v = 0 || _MaxAbs = 0
			        VAR _h     = IF ( _Empty, 2, MAX ( 3, ROUND ( DIVIDE ( ABS ( _v ), _MaxAbs ) * 54, 0 ) ) )
			        VAR _Fill  = SWITCH ( TRUE (), _Empty, _BarEmpty, _v < 0, _BarNeg, _Bar )
			        RETURN
			            "<rect x='" & FORMAT ( _x, "0" ) & "' y='" & FORMAT ( 92 - _h, "0" )
			                & "' width='14' height='" & FORMAT ( _h, "0" ) & "' rx='3' fill='" & _Fill & "'/>",
			        "",
			        [Value], ASC
			    )
			
			// LINE: scaled min-to-max; quarters without data are skipped
			VAR _Pts   = FILTER ( _Quarters, NOT ISBLANK ( [@Val] ) )
			VAR _Min   = MINX ( _Pts, [@Val] )
			VAR _Max   = MAXX ( _Pts, [@Val] )
			VAR _PtsXY =
			    ADDCOLUMNS (
			        _Pts,
			        "@X", 203 + ( [Value] - 1 ) * 24,
			        "@Y", IF ( _Max = _Min, 64, ROUND ( 86 - DIVIDE ( [@Val] - _Min, _Max - _Min ) * 44, 0 ) )
			    )
			VAR _LastQ = MAXX ( _PtsXY, [Value] )
			VAR _Line =
			    IF (
			        COUNTROWS ( _PtsXY ) >= 2,
			        "<polyline points='"
			            & CONCATENATEX ( _PtsXY, FORMAT ( [@X], "0" ) & "," & FORMAT ( [@Y], "0" ), " ", [Value], ASC )
			            & "' fill='none' stroke='" & _Bar & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/>"
			    )
			        & CONCATENATEX (
			            _PtsXY,
			            "<circle cx='" & FORMAT ( [@X], "0" ) & "' cy='" & FORMAT ( [@Y], "0" )
			                & "' r='" & IF ( [Value] = _LastQ, "3.5", "2.5" )
			                & "' fill='" & IF ( [Value] = _LastQ, _Bar, "#FFFFFF" )
			                & "' stroke='" & _Bar & "' stroke-width='1.5'/>",
			            "",
			            [Value], ASC
			        )
			
			VAR _Chart = IF ( _ChartType = "LINE", _Line, _Bars ) & _Labels
			
			RETURN
			    IF (
			        ISBLANK ( _Value ),
			        BLANK (),
			        "<svg xmlns='http://www.w3.org/2000/svg' width='300' height='120' viewBox='0 0 300 120'>"
			            & "<rect x='0.5' y='0.5' width='299' height='119' rx='12' fill='#FFFFFF' stroke='#E7E9EF'/>"
			            & "<text x='18' y='30' " & _F & " font-size='12' font-weight='600' letter-spacing='0.2' fill='" & _Muted & "'>" & _Title & "</text>"
			            & "<text x='18' y='67' " & _F & " font-size='24' font-weight='600' letter-spacing='-0.3' fill='" & _Navy & "'>" & _ValueText & "</text>"
			            & _Arrow
			            & "<text x='33' y='94' " & _F & " font-size='12' font-weight='600' fill='" & _Color & "'>" & _ChangeText
			            & "<tspan dx='6' font-weight='400' fill='" & _Muted & "'>vs. PY</tspan></text>"
			            & _Chart
			            & "</svg>"
			    )
		displayFolder: 13 HTML Cards
		lineageTag: 11653c8d-c005-42d8-b3e4-f6201d430d03

	/// EBITDA KPI card, RAW SVG MARKUP for the HTML Content custom visual, 300 x 120. Same engine and style as SVG KPI Card Revenue HTML. CONFIG: value as EUR, change from the existing EBITDA YoY % measure, _ChartType BAR. A negative quarter would draw as a light pink bar (#F1C6CC), scaled by its absolute value. Every interpolated number goes through FORMAT(x,"0") (de-DE comma rule). Leave the data category UNCATEGORISED.
