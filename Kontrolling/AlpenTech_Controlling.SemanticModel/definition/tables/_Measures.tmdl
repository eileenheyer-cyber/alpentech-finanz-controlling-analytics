			        ISBLANK ( _Value ),
			        BLANK (),
			        "<svg xmlns='http://www.w3.org/2000/svg' width='300' height='120' viewBox='0 0 300 120'>"
			            & "<rect x='0.5' y='0.5' width='299' height='119' rx='12' fill='#FFFFFF' stroke='#E7E9EF'/>"
			            & "<text x='18' y='30' " & _F & " font-size='12' font-weight='600' letter-spacing='0.2' fill='" & _Muted & "'>" & _Title & "</text>"
			            & "<text x='18' y='67' " & _F & " font-size='24' font-weight='600' letter-spacing='-0.3' fill='" & _Navy & "'>" & _ValueText & "</text>"
			            & _Arrow
			            & "<text x='33' y='94' " & _F & " font-size='12' font-weight='600' fill='" & _Color & "'>" & _ChangeText
			            & "<tspan dx='6' font-weight='400' fill='" & _Muted & "'>vs. PY</tspan></text>"
			            & _Chart
			            & "</svg>"
			    )
		displayFolder: 13 HTML Cards
		lineageTag: 14bd996c-d4b1-46d6-b855-3ca58e5f49ed

	/// Revenue for a chart axis built on Chart_YearQuarter, limited to the selected year and the two years before it. Reads the selected year from dim_date (the year slicer), so the slicer stays wired as it is; with no year selected, MAX picks the latest year. Returns blank for axis quarters outside the window, which Power BI hides. Calls [Revenue], so the revenue definition is not duplicated. Only meaningful with Chart_YearQuarter columns on the axis.
	measure 'Revenue 3Y Window' =
			
			VAR _SelYear = MAX ( dim_date[year] )
			VAR _Window =
			    FILTER (
			        VALUES ( Chart_YearQuarter[Year] ),
			        Chart_YearQuarter[Year] >= _SelYear - 2
			            && Chart_YearQuarter[Year] <= _SelYear
			    )
			RETURN
			    IF (
			        NOT ISEMPTY ( _Window ),
			        CALCULATE (
			            [Revenue],
			            REMOVEFILTERS ( dim_date ),
			            TREATAS ( _Window, dim_date[year] ),
			            TREATAS ( VALUES ( Chart_YearQuarter[Quarter] ), dim_date[quarter] )
			        )
			    )
		formatString: #,##0
		displayFolder: 15 Chart Window
		lineageTag: f999221d-f870-4651-8436-dfb0b7419ff6

	/// EBITDA for a chart axis built on Chart_YearQuarter, limited to the selected year and the two years before it. Same window logic as Revenue 3Y Window: selected year read from dim_date, blank outside the window. Calls [EBITDA], so the definition is not duplicated. Only meaningful with Chart_YearQuarter columns on the axis.
	measure 'EBITDA 3Y Window' =
			
			VAR _SelYear = MAX ( dim_date[year] )
			VAR _Window =
			    FILTER (
			        VALUES ( Chart_YearQuarter[Year] ),
			        Chart_YearQuarter[Year] >= _SelYear - 2
			            && Chart_YearQuarter[Year] <= _SelYear
			    )
			RETURN
			    IF (
			        NOT ISEMPTY ( _Window ),
			        CALCULATE (
			            [EBITDA],
			            REMOVEFILTERS ( dim_date ),
			            TREATAS ( _Window, dim_date[year] ),
			            TREATAS ( VALUES ( Chart_YearQuarter[Quarter] ), dim_date[quarter] )
			        )
			    )
		formatString: #,##0
		displayFolder: 15 Chart Window
		lineageTag: 30d9b7ee-1db7-41d6-a65b-bd405d064ba5

	/// EBITDA margin for a chart axis built on Chart_YearQuarter, limited to the selected year and the two years before it. Same window logic as Revenue 3Y Window. Calls [EBITDA Margin %], so the margin is recalculated from totals at each axis level rather than averaged. Only meaningful with Chart_YearQuarter columns on the axis.
	measure 'EBITDA Margin % 3Y Window' =
			
			VAR _SelYear = MAX ( dim_date[year] )
			VAR _Window =
			    FILTER (
			        VALUES ( Chart_YearQuarter[Year] ),
			        Chart_YearQuarter[Year] >= _SelYear - 2
			            && Chart_YearQuarter[Year] <= _SelYear
			    )
			RETURN
			    IF (
			        NOT ISEMPTY ( _Window ),
			        CALCULATE (
			            [EBITDA Margin %],
			            REMOVEFILTERS ( dim_date ),
			            TREATAS ( _Window, dim_date[year] ),
			            TREATAS ( VALUES ( Chart_YearQuarter[Quarter] ), dim_date[quarter] )
			        )
			    )
		formatString: 0.0%
		displayFolder: 15 Chart Window
		lineageTag: 963b95b5-760f-4055-9233-f84d53219398

	/// Custom data label for the EBITDA Margin % line on the Chart_YearQuarter trend chart. Returns the formatted margin only for selected quarters and BLANK for all others, so only those points carry a label. _Mode KEY labels the first quarter, the peak, the low and the latest quarter within the same 3-year window as EBITDA Margin % 3Y Window; LATEST labels the latest quarter only. The peak reads 'High 17,4%' and the low 'Low 9,5%'; start and latest stay plain. When roles coincide, High or Low wins, and the point carries one label. Every role is identified by its Year Quarter Sort key (TOPN for high and low), NOT by comparing margin values: a float equality test failed when the axis used the single Year Quarter field. Iterates ALL(Chart_YearQuarter) so context transition overrides the axis filters, while the year slicer filter on dim_date is kept. Works with Year + Quarter or Year Quarter on the axis; blank at year level (no single quarter in context). Use via Format > Data labels > series EBITDA Margin % > Value > Field.
	measure 'EBITDA Margin % Label 3Y' =
			
			// ===== CONFIG =====
			VAR _Mode = "KEY"                  // "KEY" = start, peak, low, latest  |  "LATEST" = latest quarter only
			
			// ===== Current axis point =====
			VAR _CurSort = SELECTEDVALUE ( Chart_YearQuarter[Year Quarter Sort] )
			VAR _Current = [EBITDA Margin % 3Y Window]
			
			// ===== All quarters in the window (axis filters overridden, year slicer kept) =====
			VAR _Points =
			    FILTER (
			        ADDCOLUMNS ( ALL ( Chart_YearQuarter ), "@M", [EBITDA Margin % 3Y Window] ),
			        NOT ISBLANK ( [@M] )
			    )
			
			// Roles identified by sort key, never by comparing margin values
			VAR _FirstSort = MINX ( _Points, Chart_YearQuarter[Year Quarter Sort] )
			VAR _LastSort  = MAXX ( _Points, Chart_YearQuarter[Year Quarter Sort] )
			VAR _HighSort  = MAXX ( TOPN ( 1, _Points, [@M], DESC, Chart_YearQuarter[Year Quarter Sort], DESC ), Chart_YearQuarter[Year Quarter Sort] )
			VAR _LowSort   = MAXX ( TOPN ( 1, _Points, [@M], ASC, Chart_YearQuarter[Year Quarter Sort], DESC ), Chart_YearQuarter[Year Quarter Sort] )
			
			// ===== Which roles does this point have =====
			VAR _IsHigh   = _CurSort = _HighSort
			VAR _IsLow    = _CurSort = _LowSort
			VAR _IsLatest = _CurSort = _LastSort
			VAR _IsKey    = _IsLatest || _CurSort = _FirstSort || _IsHigh || _IsLow
			VAR _Show     = IF ( _Mode = "LATEST", _IsLatest, _IsKey )
			
			// High / Low wins when roles coincide
			VAR _Prefix =
			    SWITCH ( TRUE (), _IsHigh, "High ", _IsLow, "Low ", "" )
			
			RETURN
			    IF (
			        NOT ISBLANK ( _CurSort ) && NOT ISBLANK ( _Current ) && _Show,
			        _Prefix & FORMAT ( _Current, "0.0%" )
			    )
		displayFolder: 15 Chart Window
		lineageTag: 869c14bf-19f0-4376-b0b6-00a54154352b

	/// Bar value for the EBITDA bridge driven by the disconnected EBITDA_Bridge table, prior year to selected year, in income statement order. Total and Subtotal steps return a LEVEL: EBITDA Prior Year = [EBITDA PY], Gross Profit = EBITDA PY plus the change in Gross Profit, EBITDA Current Year = [EBITDA]. Delta steps return a signed CHANGE, positive = favourable: Revenue = Revenue minus Revenue PY; COGS = -(COGS minus COGS PY); Operating Expenses = -(change in Gross Profit minus EBITDA), i.e. every cost that is neither COGS nor depreciation. Uses the existing Revenue, COGS, Gross Profit and EBITDA measures, so no definition is duplicated. The deltas reconcile: EBITDA PY + Revenue + COGS + Operating Expenses = EBITDA. Blank unless exactly one year is selected and a prior year exists (so blank for 2023). COMPANY LEVEL: Gross Profit and COGS ignore cost-center filters by design. Blank on an unknown Step label, so a typo shows as a gap rather than a wrong number.
	measure 'EBITDA Bridge Value' =
			
			VAR _Step    = SELECTEDVALUE ( EBITDA_Bridge[Step] )
			VAR _OneYear = HASONEVALUE ( dim_date[year] )
			
			VAR _EBITDA_CY = [EBITDA]
			VAR _EBITDA_PY = [EBITDA PY]
			VAR _Rev_Delta = [Revenue] - [Revenue PY]
			VAR _COGS_CY   = [COGS]
			VAR _COGS_PY   = CALCULATE ( [COGS], SAMEPERIODLASTYEAR ( dim_date[date] ) )
			VAR _GP_CY     = [Gross Profit]
			VAR _GP_PY     = CALCULATE ( [Gross Profit], SAMEPERIODLASTYEAR ( dim_date[date] ) )
			
			// Operating expenses = everything between Gross Profit and EBITDA
			VAR _OpEx_Delta = ( _GP_CY - _EBITDA_CY ) - ( _GP_PY - _EBITDA_PY )
			
			RETURN
			    IF (
			        _OneYear && NOT ISBLANK ( _EBITDA_PY ),
			        SWITCH (
			            _Step,
			            "EBITDA Prior Year",   _EBITDA_PY,
			            "Revenue",             _Rev_Delta,
			            "COGS",                - ( _COGS_CY - _COGS_PY ),
			            "Gross Profit",        _EBITDA_PY + ( _GP_CY - _GP_PY ),
			            "Operating Expenses",  - _OpEx_Delta,
			            "EBITDA Current Year", _EBITDA_CY
			        )
			    )
		formatString: #,##0
		displayFolder: 11 Bridge
		lineageTag: cf03f654-7db9-45c4-a5f6-0b27970e2328

	/// Invisible spacer series for the EBITDA bridge stacked column chart: the height at which a Delta bar starts floating. For Delta steps returns MIN(start, start + value), so increases stack upward from the running level and decreases hang down to it. Blank for Total and Subtotal steps, which stand on zero. The running level is derived generically from EBITDA_Bridge: the last Total/Subtotal before the step plus every Delta in between, so adding a step needs no change here. Set this series to no fill and no label. LIMITATION: assumes the running level stays above zero; a negative EBITDA would need a different chart.
	measure 'EBITDA Bridge Base' =
			
			VAR _Type  = SELECTEDVALUE ( EBITDA_Bridge[Step Type] )
			VAR _Order = SELECTEDVALUE ( EBITDA_Bridge[Step Order] )
			VAR _V     = [EBITDA Bridge Value]
			
			// All steps with their values, independent of the axis filter
			VAR _Steps =
			    CALCULATETABLE (
			        ADDCOLUMNS ( EBITDA_Bridge, "@V", [EBITDA Bridge Value] ),
			        REMOVEFILTERS ( EBITDA_Bridge )
			    )
			VAR _Anchor =
			    MAXX (
			        FILTER ( _Steps, EBITDA_Bridge[Step Order] < _Order && EBITDA_Bridge[Step Type] <> "Delta" ),
			        EBITDA_Bridge[Step Order]
			    )
			VAR _Start =
			    MAXX ( FILTER ( _Steps, EBITDA_Bridge[Step Order] = _Anchor ), [@V] )
			        + SUMX (
			            FILTER (
			                _Steps,
			                EBITDA_Bridge[Step Order] > _Anchor
			                    && EBITDA_Bridge[Step Order] < _Order
			                    && EBITDA_Bridge[Step Type] = "Delta"
			            ),
			            [@V]
			        )
			
			RETURN
			    IF ( _Type = "Delta" && NOT ISBLANK ( _V ), MIN ( _Start, _Start + _V ) )
		formatString: #,##0
		displayFolder: 11 Bridge
		lineageTag: 06711656-1533-42e0-8ff2-1b001b3bd729

	/// Increase series for the EBITDA bridge stacked column chart: the bar height for a favourable Delta step (e.g. revenue growth). Blank otherwise. Colour #7C50DE.
	measure 'EBITDA Bridge Increase' =
			
			VAR _Type = SELECTEDVALUE ( EBITDA_Bridge[Step Type] )
			VAR _V    = [EBITDA Bridge Value]
			RETURN
			    IF ( _Type = "Delta" && _V > 0, _V )
		formatString: #,##0
		displayFolder: 11 Bridge
		lineageTag: 004caf40-800c-4d33-9bb1-5bbd1c9bc410

	/// Decrease series for the EBITDA bridge stacked column chart: the bar height, as a POSITIVE number, for an unfavourable Delta step (e.g. higher COGS). Positive so it stacks on top of EBITDA Bridge Base, which already sits at the lower end of the move. Blank otherwise. Colour #C1323C.
	measure 'EBITDA Bridge Decrease' =
			
			VAR _Type = SELECTEDVALUE ( EBITDA_Bridge[Step Type] )
			VAR _V    = [EBITDA Bridge Value]
			RETURN
			    IF ( _Type = "Delta" && _V < 0, - _V )
		formatString: #,##0
		displayFolder: 11 Bridge
		lineageTag: 4d320ffd-4b06-4cea-a492-da0bc06efec9

	/// Total series for the EBITDA bridge stacked column chart: the full-height bar for Total and Subtotal steps (EBITDA Prior Year, Gross Profit, EBITDA Current Year), standing on zero. Blank for Delta steps. Colour #391587.
	measure 'EBITDA Bridge Total' =
			
			VAR _Type = SELECTEDVALUE ( EBITDA_Bridge[Step Type] )
			VAR _V    = [EBITDA Bridge Value]
			RETURN
			    IF ( _Type IN { "Total", "Subtotal" }, _V )
		formatString: #,##0
		displayFolder: 11 Bridge
		lineageTag: f89f9067-767e-4810-96c8-36263e8cc4b0

	/// Custom data label text for the EBITDA bridge, in the report's de-DE format: levels as 2,58M, deltas with sign as +875K / -917K (M with two decimals once the amount reaches one million). Subtotal steps add their change since the previous total, e.g. Gross Profit '2,54M (-41K vs PY)'. Blank where EBITDA Bridge Value is blank. Use via Format > Data labels > Value > Field on the Increase, Decrease and Total series; leave the Base series unlabelled.
	measure 'EBITDA Bridge Label' =
			
			VAR _Type  = SELECTEDVALUE ( EBITDA_Bridge[Step Type] )
			VAR _Order = SELECTEDVALUE ( EBITDA_Bridge[Step Order] )
			VAR _V     = [EBITDA Bridge Value]
			
			// Value of the previous Total/Subtotal, for the subtotal's change note
			VAR _Steps =
			    CALCULATETABLE (
			        ADDCOLUMNS ( EBITDA_Bridge, "@V", [EBITDA Bridge Value] ),
			        REMOVEFILTERS ( EBITDA_Bridge )
			    )
			VAR _Anchor =
			    MAXX (
			        FILTER ( _Steps, EBITDA_Bridge[Step Order] < _Order && EBITDA_Bridge[Step Type] <> "Delta" ),
			        EBITDA_Bridge[Step Order]
			    )
			VAR _AnchorV = MAXX ( FILTER ( _Steps, EBITDA_Bridge[Step Order] = _Anchor ), [@V] )
			
			// Number formatting (model culture de-DE gives the decimal comma)
			VAR _Abs = ABS ( _V )
			VAR _Num =
			    IF ( _Abs >= 1000000, FORMAT ( _Abs / 1000000, "0.00" ) & "M", FORMAT ( _Abs / 1000, "#,0" ) & "K" )
			VAR _Main =
			    IF (
			        _Type = "Delta",
			        IF ( _V >= 0, "+", "-" ) & _Num,
			        IF ( _V < 0, "-", "" ) & _Num
			    )
			
			VAR _D    = _V - _AnchorV
			VAR _DAbs = ABS ( _D )
			VAR _DNum =
			    IF ( _DAbs >= 1000000, FORMAT ( _DAbs / 1000000, "0.00" ) & "M", FORMAT ( _DAbs / 1000, "#,0" ) & "K" )
			VAR _Note =
			    IF ( _Type = "Subtotal" && NOT ISBLANK ( _AnchorV ), " (" & IF ( _D >= 0, "+", "-" ) & _DNum & " vs PY)" )
			
			RETURN
			    IF ( NOT ISBLANK ( _V ), _Main & _Note )
		displayFolder: 11 Bridge
		lineageTag: 8a84486a-dffa-48dc-87f8-fc9dfa3d8685

	/// Dynamic chart title for the EBITDA bridge, e.g. 'EBITDA Bridge FY2024 → FY2025', following the year slicer. Reads 'EBITDA Bridge FY2023 (no prior year)' when the selected year has no prior-year data, and asks for a single year when none or several are selected. Apply via Format > General > Title > Text > fx > Field value.
	measure 'EBITDA Bridge Title' =
			
			VAR _Y = MAX ( dim_date[year] )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT HASONEVALUE ( dim_date[year] ), "EBITDA Bridge (select one year)",
			        ISBLANK ( [EBITDA PY] ), "EBITDA Bridge FY" & FORMAT ( _Y, "0" ) & " (no prior year)",
			        "EBITDA Bridge FY" & FORMAT ( _Y - 1, "0" ) & " " & UNICHAR ( 8594 ) & " FY" & FORMAT ( _Y, "0" )
			    )
		displayFolder: 11 Bridge
		lineageTag: dc0f8b11-24df-4601-9a95-539ee7a6df04

	/// Y value for the NATIVE waterfall version of the EBITDA bridge, category EBITDA_Bridge[Step]. Keeps only the steps the native waterfall should draw - EBITDA Prior Year as the starting bar plus the Delta steps (Revenue, COGS, Operating Expenses) - and returns BLANK for Gross Profit and EBITDA Current Year, so those categories are hidden. The waterfall adds its own Total bar, which equals EBITDA Current Year (2025: 2,584,015 + 875,325 - 916,635 - 532,469 = 2,010,236). SUMX over EBITDA_Bridge rather than an IF on the step name, so the total is right whether the visual sums the bars or evaluates the measure with no step selected. Reuses EBITDA Bridge Value, so it follows the year slicer and is blank for 2023 and when no single year is selected. The native waterfall cannot draw the Gross Profit subtotal mid-bridge; use the stacked column measures in this folder for that.
	measure 'EBITDA Waterfall Value' =
			
			// Steps the native waterfall draws: the starting EBITDA and the changes.
			// Gross Profit (subtotal) and EBITDA Current Year are left out:
			// the waterfall adds its own Total bar, which equals EBITDA Current Year.
			SUMX (
			    FILTER (
			        EBITDA_Bridge,
			        EBITDA_Bridge[Step Type] = "Delta"
			            || EBITDA_Bridge[Step] = "EBITDA Prior Year"
			    ),
			    [EBITDA Bridge Value]
			)
		formatString: #,##0
		displayFolder: 11 Bridge
		lineageTag: 5ac02e0a-dd71-40a3-b12f-714db09c90d6

	/// Display label for the YoY column of the P&L cascade matrix, e.g. '▲ +9,5%'. Number and arrow show the DIRECTION the line itself moved; colour it with P&L YoY vs PY Colour, which shows whether that is good or bad. Built on P&L Actual YoY %, which uses the impact sign (negative = unfavourable) because costs are stored negative. For the cost lines COGS, Operating Expenses, Depreciation & Amortisation and Taxes & Interest the sign is flipped, so rising costs read + (COGS 2025: +9,5%, not -9,5%) and falling tax reads -. Revenue and all subtotals are unchanged. Applies to drill-down account rows under those lines too. Cash-flow lines keep the cash-impact sign. P&L Actual YoY % itself is untouched. Blank where no prior year exists. Arrow and sign decided on the value rounded to one decimal, so a flat line reads ▬ 0,0%.
	measure 'P&L YoY vs PY Label' =
			
			VAR _Line = SELECTEDVALUE ( PnL_Layout[Line] )
			VAR _Pct  = [P&L Actual YoY %]                  // impact sign: + favourable, - unfavourable
			
			// Cost lines: flip to show the direction of the cost itself (costs up = +)
			VAR _IsCost =
			    _Line IN { "COGS", "Operating Expenses", "Depreciation & Amortisation", "Taxes & Interest" }
			VAR _Move    = IF ( _IsCost, - _Pct, _Pct )
			VAR _Rounded = ROUND ( _Move, 3 )
			VAR _Arrow =
			    SWITCH ( TRUE (), _Rounded > 0, "▲", _Rounded < 0, "▼", "▬" )
			
			RETURN
			    IF (
			        NOT ISBLANK ( _Pct ),
			        _Arrow & " " & FORMAT ( _Rounded, "+0.0%;-0.0%;0.0%" )
			    )
		displayFolder: 15 P&L Matrix
		lineageTag: 207691ee-abb4-46f6-82a7-3e4f2f089b5a

	/// Font colour for P&L YoY vs PY Label in the P&L cascade matrix. Keyed on P&L Actual YoY % (impact sign), so it shows GOOD or BAD regardless of direction: green #107C41 when the change is favourable (revenue up, costs down), red #C50F1F when unfavourable (COGS up 9,5% is red), grey #605E5C when flat at one decimal, blank where no prior year exists. Same colours as Revenue YoY % Colour and the other YoY colour measures. Apply via the column's Font colour > fx > Field value.
	measure 'P&L YoY vs PY Colour' =
			
			VAR _Pct     = [P&L Actual YoY %]                // impact sign: + favourable
			VAR _Rounded = ROUND ( _Pct, 3 )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Pct ), BLANK (),
			        _Rounded > 0, "#107C41",
			        _Rounded < 0, "#C50F1F",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: 00eeb076-14b6-467a-b7bb-6581c43c00d2

	/// Plan attainment: Actual as % of Budget. 2025: 1,294,247 / 2,445,968 = 52,9%; 2024: 82,7%; 2023: 104,0%. Different from Variance %, which shows the GAP (Actual - Budget) / Budget = -47,1% for 2025; this shows how much of plan was reached, which is what a gauge centre should display. Drives the Value of the Actual to Plan gauge, with Plan Target % as target and Plan Gauge Max % as maximum. At P&L level Actual and Budget are the operating result. Blank where Budget is blank or zero. Read with a single-year filter: without one it compares all years added together (78,5% for 2023-2025).
	measure 'Actual to Plan %' = DIVIDE ( [Actual], [Budget] )
		formatString: 0.0%
		displayFolder: 02 Variance
		lineageTag: 8dace0ce-da7b-409b-a612-e6ff6d2323e5

	/// Constant 100%: the plan line for the Actual to Plan gauge. Needed as a measure because the gauge Target value well only accepts a field, not a typed number.
	measure 'Plan Target %' = 1
		formatString: 0%
		displayFolder: 02 Variance
		lineageTag: f4e2e962-4e5e-4cc7-87c2-daeeec716c4d

	/// Constant 120%: the maximum of the Actual to Plan gauge, leaving room above plan so an over-achievement (2023: 104,0%) still sits inside the arc. Needed as a measure because the gauge Maximum value well only accepts a field. Raise it if attainment can exceed 120%.
	measure 'Plan Gauge Max %' = 1.2
		formatString: 0%
		displayFolder: 02 Variance
		lineageTag: e8161f81-7f10-4188-bcb1-65570f426ed8

	/// Subtitle text for the Actual to Plan gauge, e.g. '1,29M of 2,45M plan' for 2025. M with two decimals from one million, otherwise K; de-DE decimal comma from the model culture. Follows the year slicer. Blank where Budget is blank. Apply via Format > General > Title > Subtitle > Text > fx > Field value.
	measure 'Actual to Plan Caption' =
			
			VAR _A = [Actual]
			VAR _B = [Budget]
			VAR _FmtA =
			    IF ( _A < 0, "-", "" )
			        & IF (
			            ABS ( _A ) >= 1000000,
			            FORMAT ( ABS ( _A ) / 1000000, "0.00" ) & "M",
			            FORMAT ( ABS ( _A ) / 1000, "#,0" ) & "K"
			        )
			VAR _FmtB =
			    IF ( _B < 0, "-", "" )
			        & IF (
			            ABS ( _B ) >= 1000000,
			            FORMAT ( ABS ( _B ) / 1000000, "0.00" ) & "M",
			            FORMAT ( ABS ( _B ) / 1000, "#,0" ) & "K"
			        )
			RETURN
			    IF ( NOT ISBLANK ( _B ), _FmtA & " of " & _FmtB & " plan" )
		displayFolder: 02 Variance
		lineageTag: 4c5b4a26-1a9f-4cd1-bb23-140ea6518e31

	/// Actual vs Plan GAUGE card, RAW SVG MARKUP for the HTML Content custom visual (viewBox 300 x 190, drawn at width 350). Visible labels say PLAN, not Budget (terminology decision 2026-09-17: Actual / Plan / Forecast / PY); the measure name and the underlying [Budget] measure keep their names so existing visuals do not break. Half-circle arc filled to Actual to Plan % (Actual / Budget) on a 0-120% scale, navy tick at 100% = plan; above 120% the arc is capped but the centre shows the true %. Centre: the % (de-DE, e.g. 52,9%) plus a status pill using the SAME thresholds and colours as SVG KPI Card AvB HTML: >= 100% ON TRACK green, >= 90% AT RISK amber, else BEHIND red; arc red when BEHIND, #391587 otherwise. Bottom row: Actual left, Plan right, in EUR (M with two decimals, else K). At P&L level Actual and Plan are the operating result (EBIT). 2025: 1,29M of 2,45M = 52,9% BEHIND. Follows the year slicer; without a year filter it shows all years added together. Blank where Actual and Plan are both blank. ENCODING: arc and tick coordinates are non-integer, so they go through FORMAT(x, "0.0", "en-US") - the de-DE model culture would otherwise write a decimal comma into the SVG path and break it. Raw markup, no data URI. Leave the data category UNCATEGORISED.
	measure 'SVG Gauge Actual vs Budget HTML' =
			
			// ===== 1. CONFIG =====
			VAR _Title     = "Overall Actual vs Plan"
			VAR _Actual    = [Actual]
			VAR _Budget    = [Budget]
			VAR _P         = [Actual to Plan %]              // Actual / Budget
			VAR _ScaleMax  = 1.2                             // arc runs 0% .. 120% of budget
			VAR _OnTrackAt = 1.00
			VAR _AtRiskAt  = 0.90
			
			// ===== 2. STATUS: same rules as SVG KPI Card AvB HTML =====
			VAR _Status =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _P ), "NO TARGET",
			        _P >= _OnTrackAt, "ON TRACK",
			        _P >= _AtRiskAt, "AT RISK",
			        "BEHIND"
			    )
			VAR _StatusCol =
			    SWITCH ( _Status, "ON TRACK", "#107C41", "AT RISK", "#C77700", "BEHIND", "#C50F1F", "#605E5C" )
			VAR _ArcCol = IF ( _Status = "BEHIND", "#C50F1F", "#391587" )
			
			// ===== 3. GEOMETRY: centre 150/128, radius 84; angle runs from left (0%) to right (120%) =====
			VAR _CX    = 150
			VAR _CY    = 128
			VAR _R     = 84
			VAR _Clamp = MIN ( MAX ( COALESCE ( _P, 0 ), 0 ), _ScaleMax )
			VAR _TF    = PI () * ( 1 - _Clamp / _ScaleMax )  // fill end angle
			VAR _FX    = _CX + _R * COS ( _TF )
			VAR _FY    = _CY - _R * SIN ( _TF )
			VAR _TT    = PI () * ( 1 - 1 / _ScaleMax )       // budget tick angle (100%)
			VAR _TX1   = _CX + ( _R - 15 ) * COS ( _TT )
			VAR _TY1   = _CY - ( _R - 15 ) * SIN ( _TT )
			VAR _TX2   = _CX + ( _R + 15 ) * COS ( _TT )
			VAR _TY2   = _CY - ( _R + 15 ) * SIN ( _TT )
			VAR _LX    = _CX + ( _R + 26 ) * COS ( _TT ) + 4
			VAR _LY    = _CY - ( _R + 26 ) * SIN ( _TT ) + 2
			VAR _PillW = LEN ( _Status ) * 6.4 + 18
			VAR _PillX = _CX - _PillW / 2
			
			// ===== 4. TEXT =====
			VAR _Eur = UNICHAR ( 8364 )
			VAR _FmtA =
			    IF ( _Actual < 0, "-", "" ) & _Eur
			        & IF (
			            ABS ( _Actual ) >= 1000000,
			            FORMAT ( ABS ( _Actual ) / 1000000, "0.00" ) & "M",
			            FORMAT ( ABS ( _Actual ) / 1000, "#,0" ) & "K"
			        )
			VAR _FmtB =
			    IF ( _Budget < 0, "-", "" ) & _Eur
			        & IF (
			            ABS ( _Budget ) >= 1000000,
			            FORMAT ( ABS ( _Budget ) / 1000000, "0.00" ) & "M",
			            FORMAT ( ABS ( _Budget ) / 1000, "#,0" ) & "K"
			        )
			VAR _PctText = IF ( ISBLANK ( _P ), "n/a", FORMAT ( _P, "0.0%" ) )
			VAR _F = "font-family='Segoe UI, Helvetica, Arial, sans-serif'"
			
			// ===== 5. ARCS (coordinates in en-US: no decimal comma in SVG) =====
			VAR _Track =
			    "<path d='M" & FORMAT ( _CX - _R, "0" ) & " " & FORMAT ( _CY, "0" )
			        & " A" & FORMAT ( _R, "0" ) & " " & FORMAT ( _R, "0" ) & " 0 0 1 "
			        & FORMAT ( _CX + _R, "0" ) & " " & FORMAT ( _CY, "0" )
			        & "' fill='none' stroke='#ECEEF3' stroke-width='18' stroke-linecap='round'/>"
			VAR _Fill =
			    IF (
			        _Clamp > 0.005,
			        "<path d='M" & FORMAT ( _CX - _R, "0" ) & " " & FORMAT ( _CY, "0" )
			            & " A" & FORMAT ( _R, "0" ) & " " & FORMAT ( _R, "0" ) & " 0 0 1 "
			            & FORMAT ( _FX, "0.0", "en-US" ) & " " & FORMAT ( _FY, "0.0", "en-US" )
			            & "' fill='none' stroke='" & _ArcCol & "' stroke-width='18' stroke-linecap='round'/>"
			    )
			VAR _Tick =
			    "<line x1='" & FORMAT ( _TX1, "0.0", "en-US" ) & "' y1='" & FORMAT ( _TY1, "0.0", "en-US" )
			        & "' x2='" & FORMAT ( _TX2, "0.0", "en-US" ) & "' y2='" & FORMAT ( _TY2, "0.0", "en-US" )
			        & "' stroke='#0B1F3A' stroke-width='2.5' stroke-linecap='round'/>"
			        & "<text x='" & FORMAT ( _LX, "0.0", "en-US" ) & "' y='" & FORMAT ( _LY, "0.0", "en-US" ) & "' " & _F
			        & " font-size='9' fill='#6B7280'>100%</text>"
			
			// ===== 6. RAW SVG, 300 x 190 =====
			RETURN
			    IF (
			        ISBLANK ( _Actual ) && ISBLANK ( _Budget ),
			        BLANK (),
			        "<svg xmlns='http://www.w3.org/2000/svg' width='350' height='190' viewBox='0 0 300 190'>"
			            & "<rect x='0.5' y='0.5' width='299' height='189' rx='12' fill='#FFFFFF' stroke='#E7E9EF'/>"
			            & "<text x='16' y='24' " & _F & " font-size='14' font-weight='600' fill='#6B7280'>" & _Title & "</text>"
			            & _Track & _Fill & _Tick
			            & "<text x='150' y='116' " & _F & " font-size='28' font-weight='600' text-anchor='middle' fill='#0B1F3A'>" & _PctText & "</text>"
			            & "<rect x='" & FORMAT ( _PillX, "0.0", "en-US" ) & "' y='125' width='" & FORMAT ( _PillW, "0.0", "en-US" )
			                & "' height='17' rx='8.5' fill='" & _StatusCol & "'/>"
			            & "<text x='150' y='137' " & _F & " font-size='9' font-weight='700' text-anchor='middle' fill='#FFFFFF'>" & _Status & "</text>"
			            & "<line x1='16' y1='150' x2='284' y2='150' stroke='#EEF0F4'/>"
			            & "<text x='16' y='168' " & _F & " font-size='10' fill='#6B7280'>Actual</text>"
			            & "<text x='16' y='182' " & _F & " font-size='13' font-weight='600' fill='#0B1F3A'>" & _FmtA & "</text>"
			            & "<text x='284' y='168' " & _F & " font-size='10' text-anchor='end' fill='#6B7280'>Plan</text>"
			            & "<text x='284' y='182' " & _F & " font-size='13' font-weight='600' text-anchor='end' fill='#0B1F3A'>" & _FmtB & "</text>"
			            & "</svg>"
			    )
		displayFolder: 13 HTML Cards
		lineageTag: ce2bad88-b7f5-4bda-a365-e6c7b9e746cd

	/// COMPACT Revenue vs Plan KPI card, RAW SVG MARKUP for the HTML Content custom visual, 315 x 120. REDESIGNED 2026-09-17 (plan-only family, identical layout to SVG KPI Card EBITDA vs Plan HTML and SVG KPI Card EBITDA Margin vs Plan HTML): NO prior-year comparison. Layout: title and status pill on top; value 22px with the signed variance vs plan on the same line, right ('+2K vs plan'); progress bar where the FULL BAR = PLAN and the fill = Revenue / Revenue Plan (capped at 100%), black marker at the plan end; bottom line '100,0% of plan' left and 'Plan 20,16M' right. ONE COLOUR vs plan for pill, bar fill and variance text (three colours, agreed 2026-09-17): green ON TRACK, amber AT RISK, red BEHIND, grey NO PLAN. Revenue thresholds (option B): >= 99% ON TRACK, >= 95% AT RISK, else BEHIND. Value = [Revenue], plan = [Revenue Plan]. FY2025: 20,16M, +2K vs plan, 100,0% of plan, ON TRACK. Visible wording says Plan, not Budget. Blank where Revenue is blank. ENCODING: fractional coordinates go through FORMAT(x, "0.0", "en-US"). Raw markup, no data URI. Leave the data category UNCATEGORISED.
	measure 'SVG KPI Card Revenue vs Plan HTML' =
			
			// ===== 1. CONFIG =====
			VAR _Title     = "Revenue vs Plan"
			VAR _Actual    = [Revenue]
			VAR _Plan      = [Revenue Plan]
			VAR _OnTrackAt = 0.99                            // revenue tolerance (option B)
			VAR _AtRiskAt  = 0.95
			
			// ===== 2. STATUS vs PLAN: one colour for pill, bar fill and variance text =====
			VAR _Ach = DIVIDE ( _Actual, _Plan )
			VAR _Status =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Ach ), "NO PLAN",
			        _Ach >= _OnTrackAt, "ON TRACK",
			        _Ach >= _AtRiskAt, "AT RISK",
			        "BEHIND"
			    )
			VAR _Col =
			    SWITCH ( _Status, "ON TRACK", "#107C41", "AT RISK", "#C77700", "BEHIND", "#C50F1F", "#605E5C" )
			
			// ===== 3. GEOMETRY: 315 x 120; full bar (16..299) = plan =====
			VAR _BarW  = 283
			VAR _FillW = _BarW * MAX ( 0, MIN ( 1, COALESCE ( _Ach, 0 ) ) )
			VAR _PillW = 16 + LEN ( _Status ) * 5.6
			VAR _PillX = 299 - _PillW
			
			// ===== 4. TEXT =====
			VAR _Eur = UNICHAR ( 8364 )
			VAR _FmtVal =
			    IF ( _Actual < 0, "-", "" ) & _Eur
			        & IF ( ABS ( _Actual ) >= 1000000, FORMAT ( ABS ( _Actual ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _Actual ) / 1000, "#,0" ) & "K" )
			VAR _FmtPlan =
			    IF ( _Plan < 0, "-", "" ) & _Eur
			        & IF ( ABS ( _Plan ) >= 1000000, FORMAT ( ABS ( _Plan ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _Plan ) / 1000, "#,0" ) & "K" )
			VAR _Gap = _Actual - _Plan
			VAR _FmtGap =
			    IF ( _Gap >= 0, "+", "-" )
			        & IF ( ABS ( _Gap ) >= 1000000, FORMAT ( ABS ( _Gap ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _Gap ) / 1000, "#,0" ) & "K" )
			VAR _GapLine  = IF ( ISBLANK ( _Ach ), "", _FmtGap & " vs plan" )
			VAR _PctLine  = IF ( ISBLANK ( _Ach ), "no plan set", FORMAT ( _Ach, "0.0%" ) & " of plan" )
			VAR _PlanLine = IF ( ISBLANK ( _Plan ), "", "Plan " & _FmtPlan )
			VAR _F        = "font-family='Segoe UI, Arial, sans-serif'"
			
			// ===== 5. RAW SVG, 315 x 120 =====
			RETURN
			    IF (
			        ISBLANK ( _Actual ),
			        BLANK (),
			        "<svg xmlns='http://www.w3.org/2000/svg' width='315' height='120' viewBox='0 0 315 120'>"
			            & "<rect x='0.5' y='0.5' width='314' height='119' rx='10' fill='#FFFFFF' stroke='#E7E9EF'/>"
			            & "<text x='16' y='24' " & _F & " font-size='11' font-weight='600' fill='#6B7280'>" & _Title & "</text>"
			            & "<rect x='" & FORMAT ( _PillX, "0.0", "en-US" ) & "' y='12' width='" & FORMAT ( _PillW, "0.0", "en-US" ) & "' height='18' rx='9' fill='" & _Col & "'/>"
			            & "<text x='" & FORMAT ( _PillX + _PillW / 2, "0.0", "en-US" ) & "' y='24.5' text-anchor='middle' " & _F & " font-size='9' font-weight='700' fill='#FFFFFF'>" & _Status & "</text>"
			            & "<text x='16' y='52' " & _F & " font-size='22' font-weight='700' fill='#111827'>" & _FmtVal & "</text>"
			            & "<text x='299' y='52' text-anchor='end' " & _F & " font-size='11' font-weight='600' fill='" & _Col & "'>" & _GapLine & "</text>"
			            & "<rect x='16' y='66' width='283' height='6' rx='3' fill='#EEF0F4'/>"
			            & IF ( _FillW > 0, "<rect x='16' y='66' width='" & FORMAT ( _FillW, "0.0", "en-US" ) & "' height='6' rx='3' fill='" & _Col & "'/>" )
			            & "<line x1='299' y1='61' x2='299' y2='77' stroke='#111827' stroke-width='2'/>"
			            & "<text x='16' y='98' " & _F & " font-size='11' fill='#6B7280'>" & _PctLine & "</text>"
			            & "<text x='299' y='98' text-anchor='end' " & _F & " font-size='11' font-weight='600' fill='#111827'>" & _PlanLine & "</text>"
			            & "</svg>"
			    )
		displayFolder: 13 HTML Cards
		lineageTag: 56fc3fdf-5f25-46ef-be67-dcc0fa3fd4a2

	/// COMPACT EBITDA vs Plan KPI card, RAW SVG MARKUP for the HTML Content custom visual, 315 x 120. REDESIGNED 2026-09-17 (plan-only family, identical layout to SVG KPI Card Revenue vs Plan HTML and SVG KPI Card EBITDA Margin vs Plan HTML): NO prior-year comparison. Layout: title and status pill on top; value 22px with the signed variance vs plan on the same line, right ('-1,12M vs plan'); progress bar where the FULL BAR = PLAN and the fill = EBITDA / EBITDA Plan (capped at 100%), black marker at the plan end; bottom line '64,3% of plan' left and 'Plan 3,13M' right. ONE COLOUR vs plan for pill, bar fill and variance text (three colours, agreed 2026-09-17): green ON TRACK, amber AT RISK, red BEHIND, grey NO PLAN. Profit thresholds (option A, same as SVG KPI Card AvB HTML): >= 100% ON TRACK, >= 90% AT RISK, else BEHIND. Value = [EBITDA], plan = [EBITDA Plan]. FY2025: 2,01M, -1,12M vs plan, 64,3% of plan, BEHIND. Visible wording says Plan, not Budget. Blank where EBITDA is blank. ENCODING: fractional coordinates go through FORMAT(x, "0.0", "en-US"). Raw markup, no data URI. Leave the data category UNCATEGORISED.
	measure 'SVG KPI Card EBITDA vs Plan HTML' =
			
			// ===== 1. CONFIG =====
			VAR _Title     = "EBITDA vs Plan"
			VAR _Actual    = [EBITDA]
			VAR _Plan      = [EBITDA Plan]
			VAR _OnTrackAt = 1.00                            // profit rules (option A)
			VAR _AtRiskAt  = 0.90
			
			// ===== 2. STATUS vs PLAN: one colour for pill, bar fill and variance text =====
			VAR _Ach = DIVIDE ( _Actual, _Plan )
			VAR _Status =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Ach ), "NO PLAN",
			        _Ach >= _OnTrackAt, "ON TRACK",
			        _Ach >= _AtRiskAt, "AT RISK",
			        "BEHIND"
			    )
			VAR _Col =
			    SWITCH ( _Status, "ON TRACK", "#107C41", "AT RISK", "#C77700", "BEHIND", "#C50F1F", "#605E5C" )
			
			// ===== 3. GEOMETRY: 315 x 120; full bar (16..299) = plan =====
			VAR _BarW  = 283
			VAR _FillW = _BarW * MAX ( 0, MIN ( 1, COALESCE ( _Ach, 0 ) ) )
			VAR _PillW = 16 + LEN ( _Status ) * 5.6
			VAR _PillX = 299 - _PillW
			
			// ===== 4. TEXT =====
			VAR _Eur = UNICHAR ( 8364 )
			VAR _FmtVal =
			    IF ( _Actual < 0, "-", "" ) & _Eur
			        & IF ( ABS ( _Actual ) >= 1000000, FORMAT ( ABS ( _Actual ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _Actual ) / 1000, "#,0" ) & "K" )
			VAR _FmtPlan =
			    IF ( _Plan < 0, "-", "" ) & _Eur
			        & IF ( ABS ( _Plan ) >= 1000000, FORMAT ( ABS ( _Plan ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _Plan ) / 1000, "#,0" ) & "K" )
			VAR _Gap = _Actual - _Plan
			VAR _FmtGap =
			    IF ( _Gap >= 0, "+", "-" )
			        & IF ( ABS ( _Gap ) >= 1000000, FORMAT ( ABS ( _Gap ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _Gap ) / 1000, "#,0" ) & "K" )
			VAR _GapLine  = IF ( ISBLANK ( _Ach ), "", _FmtGap & " vs plan" )
			VAR _PctLine  = IF ( ISBLANK ( _Ach ), "no plan set", FORMAT ( _Ach, "0.0%" ) & " of plan" )
			VAR _PlanLine = IF ( ISBLANK ( _Plan ), "", "Plan " & _FmtPlan )
			VAR _F        = "font-family='Segoe UI, Arial, sans-serif'"
			
			// ===== 5. RAW SVG, 315 x 120 =====
			RETURN
			    IF (
			        ISBLANK ( _Actual ),
			        BLANK (),
			        "<svg xmlns='http://www.w3.org/2000/svg' width='315' height='120' viewBox='0 0 315 120'>"
			            & "<rect x='0.5' y='0.5' width='314' height='119' rx='10' fill='#FFFFFF' stroke='#E7E9EF'/>"
			            & "<text x='16' y='24' " & _F & " font-size='11' font-weight='600' fill='#6B7280'>" & _Title & "</text>"
			            & "<rect x='" & FORMAT ( _PillX, "0.0", "en-US" ) & "' y='12' width='" & FORMAT ( _PillW, "0.0", "en-US" ) & "' height='18' rx='9' fill='" & _Col & "'/>"
			            & "<text x='" & FORMAT ( _PillX + _PillW / 2, "0.0", "en-US" ) & "' y='24.5' text-anchor='middle' " & _F & " font-size='9' font-weight='700' fill='#FFFFFF'>" & _Status & "</text>"
			            & "<text x='16' y='52' " & _F & " font-size='22' font-weight='700' fill='#111827'>" & _FmtVal & "</text>"
			            & "<text x='299' y='52' text-anchor='end' " & _F & " font-size='11' font-weight='600' fill='" & _Col & "'>" & _GapLine & "</text>"
			            & "<rect x='16' y='66' width='283' height='6' rx='3' fill='#EEF0F4'/>"
			            & IF ( _FillW > 0, "<rect x='16' y='66' width='" & FORMAT ( _FillW, "0.0", "en-US" ) & "' height='6' rx='3' fill='" & _Col & "'/>" )
			            & "<line x1='299' y1='61' x2='299' y2='77' stroke='#111827' stroke-width='2'/>"
			            & "<text x='16' y='98' " & _F & " font-size='11' fill='#6B7280'>" & _PctLine & "</text>"
			            & "<text x='299' y='98' text-anchor='end' " & _F & " font-size='11' font-weight='600' fill='#111827'>" & _PlanLine & "</text>"
			            & "</svg>"
			    )
		displayFolder: 13 HTML Cards
		lineageTag: e921c69c-4cd3-4849-92e2-b4e5f9eac331

	/// COMPACT EBITDA Margin vs Plan KPI card, RAW SVG MARKUP for the HTML Content custom visual, 315 x 120. REDESIGNED 2026-09-17 (plan-only family, identical layout to SVG KPI Card Revenue vs Plan HTML and SVG KPI Card EBITDA vs Plan HTML): NO prior-year comparison. Layout: title and status pill on top; actual margin 22px with the pp variance vs plan on the same line, right ('-5,5 pp vs plan'); progress bar where the FULL BAR = PLAN MARGIN and the fill = actual margin / plan margin (capped at 100%), black marker at the plan end - replaces the earlier shared-scale bar with the marker mid-bar; bottom line '64,3% of plan margin' left and 'Plan 15,5%' right. Now reads the helper measures EBITDA Margin % Plan and EBITDA Margin Variance pp, so the definition lives in one place. ONE COLOUR vs plan for pill, bar fill and variance text (three colours): green ON TRACK, amber AT RISK, red BEHIND, grey NO PLAN. Thresholds in pp (option A), on the variance rounded to 0.1 pp: >= 0 pp ON TRACK, >= -1 pp AT RISK, else BEHIND. FY2025: 10,0%, -5,5 pp vs plan, 64,3% of plan margin, BEHIND. Visible wording says Plan, not Budget. Blank where the margin is blank. ENCODING: fractional coordinates go through FORMAT(x, "0.0", "en-US"). Raw markup, no data URI. Leave the data category UNCATEGORISED.
	measure 'SVG KPI Card EBITDA Margin vs Plan HTML' =
			
			// ===== 1. CONFIG =====
			VAR _Title     = "EBITDA Margin vs Plan"
			VAR _Act       = [EBITDA Margin %]
			VAR _Plan      = [EBITDA Margin % Plan]
			VAR _Var       = [EBITDA Margin Variance pp]     // actual - plan margin, as a fraction
			VAR _OnTrackAt = 0                               // pp thresholds (option A)
			VAR _AtRiskAt  = -0.01
			
			// ===== 2. STATUS vs PLAN: one colour for pill, bar fill and variance text =====
			VAR _VarR = ROUND ( _Var, 3 )                    // 0.1 pp, same precision as displayed
			VAR _Status =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Var ), "NO PLAN",
			        _VarR >= _OnTrackAt, "ON TRACK",
			        _VarR >= _AtRiskAt, "AT RISK",
			        "BEHIND"
			    )
			VAR _Col =
			    SWITCH ( _Status, "ON TRACK", "#107C41", "AT RISK", "#C77700", "BEHIND", "#C50F1F", "#605E5C" )
			
			// ===== 3. GEOMETRY: 315 x 120; full bar (16..299) = plan margin =====
			VAR _Ratio = DIVIDE ( _Act, _Plan )
			VAR _BarW  = 283
			VAR _FillW = _BarW * MAX ( 0, MIN ( 1, COALESCE ( _Ratio, 0 ) ) )
			VAR _PillW = 16 + LEN ( _Status ) * 5.6
			VAR _PillX = 299 - _PillW
			
			// ===== 4. TEXT =====
			VAR _ValText  = FORMAT ( _Act, "0.0%" )
			VAR _GapLine  = IF ( ISBLANK ( _Var ), "", FORMAT ( _VarR * 100, "+0.0;-0.0;0.0" ) & " pp vs plan" )
			VAR _PctLine  = IF ( ISBLANK ( _Ratio ), "no plan set", FORMAT ( _Ratio, "0.0%" ) & " of plan margin" )
			VAR _PlanLine = IF ( ISBLANK ( _Plan ), "", "Plan " & FORMAT ( _Plan, "0.0%" ) )
			VAR _F        = "font-family='Segoe UI, Arial, sans-serif'"
			
			// ===== 5. RAW SVG, 315 x 120 =====
			RETURN
			    IF (
			        ISBLANK ( _Act ),
			        BLANK (),
			        "<svg xmlns='http://www.w3.org/2000/svg' width='315' height='120' viewBox='0 0 315 120'>"
			            & "<rect x='0.5' y='0.5' width='314' height='119' rx='10' fill='#FFFFFF' stroke='#E7E9EF'/>"
			            & "<text x='16' y='24' " & _F & " font-size='11' font-weight='600' fill='#6B7280'>" & _Title & "</text>"
			            & "<rect x='" & FORMAT ( _PillX, "0.0", "en-US" ) & "' y='12' width='" & FORMAT ( _PillW, "0.0", "en-US" ) & "' height='18' rx='9' fill='" & _Col & "'/>"
			            & "<text x='" & FORMAT ( _PillX + _PillW / 2, "0.0", "en-US" ) & "' y='24.5' text-anchor='middle' " & _F & " font-size='9' font-weight='700' fill='#FFFFFF'>" & _Status & "</text>"
			            & "<text x='16' y='52' " & _F & " font-size='22' font-weight='700' fill='#111827'>" & _ValText & "</text>"
			            & "<text x='299' y='52' text-anchor='end' " & _F & " font-size='11' font-weight='600' fill='" & _Col & "'>" & _GapLine & "</text>"
			            & "<rect x='16' y='66' width='283' height='6' rx='3' fill='#EEF0F4'/>"
			            & IF ( _FillW > 0, "<rect x='16' y='66' width='" & FORMAT ( _FillW, "0.0", "en-US" ) & "' height='6' rx='3' fill='" & _Col & "'/>" )
			            & "<line x1='299' y1='61' x2='299' y2='77' stroke='#111827' stroke-width='2'/>"
			            & "<text x='16' y='98' " & _F & " font-size='11' fill='#6B7280'>" & _PctLine & "</text>"
			            & "<text x='299' y='98' text-anchor='end' " & _F & " font-size='11' font-weight='600' fill='#111827'>" & _PlanLine & "</text>"
			            & "</svg>"
			    )
		displayFolder: 13 HTML Cards
		lineageTag: 6a94d325-6da6-4f3e-b254-dc848988ea3b

	/// Planned EBITDA margin = EBITDA Plan / Revenue Plan. The plan counterpart of EBITDA Margin %, recalculated from plan totals at every level rather than averaged. 2025: 3,125,979 / 20,157,390 = 15,5%; 2024: 15,6%; 2023: 14,8%. Blank where Revenue Plan is blank or zero. Same definition as the plan margin inside SVG KPI Card EBITDA Margin vs Plan HTML.
	measure 'EBITDA Margin % Plan' = DIVIDE ( [EBITDA Plan], [Revenue Plan] )
		formatString: 0.0%
		displayFolder: 02 Variance
		lineageTag: 3a29b2d2-0916-43d0-b387-fc115909c657

	/// EBITDA margin variance to plan, in PERCENTAGE POINTS: EBITDA Margin % minus EBITDA Margin % Plan. A subtraction of two margins, not a percent change of a percent: 2025 9,97% - 15,51% = -5,5 pp. Stored as a fraction (-0.055) so it composes with other DAX, the same convention as EBITDA Margin YoY; the format string shows it as -5,5% - multiply by 100 and append ' pp' for a label, as SVG KPI Card EBITDA Margin vs Plan HTML does. Positive = margin above plan (favourable). Blank where either margin is blank.
	measure 'EBITDA Margin Variance pp' =
			
			VAR _Act  = [EBITDA Margin %]
			VAR _Plan = [EBITDA Margin % Plan]
			RETURN
			    IF ( NOT ISBLANK ( _Act ) && NOT ISBLANK ( _Plan ), _Act - _Plan )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 02 Variance
		lineageTag: 24779c56-0404-4e19-b8b5-ea72c8f0a550

	/// Variance (Actual - Plan) returned ONLY when the filter context is the Production cost center, blank for every other cost center. Built for the report page tooltip on the 'Variance by cost center' chart (option B, 2026-09-17): the tooltip page shows variance by account, and because this measure is blank outside Production, hovering any other bar shows no account bars. Same sign convention as Variance: negative = costs above plan (unfavourable). 2025 Production by account: Raw Materials -490,275; Energy -129,299; Personnel -90,000; Depreciation -21,295; External Services -2,701; Other Operating Expenses +869; total -732,700. Colour it with Variance Colour. Requires exactly one cost center in context (SELECTEDVALUE), which a tooltip on a cost-center axis provides.
	measure 'Variance Production Only' =
			
			IF (
			    SELECTEDVALUE ( dim_cost_center[cost_center_name] ) = "Production",
			    [Variance]
			)
		formatString: #,##0
		displayFolder: 02 Variance
		lineageTag: fc0c2a09-e3a6-4354-b72b-9df5a58fee49

	/// Heading text for the Production variance tooltip page. Returns 'Production: variance by account' when the hovered cost center is Production, otherwise 'Account detail available for Production only', so the tooltip on the other bars explains why its chart is empty instead of showing a blank box. Use in a card or as the tooltip chart's title (Format > General > Title > Text > fx > Field value). Pairs with Variance Production Only.
	measure 'Tooltip Production Note' =
			
			IF (
			    SELECTEDVALUE ( dim_cost_center[cost_center_name] ) = "Production",
			    "Production: variance by account",
			    "Account detail available for Production only"
			)
		displayFolder: 02 Variance
		lineageTag: e1e58da7-ce1f-4090-a89b-7f4df7ffddc3

	/// Display version of Variance (Actual - Plan) for variance matrices. On EXPENSE rows (SELECTEDVALUE dim_account[account_type] = "Expense", i.e. cost categories and cost accounts) the sign is flipped so the number shows the DIRECTION of the cost itself: Material Costs 2025 reads +490.275 (costs above plan), not -490.275. Revenue rows and mixed rows such as the matrix Total (operating result) keep the Variance sign. Whether a value is good or bad is carried by the font colour: use Variance Colour, which is keyed on the unflipped Variance. Plan and Actual columns stay signed as stored (costs negative), by decision 2026-09-17. Variance itself is untouched, so all other visuals are unaffected. Pairs with Variance % vs Plan Label.
	measure 'Variance (Display)' =
			
			VAR _Type = SELECTEDVALUE ( dim_account[account_type] )
			VAR _Var  = [Variance]
			RETURN
			    IF ( _Type = "Expense", - _Var, _Var )
		formatString: +#,##0;-#,##0;0
		displayFolder: 02 Variance
		lineageTag: 8efc3949-5037-461f-8d13-1010113300ba

	/// Display label for the Variance % column of variance matrices, e.g. '▲ +7,0%'. Built on Variance %, which uses the impact sign (negative = unfavourable) because costs are stored negative. On EXPENSE rows (SELECTEDVALUE dim_account[account_type] = "Expense") the sign is flipped, so number and arrow show the DIRECTION the cost moved vs plan: Material Costs 2025 '▲ +7,0%', Energy '▲ +30,6%'. Revenue rows and the Total keep the Variance % sign (Product Revenue '▼ -0,1%', Total '▼ -47,1%'). Arrow and sign decided on the value rounded to 0.1%, so a flat row reads '▬ 0,0%'. Colour with Variance Colour (good/bad). Same pattern as P&L YoY vs PY Label. Blank where Variance % is blank.
	measure 'Variance % vs Plan Label' =
			
			VAR _Type    = SELECTEDVALUE ( dim_account[account_type] )
			VAR _Pct     = [Variance %]                     // impact sign: + favourable
			VAR _Move    = IF ( _Type = "Expense", - _Pct, _Pct )
			VAR _Rounded = ROUND ( _Move, 3 )
			VAR _Arrow   = SWITCH ( TRUE (), _Rounded > 0, "▲", _Rounded < 0, "▼", "▬" )
			RETURN
			    IF (
			        NOT ISBLANK ( _Pct ),
			        _Arrow & " " & FORMAT ( _Rounded, "+0.0%;-0.0%;0.0%" )
			    )
		displayFolder: 02 Variance
		lineageTag: 3da1b9fa-d0da-4719-9d01-436f8bb87c05

	/// Y value for the Plan-to-Actual EBITDA waterfall (native waterfall, category EBITDA_Plan_Bridge[Step]). Plan EBITDA = [EBITDA Plan] as the starting bar; then variances with positive = favourable to EBITDA: Revenue = Revenue - Revenue Plan; COGS = -(COGS - COGS plan), COGS plan built exactly like [COGS] but on Budget (Production cost center, expense accounts, excluding depreciation); Operating Expenses = -(OpEx actual - OpEx plan) with OpEx = Revenue - COGS - EBITDA, i.e. every cost between Gross Profit and EBITDA. The steps reconcile by construction: Plan EBITDA + the three variances = [EBITDA], which the waterfall shows as its Total bar. 2025: 3,125,979 + 2,339 - 711,404 - 406,678 = 2,010,236. SUMX over EBITDA_Plan_Bridge so the Total is right whether the visual sums the bars or evaluates with no step selected. Works for any period with a plan (2023-2025), including several years. COMPANY LEVEL: COGS is a Production cost-center definition, so a cost-center filter breaks the split.
	measure 'EBITDA Plan Bridge Value' =
			
			VAR _EBITDA      = [EBITDA]
			VAR _EBITDAPlan  = [EBITDA Plan]
			VAR _Rev         = [Revenue]
			VAR _RevPlan     = [Revenue Plan]
			VAR _COGS        = [COGS]
			VAR _COGSPlan =
			    - CALCULATE (
			        [Budget],
			        KEEPFILTERS ( dim_account[account_type] = "Expense" ),
			        KEEPFILTERS ( dim_account[account_category] <> "Depreciation" ),
			        KEEPFILTERS ( dim_cost_center[cost_center_name] = "Production" )
			    )
			// OpEx = everything between Gross Profit and EBITDA
			VAR _OpEx        = _Rev - _COGS - _EBITDA
			VAR _OpExPlan    = _RevPlan - _COGSPlan - _EBITDAPlan
			
			VAR _RevVar  = _Rev - _RevPlan
			VAR _COGSVar = - ( _COGS - _COGSPlan )
			VAR _OpExVar = - ( _OpEx - _OpExPlan )
			
			RETURN
			    IF (
			        NOT ISBLANK ( _EBITDAPlan ),
			        SUMX (
			            EBITDA_Plan_Bridge,
			            SWITCH (
			                EBITDA_Plan_Bridge[Step],
			                "Plan EBITDA",        _EBITDAPlan,
			                "Revenue",            _RevVar,
			                "COGS",               _COGSVar,
			                "Operating Expenses", _OpExVar
			            )
			        )
			    )
		formatString: #,##0
		displayFolder: 11 Bridge
		lineageTag: 95fdbb7f-da57-4497-81ec-a46b26cf2cbe

	/// Dynamic title for the Plan-to-Actual EBITDA waterfall, e.g. 'EBITDA Plan → Actual FY2025', following the year slicer; 'EBITDA Plan → Actual' when several or no years are selected. Visible wording says Plan, not Budget. Apply via Format > General > Title > Text > fx > Field value.
	measure 'EBITDA Plan Bridge Title' =
			
			IF (
			    HASONEVALUE ( dim_date[year] ),
			    "EBITDA Plan " & UNICHAR ( 8594 ) & " Actual FY" & FORMAT ( MAX ( dim_date[year] ), "0" ),
			    "EBITDA Plan " & UNICHAR ( 8594 ) & " Actual"
			)
		displayFolder: 11 Bridge
		lineageTag: e8c0cdf1-fbb5-4047-8f8e-4e23dc51beb1

	/// COMPACT COGS vs Plan KPI card, RAW SVG MARKUP for the HTML Content custom visual, 315 x 120. Member of the plan-only card family (same layout as SVG KPI Card Revenue vs Plan HTML / EBITDA vs Plan HTML / EBITDA Margin vs Plan HTML), adapted for a COST line where LOWER IS BETTER. Value = [COGS]; plan = the same COGS definition applied to Budget (Production cost center, expense accounts, excluding depreciation), calculated inline. Status on COGS / plan rounded to 0.1% (option A, agreed 2026-09-17): <= 100% ON TRACK green, <= 102% AT RISK amber, above OVER PLAN red, NO PLAN grey; one colour for pill, bar fill and variance text. Variance text is signed in the cost's own direction: '+711K vs plan' = costs above plan (red). BAR: scale = the higher of actual and plan. Under plan the full bar = plan and the marker sits at the end (like the other cards); OVER plan the full bar = actual and the black plan marker moves inside the bar, so the part beyond the marker is the overrun (2025: marker at 93%). Bottom line '107,2% of plan' left, 'Plan 9,88M' right. FY2025: 10,59M, +711K vs plan, OVER PLAN; 2024: 102,8% OVER PLAN; 2023: 99,7% ON TRACK. COMPANY LEVEL, inherited from COGS. Visible wording says Plan, not Budget. ENCODING: fractional coordinates go through FORMAT(x, "0.0", "en-US"). Raw markup, no data URI. Leave the data category UNCATEGORISED.
	measure 'SVG KPI Card COGS vs Plan HTML' =
			
			// ===== 1. CONFIG =====
			VAR _Title     = "COGS vs Plan"
			VAR _Actual    = [COGS]
			VAR _Plan =
			    - CALCULATE (
			        [Budget],
			        KEEPFILTERS ( dim_account[account_type] = "Expense" ),
			        KEEPFILTERS ( dim_account[account_category] <> "Depreciation" ),
			        KEEPFILTERS ( dim_cost_center[cost_center_name] = "Production" )
			    )
			VAR _OnTrackAt = 1.00                            // cost: at or below plan (option A)
			VAR _AtRiskAt  = 1.02
			
			// ===== 2. STATUS vs PLAN (lower is better): one colour for pill, bar fill and variance text =====
			VAR _Ach  = DIVIDE ( _Actual, _Plan )
			VAR _AchR = ROUND ( _Ach, 3 )
			VAR _Status =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Ach ), "NO PLAN",
			        _AchR <= _OnTrackAt, "ON TRACK",
			        _AchR <= _AtRiskAt, "AT RISK",
			        "OVER PLAN"
			    )
			VAR _Col =
			    SWITCH ( _Status, "ON TRACK", "#107C41", "AT RISK", "#C77700", "OVER PLAN", "#C50F1F", "#605E5C" )
			
			// ===== 3. GEOMETRY: 315 x 120; bar 16..299 scaled to the higher of actual and plan =====
			VAR _BarX  = 16
			VAR _BarW  = 283
			VAR _Scale = MAX ( MAX ( COALESCE ( _Actual, 0 ), COALESCE ( _Plan, 0 ) ), 0 )
			VAR _FillW = IF ( _Scale > 0, _BarW * MAX ( 0, COALESCE ( _Actual, 0 ) ) / _Scale, 0 )
			VAR _MarkX = IF ( _Scale > 0 && NOT ISBLANK ( _Plan ), _BarX + _BarW * MAX ( 0, _Plan ) / _Scale )
			VAR _PillW = 16 + LEN ( _Status ) * 5.6
			VAR _PillX = 299 - _PillW
			
			// ===== 4. TEXT =====
			VAR _Eur = UNICHAR ( 8364 )
			VAR _FmtVal =
			    IF ( _Actual < 0, "-", "" ) & _Eur
			        & IF ( ABS ( _Actual ) >= 1000000, FORMAT ( ABS ( _Actual ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _Actual ) / 1000, "#,0" ) & "K" )
			VAR _FmtPlan =
			    IF ( _Plan < 0, "-", "" ) & _Eur
			        & IF ( ABS ( _Plan ) >= 1000000, FORMAT ( ABS ( _Plan ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _Plan ) / 1000, "#,0" ) & "K" )
			VAR _Gap = _Actual - _Plan                        // + = costs above plan
			VAR _FmtGap =
			    IF ( _Gap >= 0, "+", "-" )
			        & IF ( ABS ( _Gap ) >= 1000000, FORMAT ( ABS ( _Gap ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _Gap ) / 1000, "#,0" ) & "K" )
			VAR _GapLine  = IF ( ISBLANK ( _Ach ), "", _FmtGap & " vs plan" )
			VAR _PctLine  = IF ( ISBLANK ( _Ach ), "no plan set", FORMAT ( _Ach, "0.0%" ) & " of plan" )
			VAR _PlanLine = IF ( ISBLANK ( _Plan ), "", "Plan " & _FmtPlan )
			VAR _F        = "font-family='Segoe UI, Arial, sans-serif'"
			
			// ===== 5. RAW SVG, 315 x 120 =====
			RETURN
			    IF (
			        ISBLANK ( _Actual ),
			        BLANK (),
			        "<svg xmlns='http://www.w3.org/2000/svg' width='315' height='120' viewBox='0 0 315 120'>"
			            & "<rect x='0.5' y='0.5' width='314' height='119' rx='10' fill='#FFFFFF' stroke='#E7E9EF'/>"
			            & "<text x='16' y='24' " & _F & " font-size='11' font-weight='600' fill='#6B7280'>" & _Title & "</text>"
			            & "<rect x='" & FORMAT ( _PillX, "0.0", "en-US" ) & "' y='12' width='" & FORMAT ( _PillW, "0.0", "en-US" ) & "' height='18' rx='9' fill='" & _Col & "'/>"
			            & "<text x='" & FORMAT ( _PillX + _PillW / 2, "0.0", "en-US" ) & "' y='24.5' text-anchor='middle' " & _F & " font-size='9' font-weight='700' fill='#FFFFFF'>" & _Status & "</text>"
			            & "<text x='16' y='52' " & _F & " font-size='22' font-weight='700' fill='#111827'>" & _FmtVal & "</text>"
			            & "<text x='299' y='52' text-anchor='end' " & _F & " font-size='11' font-weight='600' fill='" & _Col & "'>" & _GapLine & "</text>"
			            & "<rect x='16' y='66' width='283' height='6' rx='3' fill='#EEF0F4'/>"
			            & IF ( _FillW > 0, "<rect x='16' y='66' width='" & FORMAT ( _FillW, "0.0", "en-US" ) & "' height='6' rx='3' fill='" & _Col & "'/>" )
			            & IF (
			                NOT ISBLANK ( _MarkX ),
			                "<line x1='" & FORMAT ( _MarkX, "0.0", "en-US" ) & "' y1='61' x2='" & FORMAT ( _MarkX, "0.0", "en-US" ) & "' y2='77' stroke='#111827' stroke-width='2'/>"
			            )
			            & "<text x='16' y='98' " & _F & " font-size='11' fill='#6B7280'>" & _PctLine & "</text>"
			            & "<text x='299' y='98' text-anchor='end' " & _F & " font-size='11' font-weight='600' fill='#111827'>" & _PlanLine & "</text>"
			            & "</svg>"
			    )
		displayFolder: 13 HTML Cards
		lineageTag: bc795916-8515-48c5-b7ad-1a4f4b01cfb9

	/// Forecast revenue: the forecast restricted to revenue accounts. Same pattern as Revenue Plan (ignores account slicers). FY2026: 19,728,870 vs Revenue Plan 21,736,893.
	measure 'Revenue Forecast' =
			CALCULATE (
			    [Forecast],
			    REMOVEFILTERS ( dim_account ),
			    dim_account[account_category] = "Revenue"
			)
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: f2069489-1bff-4eed-bcf5-2f87253e2b6e

	/// Forecast depreciation, returned positive for display. Mirrors Depreciation and Depreciation Plan so EBITDA Forecast can add it back. FY2026: 745,013.
	measure 'Depreciation Forecast' =
			- CALCULATE (
			    [Forecast],
			    REMOVEFILTERS ( dim_account ),
			    dim_account[account_category] = "Depreciation"
			)
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 902d0ba4-b05d-48ea-81a5-9c4eb5259133

	/// Forecast EBITDA: the full forecast (= forecast operating result under the sign convention) with forecast depreciation added back. Mirrors EBITDA Plan. FY2026: -107,051 + 745,013 = 637,962.
	measure 'EBITDA Forecast' = CALCULATE ( [Forecast], REMOVEFILTERS ( dim_account ) ) + [Depreciation Forecast]
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: f264ba29-eb0b-40bd-9f5d-f9cbcac2a584

	/// Year-to-date cumulative forecast operating result. Jan-Jun equals Actual YTD by construction, Jul-Dec adds the forecast months. FY2026 ends at -107,051. Requires dim_date marked as a date table.
	measure 'Forecast YTD' = CALCULATE ( [Forecast], DATESYTD ( dim_date[date] ) )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: dda86ecf-bf10-46f2-b9e3-3e35aeedbeb2

	/// Year-to-date cumulative Plan operating result. Plan counterpart of Forecast YTD. FY2026 ends at 2,722,099.
	measure 'Plan YTD' = CALCULATE ( [Budget], DATESYTD ( dim_date[date] ) )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: a4769510-f063-4249-9b3d-0034388e7a41

	/// Y value for the Plan-to-Forecast operating result waterfall (native waterfall, category Forecast_Plan_Bridge[Step]). Plan = full-year Plan operating result as the starting bar; every other step = Forecast minus Plan for that account category, positive = favourable (sign convention: revenue positive, cost negative). Reconciles by construction: Plan + the six category gaps = Forecast, shown as the waterfall's Total bar. FY2026: 2,722,099 - 2,008,024 (Revenue) - 80,817 (Material) - 200,673 (Personnel) - 516,851 (OpEx) - 24,201 (Depreciation) + 1,416 (Other) = -107,051. SUMX so the total is right with no step selected.
	measure 'Forecast Plan Bridge Value' =
			VAR _Plan =
			    CALCULATE ( [Budget], REMOVEFILTERS ( dim_account ) )
			RETURN
			    IF (
			        NOT ISBLANK ( _Plan ),
			        SUMX (
			            Forecast_Plan_Bridge,
			            VAR _Step = Forecast_Plan_Bridge[Step]
			            RETURN
			                IF (
			                    _Step = "Plan",
			                    _Plan,
			                    CALCULATE (
			                        [Forecast] - [Budget],
			                        REMOVEFILTERS ( dim_account ),
			                        dim_account[account_category] = _Step
			                    )
			                )
			        )
			    )
		formatString: #,##0
		displayFolder: 11 Bridge
		lineageTag: 1e9bb6eb-c088-419b-9c74-c3b7f6dbd894

	/// Operating result effect of a forecast event as included in the Plan. Sign convention: revenue positive, cost negative. SSM-1: 180,000; customer loss: 0 (not planned).
	measure 'Event Plan' = SUM ( fact_forecast_events[plan_amount] )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: ac52a49a-9eb4-4d4a-b315-dadef01b9cbb

	/// Operating result effect of a forecast event as included in the Forecast. fact_forecast already contains these amounts; this measure only makes them visible per event. SSM-1: 180,000; customer loss: -776,885.
	measure 'Event Forecast' = SUM ( fact_forecast_events[forecast_amount] )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: a91c276d-e67c-49d0-a629-c5ccb7eb5da3

	/// How much of the Forecast-vs-Plan gap an event explains: Event Forecast minus Event Plan. Negative = unfavourable. SSM-1: 0 (on plan); customer loss: -776,885. Both events: -776,885 of the -2,829,150 total gap.
	measure 'Event Impact vs Plan' =
			VAR _F = [Event Forecast]
			VAR _P = [Event Plan]
			RETURN
			    IF ( ISBLANK ( _F ) && ISBLANK ( _P ), BLANK (), _F - _P )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 98570ce8-4ef1-420d-ab08-84ad39cbc3bc

	/// Font colour for the Forecast page card captions. Green when the Forecast operating result is above Plan, red when below. Same colours as Variance Colour.
	measure 'Forecast vs Plan Colour' =
			VAR _Value = [Forecast vs Budget]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _Value ), BLANK (),
			        _Value > 0, "#107C41",
			        _Value < 0, "#C50F1F",
			        "#605E5C"
			    )
		displayFolder: 09 Formatting
		lineageTag: a49d237e-4a97-4a4c-b56b-9d82dce33149

	/// Card caption for the Forecast operating result, e.g. 'Plan 2,72M · ▼ -2,83M' for 2026. M/K formatting as Actual to Plan Caption.
	measure 'Forecast Caption' =
			VAR _P = CALCULATE ( [Budget], REMOVEFILTERS ( dim_account ) )
			VAR _G = [Forecast vs Budget]
			VAR _FmtP = IF ( _P < 0, "-", "" ) & IF ( ABS ( _P ) >= 1000000, FORMAT ( ABS ( _P ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _P ) / 1000, "#,0" ) & "K" )
			VAR _FmtG = IF ( _G < 0, "-", "+" ) & IF ( ABS ( _G ) >= 1000000, FORMAT ( ABS ( _G ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _G ) / 1000, "#,0" ) & "K" )
			RETURN
			    IF ( NOT ISBLANK ( _P ), "Plan " & _FmtP & "  ·  " & IF ( _G < 0, "▼ ", "▲ " ) & _FmtG )
		displayFolder: 06 Forecast
		lineageTag: 7e5b5bfa-4a7c-4bf6-a37e-6acfcf3d80b9

	/// Card caption for Revenue Forecast, e.g. 'Plan 21,74M · ▼ -9,2%' for 2026.
	measure 'Revenue Forecast Caption' =
			VAR _P = [Revenue Plan]
			VAR _F = [Revenue Forecast]
			VAR _Pct = DIVIDE ( _F - _P, ABS ( _P ) )
			VAR _FmtP = IF ( ABS ( _P ) >= 1000000, FORMAT ( _P / 1000000, "0.00" ) & "M", FORMAT ( _P / 1000, "#,0" ) & "K" )
			RETURN
			    IF ( NOT ISBLANK ( _P ), "Plan " & _FmtP & "  ·  " & IF ( _Pct < 0, "▼ ", "▲ +" ) & FORMAT ( _Pct, "0.0%" ) )
		displayFolder: 06 Forecast
		lineageTag: 25ee2e3b-37cf-422b-949a-78571dcc6fb1

	/// Card caption for EBITDA Forecast, e.g. 'Plan 3,44M · ▼ -2,80M' for 2026.
	measure 'EBITDA Forecast Caption' =
			VAR _P = [EBITDA Plan]
			VAR _G = [EBITDA Forecast] - _P
			VAR _FmtP = IF ( _P < 0, "-", "" ) & IF ( ABS ( _P ) >= 1000000, FORMAT ( ABS ( _P ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _P ) / 1000, "#,0" ) & "K" )
			VAR _FmtG = IF ( _G < 0, "-", "+" ) & IF ( ABS ( _G ) >= 1000000, FORMAT ( ABS ( _G ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _G ) / 1000, "#,0" ) & "K" )
			RETURN
			    IF ( NOT ISBLANK ( _P ), "Plan " & _FmtP & "  ·  " & IF ( _G < 0, "▼ ", "▲ " ) & _FmtG )
		displayFolder: 06 Forecast
		lineageTag: 7668fc20-339a-48a8-9d15-8656f61a3dd0

	/// Card caption for the Gap to Plan card, e.g. '▼ -103,9% of Plan' for 2026.
	measure 'Forecast Gap Caption' =
			VAR _Pct = [Forecast vs Budget %]
			RETURN
			    IF ( NOT ISBLANK ( _Pct ), IF ( _Pct < 0, "▼ ", "▲ +" ) & FORMAT ( _Pct, "0.0%" ) & " of Plan" )
		displayFolder: 06 Forecast
		lineageTag: a7ea0c9c-6d1c-45e1-a57d-de33f2c94f94

	/// Month-end trade receivables, FORECAST series (is_forecast = TRUE). 2026 only; Jan-Jun repeats the actual balances. Dec 2026: 2,997,897.
	measure 'Accounts Receivable Forecast' =
			LASTNONBLANKVALUE (
			    dim_date[date],
			    CALCULATE ( SUM ( fact_working_capital[ar_balance] ), fact_working_capital[is_forecast] = TRUE )
			)
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 8532e44d-39f6-4a8d-b6cc-2a3943c1f0ef

	/// Month-end inventory, FORECAST series. Jul-Dec derived from forecast material consumption at the H1 2026 stock level (DIO 65.5 days).
	measure 'Inventory Forecast' =
			LASTNONBLANKVALUE (
			    dim_date[date],
			    CALCULATE ( SUM ( fact_working_capital[inventory_balance] ), fact_working_capital[is_forecast] = TRUE )
			)
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 16796585-927e-4719-96f1-c2fa5b429dbf

	/// Month-end trade payables, FORECAST series. Jul-Dec derived from forecast purchased cost at the H1 2026 supplier terms (DPO 36.0 days).
	measure 'Accounts Payable Forecast' =
			LASTNONBLANKVALUE (
			    dim_date[date],
			    CALCULATE ( SUM ( fact_working_capital[ap_balance] ), fact_working_capital[is_forecast] = TRUE )
			)
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 9e681105-b631-49c9-9f5e-17787a261542

	/// Forecast net working capital: AR plus inventory less AP, closing balance of the period. Dec 2026: 3,139,346 against 2,918,441 at Dec 2025.
	measure 'Net Working Capital Forecast' = [Accounts Receivable Forecast] + [Inventory Forecast] - [Accounts Payable Forecast]
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 6ef3df66-93f8-4beb-b141-403d0ed99dc1

	/// Forecast capital expenditure, 2026 full year: 787,262, i.e. 1.06x forecast depreciation, in line with 2023-2025. NO management reaction to the customer loss is modelled - deferring capex stays a lever for the reader, not a built-in assumption.
	measure 'Capex Forecast' = CALCULATE ( SUM ( fact_capex[capex_amount] ), fact_capex[is_forecast] = TRUE )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: f6048ddc-b5f2-4447-8fd5-0ede50a73f6e

	/// Change in net working capital across the forecast period: forecast closing balance less the balance immediately before it. The opening reads the FORECAST series first and falls back to the ACTUAL series when no forecast balance exists before the period - which is what happens in January 2026, where the opening is the December 2025 actual. The fallback matters at MONTHLY grain: without it August would be compared against June (the last actual month) instead of July, and every month after June would overstate the movement. Positive means working capital absorbs cash. FY2026: 3,139,346 - 2,918,441 = 220,905; the twelve monthly movements sum to the same figure.
	measure 'Delta NWC Forecast' =
			VAR _PeriodStart = MIN ( dim_date[date] )
			VAR _Closing = [Net Working Capital Forecast]
			VAR _OpeningForecast =
			    CALCULATE (
			        [Net Working Capital Forecast],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[date] < _PeriodStart
			    )
			VAR _OpeningActual =
			    CALCULATE (
			        [Net Working Capital],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[date] < _PeriodStart
			    )
			VAR _Opening = COALESCE ( _OpeningForecast, _OpeningActual )
			RETURN
			    IF ( NOT ISBLANK ( _Closing ) && NOT ISBLANK ( _Opening ), _Closing - _Opening )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 88981d49-81fe-4f6d-9334-b91fb3040db2

	/// Forecast corporate tax, returned positive for display. 29.825% (Koerperschaftsteuer 15.825% plus Gewerbesteuer 14%) accrued MONTH BY MONTH on profitable months only, with no refund in loss months - the same convention fact_tax follows for 2023-2025. Iterates dim_date[year_month] so the monthly rule survives any period selection. FY2026: 119,843, of which 98,395 is already actual in fact_tax for Jan-Jun. NOTE: on a full-year basis a loss-making year would pay no tax at all and the accrual would reverse; this measure deliberately mirrors the dataset's monthly convention instead.
	measure 'Tax Forecast' =
			VAR _Rate = 0.29825
			RETURN
			    SUMX (
			        VALUES ( dim_date[year_month] ),
			        VAR _EBIT = [Forecast]
			        RETURN
			            IF ( _EBIT > 0, _EBIT * _Rate, 0 )
			    )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 716b0ad1-9009-4ecb-94c4-b7a76dd73ec4

	/// Forecast bottom line: forecast EBIT less forecast tax. FY2026: -107,051 - 119,843 = -226,894. The loss grows because loss months carry no tax refund. COMPANY LEVEL ONLY, like Net Income.
	measure 'Net Income Forecast' = CALCULATE ( [Forecast], REMOVEFILTERS ( dim_account ) ) - [Tax Forecast]
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 894d7bca-11d3-4c91-b06c-bd9a61330895

	/// Indirect method on the forecast: forecast net income plus forecast depreciation (non-cash) less the cash absorbed by working capital. FY2026: -226,894 + 745,013 - 220,905 = 297,213, against 1,143,086 actual in 2025.
	measure 'Operating Cash Flow Forecast' =
			VAR _dNWC = [Delta NWC Forecast]
			RETURN
			    IF ( NOT ISBLANK ( _dNWC ), [Net Income Forecast] + [Depreciation Forecast] - _dNWC )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 82ce997d-f8f5-4a70-aea8-13b97f2abb37

	/// Forecast operating cash flow less forecast capex. FY2026: 297,213 - 787,262 = -490,049, against +390,623 actual in 2025 - a swing of about 881K. The operating business still generates cash, but not enough to fund ordinary investment.
	measure 'Free Cash Flow Forecast' =
			VAR _OCF = [Operating Cash Flow Forecast]
			RETURN
			    IF ( NOT ISBLANK ( _OCF ), _OCF - [Capex Forecast] )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 7a6e8a55-5da5-4d6f-95b6-4da544a3b56a

	/// Forecast operating result for the OPEN months only - the months that have no actuals yet (Jul-Dec 2026). Blank for every closed month, so it can sit in the same chart as [Actual] as a SEPARATE SERIES with its own colour, without the two overlapping or double-counting. The cut-off is read from the data (last date in fact_actual, currently 2026-06-30), not hardcoded, so it moves on its own when July actuals arrive. Pair it with [Actual] on the axis; [Forecast] on its own would repeat the closed months, because Jan-Jun forecast equals actual by construction.
	measure 'Forecast (open months)' =
			VAR _LastActual = CALCULATE ( MAX ( fact_actual[date] ), REMOVEFILTERS ( dim_date ) )
			VAR _PeriodEnd = MAX ( dim_date[date] )
			RETURN
			    IF ( _PeriodEnd > _LastActual, [Forecast] )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: aa2c8205-387a-49d6-8e48-cfb9b38cbd1e

	/// Cumulative forecast operating result for the open months, the YTD twin of [Forecast (open months)]. Uses >= rather than > on purpose: the last closed month (June 2026) is included so the forecast line STARTS where the actual line ends and the two read as one continuous path instead of a broken one. Pair it with [Operating Result YTD] for the actual part. FY2026 ends at -107,051.
	measure 'Forecast YTD (open months)' =
			VAR _LastActual = CALCULATE ( MAX ( fact_actual[date] ), REMOVEFILTERS ( dim_date ) )
			VAR _PeriodEnd = MAX ( dim_date[date] )
			RETURN
			    IF ( _PeriodEnd >= _LastActual, [Forecast YTD] )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: c1ae05c1-ab77-431f-98b0-4e7000904b74

	/// Cumulative actual operating result, but BLANK once the closed months end (after June 2026). The plain [Operating Result YTD] keeps repeating its last value for Jul-Dec, which draws a flat actual line to December and reads as if nothing happened. Companion of [Forecast YTD (open months)]: the two meet at June, where both return 277,532, so the lines join without a gap.
	measure 'Actual YTD (closed months)' =
			VAR _LastActual = CALCULATE ( MAX ( fact_actual[date] ), REMOVEFILTERS ( dim_date ) )
			VAR _PeriodEnd = MAX ( dim_date[date] )
			RETURN
			    IF ( _PeriodEnd <= _LastActual, [Operating Result YTD] )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 55581bed-074b-4f5d-aa66-750aabfa5189

	/// Tooltip text naming the forecast events that fall in the period, with each one's operating result effect, e.g. 'Loss of customer Kraftwerk Mechatronik: -270K'. One line per event (UNICHAR(10) separator), blank in months with no event so the tooltip stays clean. Put it in a visual's Tooltips field well. Shows the FORECAST amount, i.e. what the event contributes, not the gap to Plan - use [Event Impact vs Plan] alongside it if the reader needs the unplanned part.
	measure 'Event Note' =
			VAR _Events =
			    CONCATENATEX (
			        VALUES ( fact_forecast_events[event] ),
			        VAR _Impact = [Event Forecast]
			        VAR _Fmt =
			            IF ( _Impact < 0, "-", "+" )
			                & IF (
			                    ABS ( _Impact ) >= 1000000,
			                    FORMAT ( ABS ( _Impact ) / 1000000, "0.00" ) & "M",
			                    FORMAT ( ABS ( _Impact ) / 1000, "#,0" ) & "K"
			                )
			        RETURN
			            fact_forecast_events[event] & ": " & _Fmt,
			        UNICHAR ( 10 )
			    )
			RETURN
			    IF ( NOT ISBLANK ( _Events ), _Events )
		displayFolder: 06 Forecast
		lineageTag: 9f071553-5cfe-4182-80e5-40966d4b6349

	/// Cumulative Plan operating result for the CLOSED months only, blank after the last actual month (June 2026). Plan counterpart of [Actual YTD (closed months)], so the Plan line can be drawn solid over the closed period and dashed over the forecast period. FY2026 Jan-Jun: 1,260,457. Cut-off read from fact_actual, not hardcoded.
	measure 'Plan YTD (closed months)' =
			VAR _LastActual = CALCULATE ( MAX ( fact_actual[date] ), REMOVEFILTERS ( dim_date ) )
			VAR _PeriodEnd = MAX ( dim_date[date] )
			RETURN
			    IF ( _PeriodEnd <= _LastActual, [Plan YTD] )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 4c210059-0003-443c-8773-4679fb0549bb

	/// Cumulative Plan operating result over the OPEN months, including the last closed month (June) so the two Plan segments join without a gap - exactly like [Forecast YTD (open months)]. Still cumulative from 1 January, not from July: it stays comparable with Forecast YTD on the same axis. FY2026 December: 2,722,099.
	measure 'Plan YTD (open months)' =
			VAR _LastActual = CALCULATE ( MAX ( fact_actual[date] ), REMOVEFILTERS ( dim_date ) )
			VAR _PeriodEnd = MAX ( dim_date[date] )
			RETURN
			    IF ( _PeriodEnd >= _LastActual, [Plan YTD] )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 9d747965-a58b-4aef-8275-57a0a0ffc057

	/// Forecast capex with the sign flipped, so it plots downwards as a cash OUTFLOW next to operating cash flow. Display only - [Capex Forecast] keeps the positive sign that the cash flow measures expect. FY2026: -787,262.
	measure 'Capex Forecast (outflow)' = - [Capex Forecast]
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: b6beac17-8472-41c8-8e93-005140a14710

	/// Cumulative forecast free cash flow from 1 January. Correct at every grain because Delta NWC Forecast differences the closing balances of the widened period rather than summing monthly movements. FY2026 ends at -490,049, with the low point in November at about -629K.
	measure 'Free Cash Flow Forecast YTD' = CALCULATE ( [Free Cash Flow Forecast], DATESYTD ( dim_date[date] ) )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: b9a9e288-b75c-4abe-b75a-31df12b78959

	/// Forecast EBITDA as a percentage of forecast revenue. The forecast twin of EBITDA Margin % and EBITDA Margin % Plan. FY2026: 637,962 / 19,728,870 = 3.2%, against a planned 15.8% and 10.0% actual in 2025 - the margin falls by two thirds.
	measure 'EBITDA Margin % Forecast' = DIVIDE ( [EBITDA Forecast], [Revenue Forecast] )
		formatString: 0.0%
		displayFolder: 06 Forecast
		lineageTag: 040cede5-f947-4abf-bd64-e02e6c0df4bb

	/// Card caption for the EBITDA margin card, e.g. 'Plan 15,8% · PY 10,0%' for 2026. Prior year is read relative to the year in context, so it follows the year slicer.
	measure 'EBITDA Margin Forecast Caption' =
			VAR _Plan = [EBITDA Margin % Plan]
			VAR _PY = CALCULATE ( [EBITDA Margin %], REMOVEFILTERS ( dim_date ), dim_date[year] = YEAR ( MAX ( dim_date[date] ) ) - 1 )
			RETURN
			    IF (
			        NOT ISBLANK ( _Plan ),
			        "Plan " & FORMAT ( _Plan, "0.0%" ) & "  ·  PY " & FORMAT ( _PY, "0.0%" )
			    )
		displayFolder: 06 Forecast
		lineageTag: 41a7b4b0-f110-4582-8d0a-9278cc6c665f

	/// Card caption for the operating cash flow card, e.g. 'PY 1,14M · ▼ -845K' for 2026. Compares the forecast with the prior-year ACTUAL, because there is no cash plan in the model.
	measure 'Operating Cash Flow Forecast Caption' =
			VAR _PY = CALCULATE ( [Operating Cash Flow], REMOVEFILTERS ( dim_date ), dim_date[year] = YEAR ( MAX ( dim_date[date] ) ) - 1 )
			VAR _Delta = [Operating Cash Flow Forecast] - _PY
			VAR _FmtPY = IF ( ABS ( _PY ) >= 1000000, FORMAT ( _PY / 1000000, "0.00" ) & "M", FORMAT ( _PY / 1000, "#,0" ) & "K" )
			VAR _FmtD = IF ( _Delta < 0, "-", "+" ) & IF ( ABS ( _Delta ) >= 1000000, FORMAT ( ABS ( _Delta ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _Delta ) / 1000, "#,0" ) & "K" )
			RETURN
			    IF ( NOT ISBLANK ( _PY ), "PY " & _FmtPY & "  ·  " & IF ( _Delta < 0, "▼ ", "▲ " ) & _FmtD )
		displayFolder: 06 Forecast
		lineageTag: 74a7e66c-b9cd-4172-b107-8f230f6117e7

	/// Card caption for the free cash flow card, e.g. 'PY +391K · ▼ -881K' for 2026. Compares the forecast with the prior-year ACTUAL; there is no cash plan in the model.
	measure 'Free Cash Flow Forecast Caption' =
			VAR _PY = CALCULATE ( [Free Cash Flow], REMOVEFILTERS ( dim_date ), dim_date[year] = YEAR ( MAX ( dim_date[date] ) ) - 1 )
			VAR _Delta = [Free Cash Flow Forecast] - _PY
			VAR _FmtPY = IF ( _PY < 0, "-", "+" ) & IF ( ABS ( _PY ) >= 1000000, FORMAT ( ABS ( _PY ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _PY ) / 1000, "#,0" ) & "K" )
			VAR _FmtD = IF ( _Delta < 0, "-", "+" ) & IF ( ABS ( _Delta ) >= 1000000, FORMAT ( ABS ( _Delta ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _Delta ) / 1000, "#,0" ) & "K" )
			RETURN
			    IF ( NOT ISBLANK ( _PY ), "PY " & _FmtPY & "  ·  " & IF ( _Delta < 0, "▼ ", "▲ " ) & _FmtD )
		displayFolder: 06 Forecast
		lineageTag: 2f36f442-0924-418d-ab67-85dd7f99612c

	/// Card caption for the revenue card showing BOTH comparisons, e.g. 'Plan ▼ -9,2% · PY ▼ -2,1%' for 2026. The prior-year figure is the one a CFO reacts to: it is the first revenue decline in the dataset. Replaces Revenue Forecast Caption on the card when both references are wanted.
	measure 'Revenue Forecast Caption PY' =
			VAR _Plan = [Revenue Plan]
			VAR _PY = CALCULATE ( [Revenue], REMOVEFILTERS ( dim_date ), dim_date[year] = YEAR ( MAX ( dim_date[date] ) ) - 1 )
			VAR _F = [Revenue Forecast]
			VAR _PctPlan = DIVIDE ( _F - _Plan, ABS ( _Plan ) )
			VAR _PctPY = DIVIDE ( _F - _PY, ABS ( _PY ) )
			RETURN
			    IF (
			        NOT ISBLANK ( _Plan ),
			        "Plan " & IF ( _PctPlan < 0, "▼ ", "▲ +" ) & FORMAT ( _PctPlan, "0.0%" )
			            & "  ·  PY " & IF ( _PctPY < 0, "▼ ", "▲ +" ) & FORMAT ( _PctPY, "0.0%" )
			    )
		displayFolder: 06 Forecast
		lineageTag: 45938285-8d6e-46f6-8748-18e5d94aed8d

	/// Card caption for the net income card, e.g. 'PY +908K · ▼ -1,14M' for 2026. Compared with the prior-year ACTUAL: the budget covers P&L accounts only and carries no tax, so there is no planned net income to compare against.
	measure 'Net Income Forecast Caption' =
			VAR _PY = CALCULATE ( [Net Income], REMOVEFILTERS ( dim_date ), dim_date[year] = YEAR ( MAX ( dim_date[date] ) ) - 1 )
			VAR _Delta = [Net Income Forecast] - _PY
			VAR _FmtPY = IF ( _PY < 0, "-", "+" ) & IF ( ABS ( _PY ) >= 1000000, FORMAT ( ABS ( _PY ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _PY ) / 1000, "#,0" ) & "K" )
			VAR _FmtD = IF ( _Delta < 0, "-", "+" ) & IF ( ABS ( _Delta ) >= 1000000, FORMAT ( ABS ( _Delta ) / 1000000, "0.00" ) & "M", FORMAT ( ABS ( _Delta ) / 1000, "#,0" ) & "K" )
			RETURN
			    IF ( NOT ISBLANK ( _PY ), "PY " & _FmtPY & "  ·  " & IF ( _Delta < 0, "▼ ", "▲ " ) & _FmtD )
		displayFolder: 06 Forecast
		lineageTag: c11a425e-7812-4ac3-bab3-f3d010669e17

	/// Cash effect of the working capital movement, sign flipped for display: NEGATIVE means working capital absorbed cash. Delta NWC Forecast itself is positive when the balance grows, which would read as a gain on a card. FY2026: -220,905 (receivables -59,483, inventory -156,881, payables -4,542).
	measure 'Working Capital Impact Forecast' = - [Delta NWC Forecast]
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 4c6ff1c1-a313-45a2-8856-840ab7742da9

	/// Cash effect per working capital component, driven by the disconnected WC_Components table. NEGATIVE = cash absorbed. Receivables and inventory are negated because a growing balance ties cash up; payables are NOT negated because owing more supplier money releases cash. Opening balances read the forecast series first and fall back to actual, exactly like Delta NWC Forecast. The three bars sum to [Working Capital Impact Forecast]. FY2026: receivables -59,483, inventory -156,881, payables -4,542, total -220,905.
	measure 'Working Capital Impact Component' =
			VAR _PeriodStart = MIN ( dim_date[date] )
			VAR _Comp = SELECTEDVALUE ( WC_Components[Component] )
			VAR _OpenAR = COALESCE (
			    CALCULATE ( [Accounts Receivable Forecast], REMOVEFILTERS ( dim_date ), dim_date[date] < _PeriodStart ),
			    CALCULATE ( [Accounts Receivable], REMOVEFILTERS ( dim_date ), dim_date[date] < _PeriodStart )
			)
			VAR _OpenInv = COALESCE (
			    CALCULATE ( [Inventory Forecast], REMOVEFILTERS ( dim_date ), dim_date[date] < _PeriodStart ),
			    CALCULATE ( [Inventory], REMOVEFILTERS ( dim_date ), dim_date[date] < _PeriodStart )
			)
			VAR _OpenAP = COALESCE (
			    CALCULATE ( [Accounts Payable Forecast], REMOVEFILTERS ( dim_date ), dim_date[date] < _PeriodStart ),
			    CALCULATE ( [Accounts Payable], REMOVEFILTERS ( dim_date ), dim_date[date] < _PeriodStart )
			)
			RETURN
			    SWITCH (
			        _Comp,
			        "Receivables", - ( [Accounts Receivable Forecast] - _OpenAR ),
			        "Inventory",   - ( [Inventory Forecast] - _OpenInv ),
			        "Payables",      [Accounts Payable Forecast] - _OpenAP
			    )
		formatString: #,##0
		displayFolder: 06 Forecast
		lineageTag: 24fe9311-91b4-46df-bf40-69207ac72feb

	/// Card caption for the working capital card, naming the three components, e.g. 'AR -59K · Inventory -157K · AP -5K' for 2026. Negative means the component absorbed cash. Reads Working Capital Impact Component once per component so the card and the bar chart can never disagree.
	measure 'Working Capital Impact Caption' =
			VAR _PeriodStart = MIN ( dim_date[date] )
			VAR _K =
			    SELECTCOLUMNS ( { 1 }, "x", [Value] )
			VAR _AR =
			    CALCULATE ( [Working Capital Impact Component], WC_Components[Component] = "Receivables" )
			VAR _Inv =
			    CALCULATE ( [Working Capital Impact Component], WC_Components[Component] = "Inventory" )
			VAR _AP =
			    CALCULATE ( [Working Capital Impact Component], WC_Components[Component] = "Payables" )
			VAR _F1 = IF ( _AR < 0, "-", "+" ) & FORMAT ( ABS ( _AR ) / 1000, "#,0" ) & "K"
			VAR _F2 = IF ( _Inv < 0, "-", "+" ) & FORMAT ( ABS ( _Inv ) / 1000, "#,0" ) & "K"
			VAR _F3 = IF ( _AP < 0, "-", "+" ) & FORMAT ( ABS ( _AP ) / 1000, "#,0" ) & "K"
			RETURN
			    IF (
			        NOT ISBLANK ( _AR ),
			        "AR " & _F1 & "  ·  Inventory " & _F2 & "  ·  AP " & _F3
			    )
		displayFolder: 06 Forecast
		lineageTag: 9e7ead2f-1b52-4774-8042-fe4c817dcb41

	measure 'Free Cash Flow YTD (closed Months)' = ```
			
			      Var _Lastactual = CALCULATE(MAX(fact_actual[date]), REMOVEFILTERS(dim_date))
			      VAR _PeriodEnd = MAX(dim_date[date])
			      RETURN if (_PeriodEnd <= _Lastactual, [Free Cash Flow YTD])
			```
		displayFolder: 08 Cash & Working Capital
		lineageTag: db4c7ee2-caf8-4423-92e3-fa5c0fa6e25f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Free Cash Flow YTD' = CALCULATE( [Free Cash Flow],DATESYTD(dim_date[date]))
		displayFolder: 08 Cash & Working Capital
		lineageTag: 85fafced-77b2-4878-a447-25b2f199ef8e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Conditional fill colour for the Operating cash flow columns in the cash flow chart on the Forecast page. Returns a solid purple for the CLOSED months and a pale tint for the OPEN ones, so the reader can see at a glance which bars are reported and which are projected. All twelve months of Operating Cash Flow Forecast are forecast figures - Jan-Jun simply equal the actuals to the cent because the forecast is seeded from the closed months - which is exactly why the chart needs this cue: nothing else in it distinguishes the two halves. The cut-off is read from fact_actual (currently 2026-06-30), not hardcoded, so the boundary moves on its own when July actuals arrive - the reason this is a measure and not a rectangle drawn over the chart, which would stay put and silently mislabel July. Same _LastActual / _PeriodEnd pattern as Free Cash Flow YTD (closed months). Apply via Format pane > Columns > Colors > select the series > fx > Format style 'Field value'. NOTE: the hex values are literals, so a theme change will not flow through to them, and the legend swatch keeps showing the series base colour rather than these two tints - the subtitle carries that explanation instead.
	measure 'Operating Cash Flow Forecast Fill' =
			VAR _LastActual = CALCULATE ( MAX ( fact_actual[date] ), REMOVEFILTERS ( dim_date ) )
			VAR _PeriodEnd = MAX ( dim_date[date] )
			RETURN
			    IF ( _PeriodEnd <= _LastActual, "#744EC2", "#B5A1FF" )
		displayFolder: 06 Forecast
		lineageTag: 824d90d3-a77f-4abb-bdd5-1085fb71d21d

	/// Conditional fill colour for the Capex columns, the grey twin of Operating Cash Flow Forecast Fill. Identical logic and identical cut-off, so the two series fade at the same month and the pair reads as one boundary. #8A8886 is the grey the Capex series already uses, so the closed months keep exactly their current colour; #C8C6C4 is its lighter partner for the projected months. Apply the same way, on the Capex series.
	measure 'Capex Forecast Fill' =
			VAR _LastActual = CALCULATE ( MAX ( fact_actual[date] ), REMOVEFILTERS ( dim_date ) )
			VAR _PeriodEnd = MAX ( dim_date[date] )
			RETURN
			    IF ( _PeriodEnd <= _LastActual, "#8A8886", "#C8C6C4" )
		displayFolder: 06 Forecast
		lineageTag: 0eac101a-8396-4c9b-9403-2d93f8de1b2e

	/// THE SEAM. Revenue driver of the selected scenario, read from the Scenario table. Every measure downstream reads this and never touches Scenario directly, so the source of a driver can change without touching the free cash flow chain. Returns 0 when no single scenario is selected, because SELECTEDVALUE over several visible rows falls to its default - so an unfiltered page reads as Base, which is the published forecast. In a visual with Scenario[Scenario] on the axis, each row resolves its own value, which is what puts all scenarios side by side.
	measure 'Revenue Delta (selected)' = SELECTEDVALUE ( Scenario[Revenue Delta], 0 )
		formatString: 0%;-0%
		displayFolder: 07 Scenario
		lineageTag: 40f5be3d-2122-4b64-a995-ed9698fd0d66

	/// Operating-cost driver of the selected scenario, read from the Scenario table. Same pattern as [Revenue Delta (selected)].
	measure 'Opex Delta (selected)' = SELECTEDVALUE ( Scenario[Opex Delta], 0 )
		formatString: 0%;-0%
		displayFolder: 07 Scenario
		lineageTag: 3d957fa7-2515-4a09-ae75-8d0898bbf98b

	/// Inventory driver of the selected scenario, read from the Scenario table. Same pattern as [Revenue Delta (selected)].
	measure 'Inventory Delta (selected)' = SELECTEDVALUE ( Scenario[Inventory Delta], 0 )
		formatString: 0%;-0%
		displayFolder: 07 Scenario
		lineageTag: fca997c7-a035-457f-88dc-6bf7d856713d

	/// Capex driver of the selected scenario, read from the Scenario table. Same pattern as [Revenue Delta (selected)].
	measure 'Capex Delta (selected)' = SELECTEDVALUE ( Scenario[Capex Delta], 0 )
		formatString: 0%;-0%
		displayFolder: 07 Scenario
		lineageTag: 617896ba-1efe-4751-887d-16849b17cd9c

	/// Share of each extra euro of revenue that reaches the operating result. Variable costs are raw materials (account 5000) and logistics (5200) - the two that demonstrably track volume: from 2025 to the 2026 forecast, material fell 2.8% against a 2.1% revenue fall, while the fixed base grew 6.9%. Energy, personnel and the rest are treated as fixed within the scenario horizon. FY2026: 1 - (7,713,312 + 1,145,790) / 19,728,870 = 55.1%. DERIVED, not a constant, so it follows the cost mix instead of going stale - but that also means it moves if the mix moves, so read it alongside any scenario you are comparing across years. Treating energy as variable too would put it at 50.8%. Guarded to positive revenue, because the ratio has no meaning otherwise.
	measure 'Contribution Margin (Scenario)' =
			VAR _Revenue = [Revenue Forecast]
			VAR _VariableCost =
			    - CALCULATE (
			        [Forecast],
			        REMOVEFILTERS ( dim_account ),
			        dim_account[account_id] IN { 5000, 5200 }
			    )
			RETURN
			    IF ( _Revenue > 0, DIVIDE ( _Revenue - _VariableCost, _Revenue ) )
		formatString: 0.0%
		displayFolder: 07 Scenario
		lineageTag: fcbfab98-06b3-4c3e-be74-e35804b0f73b

	/// Euro effect of the revenue driver on the operating result. OPEN MONTHS ONLY: the base is revenue after the last actual date (currently 2026-06-30), 9,445,964 of the full-year 19,728,870. Jan-Jun is closed - the forecast there is the actuals copied in - so flexing it would invent history, the same flaw that made the old scenario page meaningless. The cut-off is read from fact_actual, so H2 becomes Aug-Dec by itself once July books. Revenue change flows at the contribution margin, NOT euro for euro: -5% on the open months is 472,298 of revenue but only 260,222 of result, because material and logistics fall with the volume.
	measure 'Scenario Revenue Effect' =
			VAR _LastActual = CALCULATE ( MAX ( fact_actual[date] ), REMOVEFILTERS ( dim_date ) )
			VAR _OpenRevenue =
			    CALCULATE ( [Revenue Forecast], KEEPFILTERS ( dim_date[date] > _LastActual ) )
			RETURN
			    _OpenRevenue * [Revenue Delta (selected)] * [Contribution Margin (Scenario)]
		formatString: #,##0
		displayFolder: 07 Scenario
		lineageTag: 914a8a68-4557-4834-a51d-8638b3e2cf5e

	/// Euro effect of the operating-cost driver. OPEN MONTHS ONLY - see [Scenario Revenue Effect] for why. The base is personnel, operating expenses and other costs after the last actual date: -5,673,786, half of the full-year -11,377,595. Material is excluded because it already moves with revenue through the contribution margin, and depreciation because it follows capex, not cost discipline. No sign handling is needed - the base is already negative, so a positive driver lowers the result.
	measure 'Scenario Opex Effect' =
			VAR _LastActual = CALCULATE ( MAX ( fact_actual[date] ), REMOVEFILTERS ( dim_date ) )
			VAR _OpenOpex =
			    CALCULATE (
			        [Forecast],
			        REMOVEFILTERS ( dim_account ),
			        dim_account[account_category] IN { "Personnel Costs", "Operating Expenses", "Other Costs" },
			        KEEPFILTERS ( dim_date[date] > _LastActual )
			    )
			RETURN
			    _OpenOpex * [Opex Delta (selected)]
		formatString: #,##0
		displayFolder: 07 Scenario
		lineageTag: 0ab16e51-3c2c-41a8-be7c-e1613f2a45f7

	/// Operating result under the selected scenario. Starts from the FY2026 FORECAST (-107,051), not from actuals - the old page flexed history, which cannot be changed. REMOVEFILTERS on dim_account so the base is the whole P&L even if an account filter is active. Equals the forecast exactly when every driver sits at zero, which is what makes Base a true reproduction of the published number.
	measure 'Scenario Operating Result' =
			CALCULATE ( [Forecast], REMOVEFILTERS ( dim_account ) )
			    + [Scenario Revenue Effect]
			    + [Scenario Opex Effect]
		formatString: #,##0
		displayFolder: 07 Scenario
		lineageTag: 34603786-302e-4277-841d-7347b4a77996

	/// Tax under the selected scenario, returned positive. Deliberately mirrors [Tax Forecast] rather than inventing a new convention: 29.825% (Koerperschaftsteuer 15.825% plus Gewerbesteuer 14%) accrued MONTH BY MONTH on profitable months only, with no refund in loss months. That is why a loss-making FY2026 still books 119,843. The monthly rule matters here more than in the forecast: a scenario that lifts revenue turns loss months into profitable ones, so tax rises faster than the annual result does - an upside is taxed harder than a naive full-year rate would suggest. Iterates year_month so the rule survives any period selection.
	measure 'Scenario Tax' =
			VAR _Rate = 0.29825
			RETURN
			    SUMX (
			        VALUES ( dim_date[year_month] ),
			        VAR _EBIT = [Scenario Operating Result]
			        RETURN
			            IF ( _EBIT > 0, _EBIT * _Rate, 0 )
			    )
		formatString: #,##0
		displayFolder: 07 Scenario
		lineageTag: 0ff6a3c3-3e3b-4541-9765-e30a9a74dab3

	/// Net income under the selected scenario. No interest line, because no debt is modelled. Base reproduces the forecast net income of -226,894.
	measure 'Scenario Net Income' = [Scenario Operating Result] - [Scenario Tax]
		formatString: #,##0
		displayFolder: 07 Scenario
		lineageTag: 8ea16318-1223-4254-8b39-0dd5b698f2ba

	/// Change in net working capital under the selected scenario. Positive means working capital ABSORBED cash. The inventory driver moves the closing balance, and because the change in working capital is closing less opening, a percentage move in the closing balance passes straight through: -25% on the FY2026 close of 1,349,689 releases 337,422. OPEN MONTHS ONLY, like every other driver: the effect applies to any period ending after the last actual date and is zero before it, so a year-to-date view stays on the published forecast through June and only diverges from July. It is applied IN FULL from the cut-off rather than ramped across the open months - the driver states a target closing balance, not a monthly programme. Receivables and payables are deliberately left alone: a revenue scenario would strictly also move receivables, but DSO is not a driver here and pretending otherwise would hide the assumption.
	measure 'Scenario Working Capital Change' =
			VAR _LastActual = CALCULATE ( MAX ( fact_actual[date] ), REMOVEFILTERS ( dim_date ) )
			VAR _PeriodEnd = MAX ( dim_date[date] )
			RETURN
			    [Delta NWC Forecast]
			        + IF (
			            _PeriodEnd > _LastActual,
			            [Inventory Forecast] * [Inventory Delta (selected)],
			            0
			        )
		formatString: #,##0
		displayFolder: 07 Scenario
		lineageTag: 28a059a6-4540-448e-9e73-1bcb7cb930fd

	/// Capital expenditure under the selected scenario, positive because it is a cash outflow. ONLY THE OPEN MONTHS FLEX: the full-year forecast of 787,262 is kept and the driver is applied to the 422,883 still to be spent after the last actual date, because Jan-Jun capex is already out of the door. So -20% defers 84,577, not 157,452. Depreciation is NOT adjusted in response: within a single year the effect on the depreciation charge is immaterial, and modelling it would imply an asset-life assumption the dataset does not carry.
	measure 'Scenario Capex' =
			VAR _LastActual = CALCULATE ( MAX ( fact_actual[date] ), REMOVEFILTERS ( dim_date ) )
			VAR _OpenCapex =
			    CALCULATE ( [Capex Forecast], KEEPFILTERS ( dim_date[date] > _LastActual ) )
			RETURN
			    [Capex Forecast] + _OpenCapex * [Capex Delta (selected)]
		formatString: #,##0
		displayFolder: 07 Scenario
		lineageTag: 0da0b323-9d9b-4ee8-a001-072040f9418e

	/// THE HEADLINE. Free cash flow under the selected scenario, by the same indirect identity as [Free Cash Flow Forecast]: net income plus depreciation, less the cash working capital absorbs, less capex. Reproduces -490,049 exactly when every driver is zero - that reconciliation is the page's correctness test, and if it ever breaks, a driver has been double-counted. Depreciation is taken from the forecast unchanged, see [Scenario Capex].
	measure 'Scenario Free Cash Flow' =
			[Scenario Net Income]
			    + [Depreciation Forecast]
			    - [Scenario Working Capital Change]
			    - [Scenario Capex]
		formatString: #,##0
		displayFolder: 07 Scenario
		lineageTag: 9dae080b-d255-447d-891a-1d513fb05c82

	/// Cash swing the selected scenario produces against the published forecast of -490,049. Zero for Base by construction. This is the number to put on a card next to the headline: readers judge a scenario by how far it moves the answer, not by its absolute level.
	measure 'Scenario FCF vs Base' = [Scenario Free Cash Flow] - [Free Cash Flow Forecast]
		formatString: #,##0
		displayFolder: 07 Scenario
		lineageTag: 01ab58cd-4228-4301-ac2a-d239eff513fc

	/// Cash swing from the P&L, i.e. the part of [Scenario FCF vs Base] that comes from earning more or less after tax. Net income under the scenario less net income in the forecast (-226,894). Together with [Scenario Cash Effect - Working Capital] and [Scenario Cash Effect - Capex] it sums EXACTLY to [Scenario FCF vs Base], which is what makes the swing chart honest: the three bars reconcile to the headline rather than approximating it. Downside: -786,599. Upside: +369,666.
	measure 'Scenario Cash Effect - Result' = [Scenario Net Income] - [Net Income Forecast]
		formatString: #,##0
		displayFolder: 07 Scenario
		lineageTag: ccd2eb0c-90ac-4d0f-877a-5bee5e8732bf

	/// Cash swing from working capital. Signed as CASH IMPACT, the opposite of the balance movement: positive means the scenario releases cash, negative means it ties up more. Forecast drag less scenario drag, so it is exactly the inventory driver with its sign flipped. Upside (-15% inventory) releases 202,453; Downside (+10%) absorbs a further 134,969.
	measure 'Scenario Cash Effect - Working Capital' = [Delta NWC Forecast] - [Scenario Working Capital Change]
		formatString: #,##0
		displayFolder: 07 Scenario
		lineageTag: 7588276a-3042-4063-b33b-169c2b93d5ff

	/// Cash swing from capital expenditure. Positive means the scenario spends less than the forecast's 787,262 and keeps the difference. Upside (-20%) saves 157,452. Depreciation is not adjusted in response - see [Scenario Capex].
	measure 'Scenario Cash Effect - Capex' = [Capex Forecast] - [Scenario Capex]
		formatString: #,##0
		displayFolder: 07 Scenario
		lineageTag: 45318eb2-1e76-4cc0-ab3c-b79b11a4a9ac

	/// Single value for the scenario detail matrix, dispatched by the row of the disconnected Scenario_Lines table. Same device as the PnL_Layout row measure. It exists so the eight cash flow lines can run DOWN the rows with the scenarios across the columns: a matrix can only put measures in Values, so without this indirection the lines are forced across the top. DISPATCHES ON Scenario_Lines[Sort], not on the label, so the labels can carry their +/−/= operators and be reworded without breaking the measure. Returns BLANK at the grand total, where SELECTEDVALUE sees several lines at once and the SWITCH finds no match - that is correct, because summing a cash flow identity down its own lines would double count. Turn row and column totals OFF on the visual. EVERY LINE IS IN EUROS, so one format string serves the whole grid; adding a percentage line here would need a format string expression instead. Working capital keeps the balance-movement sign, where positive means cash absorbed - it does NOT follow the cash-impact convention of [Scenario Cash Effect - Working Capital].
	measure 'Scenario Line Value' =
			SWITCH (
			    SELECTEDVALUE ( Scenario_Lines[Sort] ),
			    1, [Scenario Operating Result],
			    2, [Scenario Tax],
			    3, [Scenario Net Income],
			    4, [Depreciation Forecast],
			    5, [Scenario Working Capital Change],
			    6, [Scenario Capex],
			    7, [Scenario Free Cash Flow],
			    8, [Scenario FCF vs Base]
			)
		formatString: #,##0
		displayFolder: 07 Scenario
		lineageTag: 1b61a2c1-6793-45b3-a97e-97768962c132

	/// Cumulative free cash flow from 1 January under the selected scenario, the scenario twin of Free Cash Flow Forecast YTD. Correct at every grain because Scenario Working Capital Change differences closing balances of the widened period rather than summing monthly movements, and because Scenario Tax re-applies the monthly accrual rule across whatever months the window holds. Base reproduces Free Cash Flow Forecast YTD exactly at every month - that identity is this measure's test, and if it breaks, a driver has been double-counted. Because every driver is restricted to the OPEN months, all scenarios coincide through June at -298,621 and only fan out from July: that is the point of the chart, not a rendering fault. FY2026 endpoints: Base -490,049, Downside -1,034,000, Upside -8,278. Read the path, not just the endpoint - Downside bottoms out at -1,108,298 in November, and even the Upside dips to -178,467 there before recovering.
	measure 'Scenario Free Cash Flow YTD' = CALCULATE ( [Scenario Free Cash Flow], DATESYTD ( dim_date[date] ) )
		formatString: #,##0
		displayFolder: 07 Scenario
		lineageTag: eed63b35-bba9-44db-aead-a233aabec438

	/// Background colour for the scenario detail matrix, applied to the values via Format > Cell elements > Background colour > fx > Field value. Highlights the two subtotals so the eye lands on them: Free cash flow (the headline) in the report's light purple, Net income in a light grey. Every other line returns BLANK, which leaves the default white. Dispatches on Scenario_Lines[Sort] like [Scenario Line Value].
	measure 'Scenario Line Fill' =
			SWITCH (
			    SELECTEDVALUE ( Scenario_Lines[Sort] ),
			    3, "#F3F2F1",
			    7, "#EDE7FB"
			)
		displayFolder: 07 Scenario
		lineageTag: 5b0f3e9a-6c21-4d8e-9a47-2f1c3b8d7e60

	/// Font colour for the scenario detail matrix, applied via Format > Cell elements > Font colour > fx > Field value. The vs forecast line uses the same green / red / grey as [Forecast vs Plan Colour], so better than forecast reads green everywhere in the report. The subtotals Net income and Free cash flow are navy, standing in for bold, which a matrix cannot switch on per row. Everything else is the standard dark grey.
	measure 'Scenario Line Font Colour' =
			VAR _Sort = SELECTEDVALUE ( Scenario_Lines[Sort] )
			VAR _Value = [Scenario FCF vs Base]
			RETURN
			    SWITCH (
			        TRUE (),
			        _Sort = 8 && _Value > 0.5, "#107C41",
			        _Sort = 8 && _Value < -0.5, "#C50F1F",
			        _Sort = 8, "#605E5C",
			        _Sort IN { 3, 7 }, "#1F3864",
			        "#323130"
			    )
		displayFolder: 07 Scenario
		lineageTag: 9c4d2a71-8e35-4b6f-a1d0-7e2b5f8c3a94

	column Placeholder
		lineageTag: f98f6626-341f-417c-bace-71685bf67441
		isNameInferred
		sourceColumn: [Placeholder]

	partition _Measures = calculated
		mode: import
		source = ROW ( "Placeholder", 1 )

